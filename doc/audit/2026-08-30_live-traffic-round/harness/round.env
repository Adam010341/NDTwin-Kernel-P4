# =================================================================================================
# round.env -- one place that decides which tree, which claim, and which artefact directory every
# command in this round uses. Source it; never re-type these by hand.
#
#     . doc/audit/2026-08-30_live-traffic-round/harness/round.env          # arm 1 (default)
#     ARM=arm2-ovs . doc/audit/2026-08-30_live-traffic-round/harness/round.env
#
# Why a file: memory/put-measurement-commands-in-script-files. A variable retyped per shell call
# is a variable that can differ between calls, and OUT differing between two scripts of the same
# round is how one run gets read as another.
#
# 🔑 OUT is exported EXPLICITLY. The T-4 lib.sh defaults it to `$ROUND_DIR/raw/$RUN_TAG` where
# ROUND_DIR is *its own* round directory -- so without this export, this round's artefacts would
# silently land in the T-4 round's tree and be read as T-4's.
#
# [Co-developed with claude code -- Adam]
# =================================================================================================
export KERNEL_DIR=/home/adam/Desktop/NDTwin-Kernel
export ROUND="$KERNEL_DIR/doc/audit/2026-08-30_live-traffic-round"

# The T-4 harness is REUSED, not copied. Its lib.sh carries the T-10 repairs (spawn_exec via a
# global, ndt_down's channel split, port_holder's third state, the pattern self-test) that the
# auditor force-tested in both directions on 2026-08-30. A copy here would fork those fixes.
export T4H="$KERNEL_DIR/doc/audit/2026-08-30_live-full-stack-round/harness"

export NDT_OWNER=live-traffic-round
export NDT_EXCLUSIVE_CPU=1

export ARM="${ARM:-arm1-p4-128}"
export RUN_TAG="$ARM"
export OUT="$ROUND/raw/$ARM"
mkdir -p "$OUT"
