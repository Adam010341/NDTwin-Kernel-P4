+
+    std::ostringstream detail;
+    bool first = true;
+    for (const auto& [kind, dpids] : groups)
+    {
+        if (!first)
+        {
+            detail << "; ";
+        }
+        first = false;
+        detail << switchKindToString(kind) << "=[";
+        for (size_t i = 0; i < dpids.size(); ++i)
+        {
+            detail << (i ? "," : "") << dpids[i];
+        }
+        detail << "]";
+    }
+
