+{
+    std::shared_lock lock(*m_graphMutex);
+    std::size_t switchesUp = 0;
+    std::size_t hostsUp = 0;
+    for (auto [vi, viEnd] = boost::vertices(*m_graph); vi != viEnd; ++vi)
