+        else
+        {
+            ++hostsUp;
+        }
+    }
+
+    std::size_t edgesUp = 0;
+    for (auto [ei, eiEnd] = boost::edges(*m_graph); ei != eiEnd; ++ei)
+    {
+        if ((*m_graph)[*ei].isUp)
+        {
+            ++edgesUp;
+        }
+    }
+    return {switchesUp, hostsUp, edgesUp};
