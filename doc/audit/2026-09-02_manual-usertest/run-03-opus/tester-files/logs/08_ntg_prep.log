--- NTG.yaml ---
---
# From nornir
inventory:
  plugin: SimpleInventory
  options:
    host_file: "./setting/Hardware.yaml"
    group_file: "./setting/API_server_startup.yaml"

runner:
  plugin: threaded
  options:
    num_workers: 5

logging:
  enabled: false--- setting/Mininet.yaml ---
---
Mininet_Testbed:
  data:
    # options: cli(Mininet's cli) or custom_command(Our own cli)
    ndtwin_kernel: "http://127.0.0.1:8000"
    mode: "custom_command" 
    log_level: "DEBUG"  # TRACE, DEBUG, INFO, WARNING, ERROR
    sleep_time:
      min: 0.1
      max: 0.3
    tcp_socket_write_length: "10K"  # in bytes, not including header, only payload, can use K for 1024 bytes, M for 1024*1024 bytes, etc.
    udp_packet_length: "1460"  # in bytes, not including header, only payload, can use K for 1024 bytes, M for 1024*1024 bytes, etc.--- flow_template.json (first 40 lines) ---
