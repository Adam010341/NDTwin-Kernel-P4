# =================================================================================================
# round.env -- the single place that decides which arm, which binary, which endpoints and which
# artefact directory every command in the F-5 fine-grid round uses.
#
#     . doc/audit/2026-08-31_f5-fine-grid-round/round.env               # arm 1 (P4, post-T-11)
#     ARM=q2-p4-pre  . doc/audit/2026-08-31_f5-fine-grid-round/round.env
#
# memory/put-measurement-commands-in-script-files: a value retyped per shell call can differ
# between calls, and OUT differing between two scripts of one round is how one run gets read as
# another.
#
# [Co-developed with claude code -- Adam]
# =================================================================================================
export KERNEL_DIR=/home/adam/Desktop/NDTwin-Kernel
export ROUND="$KERNEL_DIR/doc/audit/2026-08-31_f5-fine-grid-round"

# The TR-3 harness is REUSED, not copied.  tr3_f5_window.py owns `req`, `classify`, `entries_of`
# and `dst_of`; classify() carries FINDING-03's three structural discriminators and entries_of()
# carries the corrected three-level flattening whose first version silently returned ten wrapper
# objects and reported "0 phantom" -- which is what a working system looks like.  A copy here
# would fork that correction.
export TRH="$KERNEL_DIR/doc/audit/2026-08-30_live-traffic-round/harness"

export NDT_OWNER="${NDT_OWNER:-f5-fine-grid-round}"
export NDT_EXCLUSIVE_CPU=1
export LAB="sudo -n /usr/local/sbin/ndtwin-lab"

# Arms.  Two questions x two binaries; the arm decides the fabric, the binary and the endpoints.
#   q1-p4-post   Q1  post-T-11, P4 4-host      does the fix hold under load
#   q1-ovs-post  Q1  post-T-11, OVS 4-host     the second fabric, for the pooling rule
#   q2-p4-pre    Q2  pre-T-11  (a40e04ce), P4  how common was the old world
#   q2-ovs-pre   Q2  pre-T-11, OVS
#   q3-p4-pre    Q3  pre-T-11, P4              deliberate-trigger upper bound
export ARM="${ARM:-q1-p4-post}"
export OUT="$ROUND/raw/$ARM"

export NDT_URL="${NDT_URL:-http://localhost:8000}"
case "$ARM" in
    *-p4-*)  export SOUTHBOUND_URL="${SOUTHBOUND_URL:-http://localhost:8081}"; export FABRIC=p4  ;;
    *-ovs-*) export SOUTHBOUND_URL="${SOUTHBOUND_URL:-http://localhost:8080}"; export FABRIC=ovs ;;
esac
export DPID="${DPID:-1}"

# Binaries.  post-T-11 is whatever the frozen tip builds; pre-T-11 is the archived a40e04ce.
# 🔴 Neither is identified by its filename.  The discriminator is a SYMBOL that T-11-A introduced
# (`setProgrammedPredicate`, 91e7743) and it is asserted against the RUNNING process, not the file
# on disk -- see lib_f5.sh:assert_arm_binary.
export KBIN="$KERNEL_DIR/build/bin/ndtwin_kernel"
export KBIN_PRE_T11="$KERNEL_DIR/.test_run/binaries/ndtwin_kernel.a40e04ce"
export KBIN_BACKUP="$KERNEL_DIR/.test_run/binaries/f5-round/ndtwin_kernel.production-backup"

export PY_PROXY="$KERNEL_DIR/p4_proxy/venv/bin/python"
export LOG="$ROUND/run_f5.log"

# ---- frozen by PREREG v0.2 ---------------------------------------------------------------------
export N_INSTALLS="${N_INSTALLS:-60}"          # §3: rule of three => single-arm upper bound <=5%
export GRID="${GRID:-0 0.25 0.5 1 1.5 2 3 5 8 12}"   # §2, seconds since the POST returned
export SKEW_LIMIT_MS="${SKEW_LIMIT_MS:-150}"   # §2: over this, the point is INDETERMINATE, not dropped
export CHURN_EVERY_S="${CHURN_EVERY_S:-30}"    # §3: one never-before-used pair every ~30 s

# ---- NOT frozen by PREREG v0.2; see TBD-DRAFT.md ------------------------------------------------
export DST_BASE="${DST_BASE:-10.0.0.}"         # TBD-1
export DST_FIRST_OCTET="${DST_FIRST_OCTET:-180}"
export DST_STRIDE="${DST_STRIDE:-7}"
# 🔴 TBD-3 RULED 2026-08-31 (before data): 6 x 10 = 60 operations, gap 0, compressed grid.
# 60 and not 100 because §3 froze a 60-address budget and a REPEATED dst turns the second
# install into a modify -- which produces no cached row at all, so the arm would read as "fewer
# phantoms" for a reason with nothing to do with T-11.  Raising it requires registering a second
# address range first, and that is an amendment only available before data.
export Q3_BURST="${Q3_BURST:-10}"
export Q3_GAP_MS="${Q3_GAP_MS:-0}"
export Q3_ROUNDS="${Q3_ROUNDS:-6}"

mkdir -p "$OUT"
