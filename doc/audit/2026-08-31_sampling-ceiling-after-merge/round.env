# =================================================================================================
# round.env -- the single place that decides which tree, which claim, which binaries and which
# artefact directory every command in the E round uses. Source it; never re-type these by hand.
#
#     . doc/audit/2026-08-31_sampling-ceiling-after-merge/round.env
#
# Why a file and not a shell variable typed per call: memory/put-measurement-commands-in-script-
# files. A variable retyped per invocation is a variable that can differ between invocations, and
# OUT differing between two scripts of one round is how one run gets read as another.
#
# [Co-developed with claude code -- Adam]
# =================================================================================================
export KERNEL_DIR=/home/adam/Desktop/NDTwin-Kernel
export ROUND="$KERNEL_DIR/doc/audit/2026-08-31_sampling-ceiling-after-merge"

# The 08-20 round owns measure.sh AND the raw directory it hardcodes; the 08-25 round owns
# cell_verdict.py, which reads that same directory through `from plot_figures import RAW`.
# Neither is copied and neither is edited: this round's comparability with the D-round cells in
# PREREG §6 rests on the instrument being the same bytes, and an "improved" copy would fork it.
# The consequence is that cells land in PRIOR_RAW first and are COPIED here afterwards -- see
# lib_e.sh:archive_cell.  🔴 PREREG §6 wants per-cell comparison against t008/t004; that is only
# meaningful while this stays byte-identical.
export PRIOR="$KERNEL_DIR/doc/audit/2026-08-20_sampling-rate-and-cpu"
export PRIOR_RAW="$PRIOR/raw"
export ROUND25="$KERNEL_DIR/doc/audit/2026-08-25_sampling-rounds"

export NDT_OWNER="${NDT_OWNER:-e-round-sampling-ceiling}"
export NDT_EXCLUSIVE_CPU=1

export LAB="sudo -n /usr/local/sbin/ndtwin-lab"
export TOPO="$KERNEL_DIR/setting/StaticNetworkTopologyP4_10Switches_128Hosts.json"
export P4SRC="$KERNEL_DIR/p4_proxy/p4_src/ndtwin_switch.p4"
export P4BUILD="$KERNEL_DIR/p4_proxy/p4_src/build"
export KBIN="$KERNEL_DIR/build/bin/ndtwin_kernel"
export KBIN_BACKUP="$KERNEL_DIR/.test_run/binaries/e-round/ndtwin_kernel.production-backup"

# Staged kernel binaries, one per recompute period. Written by build_1khz_binary.sh BEFORE the
# window opens: PREREG §4 and LOCAL-FABRIC-QUEUE both forbid building inside the measurement
# window, and there is no env var that can switch this axis at run time -- see TBD-DRAFT.md D3.
export KBIN_STAGE="$KERNEL_DIR/.test_run/binaries/e-round"
export KBIN_1KHZ="$KBIN_STAGE/ndtwin_kernel.recompute-1khz"
export KBIN_1HZ="$KBIN_STAGE/ndtwin_kernel.recompute-1hz"
# Fifth control cell BL-true: the real pre-batching proxy tree at a3bb761^ (PREREG §3a(a)).
export PROXY_TREE_BLTRUE="$KBIN_STAGE/proxy-a3bb761-parent"

export PY_PLOT="${PY_PLOT:-$KERNEL_DIR/.plotvenv/bin/python}"
export PY_PROXY="$KERNEL_DIR/p4_proxy/venv/bin/python"

export OUT="$ROUND/raw"
export LOG="$ROUND/run_e.log"
mkdir -p "$OUT" "$KBIN_STAGE"

# ---- values that PREREG v0.2 did NOT freeze; see TBD-DRAFT.md D5/D6/D10 -------------------------
# They are collected HERE, with defaults, so that the reviewer can see in one place exactly which
# numbers the registration left open and what the scripts would use if nobody decides. Every one
# of them is a knob that could move a verdict, which is why they are not buried in a script body.
export DUR="${DUR:-300}"                 # seconds per cell.  D-round ladder used 300; gate_e/wall_f used 120
export BATCH_ON="${BATCH_ON:-8}"         # NDTWIN_SFLOW_BATCH for the "batching on" cells
export BATCH_OFF="${BATCH_OFF:-1}"       # and for "off"; 1 is also the PRODUCTION default (see D1)
export RATE_MBIT="${RATE_MBIT:-200}"     # offered UDP rate, matching the D round exactly
export CPU_GATE_FOREIGN_CORES="${CPU_GATE_FOREIGN_CORES:-0.50}"   # EXCESS over the baseline below
# 🔴 Measured, never typed.  On 2026-08-31 this machine idles at ~0.84 foreign cores with no
# fabric running -- claude-desktop ~0.37, the CLI sessions ~0.25, gnome-shell ~0.09 -- so an
# ABSOLUTE 0.5-core threshold is red before the round begins.  `gates_e.sh baseline` records it
# with the fabric DOWN; the gate then judges the excess over it and reports both numbers.
export CPU_BASELINE_FILE="${CPU_BASELINE_FILE:-$ROUND/raw/cpu_baseline.json}"
export LADDER="${LADDER:-1024 256 64 32 16 8 4 1}"
export REPS="${REPS:-3}"
export ARM_ORDER="${ARM_ORDER:-bl m p mp}"
export BLTRUE_RUNGS="${BLTRUE_RUNGS:-16 8 4}"   # PREREG §3a: wall-side three only, deliberately
