@@ -21,8 +23,42 @@
 from ryu.app.wsgi import WSGIApplication
 from ryu.base import app_manager
 from ryu.lib import dpid as dpid_lib
+from ryu.lib import hub
 from ryu.topology.api import get_switch, get_link, get_host
 
+# --- NDTwin: bound the three topology reads (doc/KNOWN-ISSUES.md A-2) --------------------------
+# [Co-developed with claude code -- Adam]
+#
+# get_switch/get_link/get_host are request-reply: send_request() puts an event on the
+# ryu.topology.switches app's queue and blocks on `req.reply_q.get()`, which has no timeout
+# (ryu/base/app_manager.py:279). When that app is wedged the reply never comes, and because this
+# runs on the per-connection WSGI greenlet the request is ACCEPTED and then never answered. That
+# is the exact shape the kernel measured: three /v1.0/topology/* endpoints returning HTTP 000
+# while /ryu_server/all_destination_paths in the SAME process answered in 0.2 ms.
+#
+# Two consequences, both removed by bounding it:
+#   1. The kernel's poll thread waited forever. `687de6c` bounded the client side, so the twin now
+#      gives up after --max-time 5 and says so -- but the cause is here, and an unbounded server
+#      is still an unbounded server.
+#   2. curl's abort does not reach this greenlet: it is parked before it ever writes, so it stays
+#      parked for the life of the process. Each poll round against a wedged Ryu leaks up to three
+#      of them out of eventlet's 1024-greenlet WSGI pool
+#      (eventlet/wsgi.py DEFAULT_MAX_SIMULTANEOUS_REQUESTS). A long enough wedge exhausts the pool
+#      and :8080 stops being serviced at all -- at which point the fault changes shape from
+#      accept-then-stall into no-accept, and the kernel's recovery line can never fire.
+#
+# 3 seconds, and it MUST stay below the kernel's --max-time 5. Whichever side gives up first is
+# the side that gets to explain what happened: if the client aborts first this warning is never
+# written and the greenlet is not released, which is the situation we are leaving.
+TOPO_REST_TIMEOUT_S = float(os.environ.get("NDTWIN_RYU_REST_TOPO_TIMEOUT_S", "3"))
+
+LOG = logging.getLogger(__name__)
+
+#: Distinguishes "the read timed out" from any value the read could legitimately return. The three
+#: getters return lists today, so `None` would do -- but a sentinel does not need that to stay
+#: true. [Co-developed with claude code -- Adam]
+_TIMED_OUT = object()
+
 # REST API for switch configuration
 #
 # get all the switches
@@ -94,11 +130,56 @@
     def get_hosts(self, req, **kwargs):
         return self._hosts(req, **kwargs)
 
+    @staticmethod
+    def _bounded(what, fn):
+        """Run one topology request-reply with a ceiling. Returns _TIMED_OUT if it did not answer.
+
+        [Co-developed with claude code -- Adam]
+        hub.Timeout raises into THIS greenlet only. eventlet's wsgi.server spawns one greenlet per
+        connection, so a read that gives up here costs this request and nothing else -- the other
+        two endpoints, and the custom app's own REST routes, are untouched.
+
+        The warning is not decoration: it is how a run proves the ceiling was in the process that
+        served the request. A wedge with zero of these lines means the patch did not land, which
+        is a different finding from the patch not working.
+        """
+        try:
+            with hub.Timeout(TOPO_REST_TIMEOUT_S):
+                return fn()
+        except hub.Timeout:
+            LOG.warning(
+                "topology read %s did not answer within %.1fs -- ryu.topology.switches may be "
+                "blocked. Answering 503 with an empty body rather than holding the connection.",
+                what, TOPO_REST_TIMEOUT_S)
+            return _TIMED_OUT
+
+    @staticmethod
+    def _unavailable():
+        """503 with an EMPTY body, which is the shape the kernel can actually act on.
+
+        [Co-developed with claude code -- Adam]
+        The kernel reads these endpoints through utils::execCommand, a bare popen() that captures
+        curl's stdout and throws its exit status away -- so the HTTP status code never reaches the
+        kernel at all. The body is the entire channel. An empty body is the one failure signal
+        TopologyAndFlowMonitor already understands: it is what a timed-out curl produces, it is
+        what updateSwitches/updateHosts/updateLinks early-return on, and it is what the bounded
+        poll landed in `687de6c` reports and recovers from.
+
+        So a 5xx WITH a body would be strictly worse than the wedge: the kernel would see a
+        non-empty string, classify the round as answered, and either throw the error page at
+        json::parse or iterate it as topology. The status code is set anyway because a proxy, a
+        health check or a human reading a curl -i does see it, and 503 is the honest one -- but
+        the body is the part that had to be empty.
+        """
+        return Response(status=503, body=b'')
+
     def _switches(self, req, **kwargs):
         dpid = None
         if 'dpid' in kwargs:
             dpid = dpid_lib.str_to_dpid(kwargs['dpid'])
-        switches = get_switch(self.topology_api_app, dpid)
+        switches = self._bounded('switches', lambda: get_switch(self.topology_api_app, dpid))
+        if switches is _TIMED_OUT:
+            return self._unavailable()
         body = json.dumps([switch.to_dict() for switch in switches])
         return Response(content_type='application/json', body=body)
 
