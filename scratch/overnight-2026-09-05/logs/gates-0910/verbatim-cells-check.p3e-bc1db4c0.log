# command:     /home/adam/Desktop/NDTwin-Kernel/p4_proxy/venv/bin/python -c import os, re, sys
summary, logs = sys.argv[1], sys.argv[2]
rows = 0
for number, line in enumerate(open(summary).read().split("\n"), 1):
    if not line.startswith("|") or ".p3e-" not in line:
        continue
    cells = [c.strip() for c in line.strip("|").split("|")]
    names = re.findall(r"`([\w.\-]+\.p3e-[0-9a-f]+\.log)`", cells[-1])
    if not names:
        continue
    log = os.path.join(logs, names[0])
    if not os.path.exists(log):
        print(":%d  %s  -- LOG NOT FOUND" % (number, names[0])); continue
    text = open(log).read().split("\n")
    rows += 1
    for quoted in re.findall(r"`([^`]+)`", cells[-2]):
        if quoted.endswith(".log"):
            continue
        hits = [l for l in text if quoted in l]
        if not hits:
            print(":%d  %-46s NOT IN LOG: %r" % (number, names[0], quoted))
        elif not any(l.strip() == quoted.strip() for l in hits):
            print(":%d  %-46s TRUNCATED   %r\n      full line: %r" % (number, names[0], quoted, hits[0].strip()))
