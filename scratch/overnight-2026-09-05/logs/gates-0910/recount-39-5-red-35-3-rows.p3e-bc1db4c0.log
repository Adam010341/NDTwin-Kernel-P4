path = sys.argv[1]
lines = open(path).read().split("\n")
print("file: %s" % path)
print("wc -l equivalent (newline count): %d; last line (:%d): %r" % (open(path).read().count("\n"), len([l for l in lines]) - 1, lines[-2]))
start = next(i for i, l in enumerate(lines) if l.startswith("--- every structural difference")) + 1
rows = [(i + 1, l) for i, l in enumerate(lines[start:], start) if l.startswith("  keys missing") or l.startswith("  cardinality")]
# one rule per defect, stated once, applied to every row -- not chosen row by row
def defect(text):
    if "arm.meta" in text: return "declared: the twelve arm.meta keys NOT_WRITTEN_KEYS lists (not a defect)"
    if "control.meta" in text: return "(3) C1/C2 control.meta missing a key"
    if "sflow_rung" in text: return "(1) family counts nested inside telemetry_health"
    if "cpu.jsonl" in text: return "(4) one bmv2 process instead of ten"
    if "excluded_host_facing" in text: return "(2) excluded_host_facing 2 not 4"
    if " keys " in text or "per_edge_peak_bps" in text: return "ruling 35(1) itself (the defect being fixed, not an extra find)"
    return "UNCLASSIFIED"
kinds = {"keys missing": 0, "cardinality": 0}
tally = {}
for number, text in rows:
    kind = "keys missing" if text.startswith("  keys missing") else "cardinality"
    kinds[kind] += 1
    d = defect(text)
    tally[d] = tally.get(d, 0) + 1
    print("  :%-3d %-12s %-58s <- %s" % (number, kind, text.strip()[:58], d))
print("\nrows: %d  (%s)" % (len(rows), ", ".join("%d %s" % (v, k) for k, v in kinds.items())))
print("line range: :%d-%d" % (rows[0][0], rows[-1][0]))
