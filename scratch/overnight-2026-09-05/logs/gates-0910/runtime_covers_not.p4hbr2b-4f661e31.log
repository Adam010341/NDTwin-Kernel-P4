import re, sys
cover, rt = open(sys.argv[1]).read(), open(sys.argv[2]).read()
nots = {f"{m.group(1)}:{m.group(2)}" for m in re.finditer(r"^  (\S+)\s+(\d+) \S+\s+NOT ", cover, re.M)}
covered = set(re.search(r"^COVERED: (.*)$", rt, re.M).group(1).split())
