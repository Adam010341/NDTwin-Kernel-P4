+stats_flows() {   # stats_flows <dir> -- /stats/flow/<dpid> for s1-s4
+    mkdir -p "$1"
+    local d
+    for d in 1 2 3 4; do get_json "$PROXY_URL/stats/flow/$d" "$1/stats_flow_$d.json" || true; done
+}
