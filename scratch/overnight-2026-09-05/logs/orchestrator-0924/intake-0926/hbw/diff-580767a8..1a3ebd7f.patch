+        case "$(tail -1 "$RUN/34_pingall_cut.txt")" in
+            "PINGALL_LOSS pairs=12 zero_loss=12 lossy=0 untested=0") note "H1: all 12 pairs at 0% loss around the cut" ;;
+            *) fail "H1 ping around the cut: $(tail -1 "$RUN/34_pingall_cut.txt")" ;;
+        esac
