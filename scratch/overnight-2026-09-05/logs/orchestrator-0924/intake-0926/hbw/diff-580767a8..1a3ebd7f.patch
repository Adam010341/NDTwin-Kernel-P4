+        chunks, total = [], 0
+        while True:
+            chunk = os.read(fd, 65536)
+            if not chunk:
+                break
+            total += len(chunk)
+            if total > MAX_REPORT_BYTES:
+                raise ReportUntrusted(f"{path} is larger than {MAX_REPORT_BYTES} bytes")
+            chunks.append(chunk)
