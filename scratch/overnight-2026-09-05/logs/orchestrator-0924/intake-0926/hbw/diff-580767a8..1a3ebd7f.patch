+        for name in loader.getTestCaseNames(c):
+            print(f"ID {module_name}.{c.__name__}.{name}")
+PY
+) || { echo "REFUSE: could not enumerate the new tests"; exit 2; }
+{ sed -n 's/^ID //p' "$NEW_IDS.raw"; printf '%s\n' "$NEW_TESTS"; } | sort -u > "$NEW_IDS"
