+ndt_run() {   # ndt_run <ndt copy> [helper copy] -> the suite's output
+    ( TMPDIR="$BK/tmp" NDT_UNDER_TEST="$1" HELPER_UNDER_TEST="${2:-$HELPER}" timeout 600 bash "$NDT_TEST" 2>&1 )
