+        judge "$(verdict rerouted "$RUN/25_before" "$RUN/33_after" "$CA" "$CAP" "$CB" "$CBP")" "H1 routes rewritten"
+        set +e; pingall_loss "$PKG_ROLES" 5 "$RUN/34_ping_raw.txt" > "$RUN/34_pingall_cut.txt" 2>&1; set -e
