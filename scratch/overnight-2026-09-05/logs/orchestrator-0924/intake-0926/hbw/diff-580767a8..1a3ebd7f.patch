+    restore_cycle "H1 cycle $CYC" "$RUN/35_graph_restored_$CYC.json" "$RUN/35_switch_state_restored_$CYC.json" \
+        "$RUN/35_restore_watch_$CYC.json" || { fail "H1 cycle $CYC: could not remove the netem"; exit 1; }
