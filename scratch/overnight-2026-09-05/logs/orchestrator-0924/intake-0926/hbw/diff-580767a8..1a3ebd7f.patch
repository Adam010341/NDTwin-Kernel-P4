+# === the proxy ====================================================================================
+lay_out() {   # $1 = a directory to become a repo-shaped copy
+    local d="$1"
+    mkdir -p "$d/p4_proxy/p4_src" "$d/tools/test_workflow" "$d/home" "$d/tmp"
+    cp -r "$REPO/p4_proxy/proxy_agent" "$REPO/p4_proxy/tests" "$REPO/p4_proxy/mininet" "$d/p4_proxy/"
