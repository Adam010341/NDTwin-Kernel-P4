+    rm -f "$FIX/.test_run/tick" "$FIX/.test_run/fetch_straddles" "$FIX/.test_run/pids/app_te.pid"
+    wait_phase 400000 430000 || { CLOCK_WHY="the clock never showed .40-.43 of a second"; return 1; }
