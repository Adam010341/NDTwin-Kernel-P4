+    [[ "$kind" == old ]] && wait_until "$(( k + 2 ))" 580000
+    : > "$FIX/.test_run/ps_waits"
+    CLOCK_OUT="$(FX_PLANE=ovs run_residue "$CLOCK_STUBS" te)"
+    et="$(command ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')"
+    kill -KILL "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
