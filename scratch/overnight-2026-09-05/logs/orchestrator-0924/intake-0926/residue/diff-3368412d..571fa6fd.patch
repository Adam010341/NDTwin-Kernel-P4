+CLOCK_STUBS='
+http_get_flow_entries() { python3 "$REPO/fake_switch.py" "$REPO/.test_run/rule_at" "$REPO/.test_run/fetch_straddles"; }
+ps() {
+    local s0 s1 _w
+    case " $* " in
+        *" etimes= "*)
