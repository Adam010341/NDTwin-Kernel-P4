+    if reclaim "$(claim_minutes 15)" "$(lab_claim_field note)" "$1"; then
+        unset NDT_MEASURING
+        return 0
+    fi
+    fail "could not take back this run's measuring= declaration -- see $(basename "$1"); 'ndt down' refuses while it stands"
+    return 1
