+report "M18: a newline in a claim note is passed on" "$m" \
+       Whitelist.test_claim_note_with_a_newline_is_refused
+
+m=$(mutant m19 "$VERBS_PY" \
+    '    extra = sorted(set(body) - set(allowed))' \
