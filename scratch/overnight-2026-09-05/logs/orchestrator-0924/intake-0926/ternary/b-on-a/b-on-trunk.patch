+    def test_only_the_most_recent_generations_are_kept(self):
+        journal = self.a_journal()
+        made = []
+        for _ in range(5):
+            made.append(os.path.basename(journal.write_snapshot({}, [rec("insert", "K")], keep=2)))
+            time.sleep(0.002)
