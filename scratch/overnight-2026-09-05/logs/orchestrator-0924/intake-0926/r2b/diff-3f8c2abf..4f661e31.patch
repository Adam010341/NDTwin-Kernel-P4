+                    bad.append("%s:%d cites ndt:%d-%d; lock_probe's comment starts at %d, its POST is at %d, "
+                               "it ends at %d" % (os.path.basename(path), line, a, b, head[0], post[0], end))
+        self.assertEqual(bad, [])
