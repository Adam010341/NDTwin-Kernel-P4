+''', 1),
+    ], [
+        ("the census table without 'column' ended the run: rc 127", "column: command not found"),
+    ]),
+    "R4-3/d-i": ("judge (d)(i): hb_watch all-heard / others-up with a bare load()", [
+        ("watch", '''        try:
+            print(all_heard(load(argv[2]), float(argv[3])))
