+# second), the report snapshot, and the heartbeat stopped -- now, not at the end of the window.
+# Called directly, never in $( ): sp_hb_stop's HB_STARTED=0 has to reach this shell.
+watch_sniffers() {
+    local dir="$1" stopf="$2" cap="$3" p running end
+    shift 3
+    end=$(( $(date +%s) + cap ))
+    WATCH_HIT=""
+    while :; do
