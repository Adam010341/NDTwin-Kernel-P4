+run_suite() {   # echo "<rc>|<comma separated FAILED check names>"
+    local out rc
+    out="$(timeout "$TEST_TIMEOUT" bash "$SUITE" 2>&1)"; rc=$?
+    printf '%s|%s' "$rc" "$(printf '%s\n' "$out" | sed -n 's/^  FAILED  *//p' | paste -sd, -)"
