+    "$( ( source "$LAB" 2>/dev/null; echo "$HB_RUN_DIR $HB_PIDFILE" ) )"
+
+echo
+echo "Ran $((PASS+FAIL)) checks, $FAIL failed"
+(( FAIL == 0 ))
