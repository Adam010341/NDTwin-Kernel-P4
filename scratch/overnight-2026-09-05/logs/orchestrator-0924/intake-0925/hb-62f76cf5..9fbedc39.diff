+NDT=tools/test_workflow/ndtwin-lab
+SUITE=tests/shell/test_ndtwin_lab_heartbeat.sh
+
+if ! bash -n "${BASH_SOURCE[0]}"; then echo "🔴 this script does not parse" >&2; exit 2; fi
