+MAGIC = b"NDHB"
+VERSION = 1
+HEAD = struct.Struct("!6s6sH")
+#: magic, version, flags, session, direction id, seq, tx dpid, tx port, rx dpid, rx port
+BODY = struct.Struct("!4sBB8sHIQHQH")
+FRAME_LEN = 60
+
+# --------------------------------------------------------------------------------- the cadence
+#: 🔴 NOT READ FROM THE PROXY, AND PINNED TO IT BY A TEST. This equals the proxy's
+#: LLDP_BEACON_INTERVAL_S (p4_proxy/proxy_agent/topology_manager.py), so a heartbeat is as frequent
