+    def bpf_run(prog, pkt):
+        """Just enough of classic BPF for this filter: ldh, jeq, ret."""
+        pc, A = 0, 0
+        while pc < len(prog):
+            code, jt, jf, k = prog[pc]
+            if code == 0x28:
+                if k + 2 > len(pkt):
+                    return 0
+                A = int.from_bytes(pkt[k:k + 2], "big")
+                pc += 1
+            elif code == 0x15:
+                pc += 1 + (jt if A == k else jf)
+            elif code == 0x06:
+                return k
+            else:
+                return f"unknown opcode {code:#x}"
+        return "fell off the end"
