+# registry_clear_stale -- `ndt down`'s removal of every STALE *.pid. Says what it removed and why;
+# rc 1 when something stale could not be removed. Sets REGISTRY_STALE_REMOVED (a count).
+#
+# [Co-developed with claude code -- Adam]
+# 🔴 AN APP'S WINDOW IS WRITTEN DOWN FIRST. app_started_at dates an app whose process is gone by
+# this very file's mtime, and app_window_seal closes that window -- so the file is the only
+# record of when that app ran here (G-12, RESIDUE-1), and app_stop's energy|sim branch keeps a
+# dead pidfile for exactly that reason. The window [mtime, sealed end] goes to the F3 record
+# (app_window_record) before the file does, which is where every later residue report looks once
+# the pidfile is gone; the report then reads the same window it would have read from the file.
+#
+# ONLY `stale`. `group` is a live group the record names, `unusable` is its own finding (stack.sh's
+# stop_one removes an unusable stack pidfile itself, and says so), and `unjudged` is a file this
+# command cannot prove anything about -- none of them is removed here.
+REGISTRY_STALE_REMOVED=0
+registry_clear_stale() {
+    local f base name rc=0 start seal end said=0
+    REGISTRY_STALE_REMOVED=0
+    for f in "$REPO"/.test_run/pids/*.pid; do
+        [[ -e "$f" ]] || continue
+        pidfile_judge "$f"
+        [[ "$PF_STATE" == stale ]] || continue
+        (( said == 0 )) && { say "stale registry entries"; said=1; }
+        base="${f##*/}"; name=""
+        if [[ "$base" == app_*.pid ]]; then
+            name="${base#app_}"; name="${name%.pid}"
+            start="$(stat -c %Y "$f" 2>/dev/null)"
+            end=""; seal="$(app_window_seal "$name" 2>/dev/null)" && end="${seal%% *}"
+            app_window_record "$name" "$start" "$end" \
+                || warn "  could not write $name's window down before removing its pidfile"
+        fi
+        if rm -f "$f" 2>/dev/null && [[ ! -e "$f" ]]; then
+            ok "removed stale ${f#$REPO/} -- $PF_WHY"
+            REGISTRY_STALE_REMOVED=$(( REGISTRY_STALE_REMOVED + 1 ))
+            [[ -n "$name" ]] && rm -f "$(app_pgidfile "$name")" 2>/dev/null
+        else
+            err "could NOT remove stale ${f#$REPO/} ($PF_WHY) -- check its ownership"
+            rc=1
+        fi
+    done
+    return $rc
+}
