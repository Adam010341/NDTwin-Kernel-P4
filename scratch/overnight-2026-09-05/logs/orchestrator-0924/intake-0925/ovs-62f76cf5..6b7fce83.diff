+# pidfile_judge <path> -- sets PF_STATE, PF_PID, PF_GROUP, PF_WHY. Globals, not stdout: there are
+# four answers, and a caller inside $(...) reads them in the same subshell it called from.
+#   live      the pid exists -- and, for app_<name>.pid, its argv carries that app's signature
+#   stale     the pid is gone (for an app: or is alive as somebody else -- a recycled number), and
+#             the recorded process group has no member left, or none is recorded
+#   group     the pid is gone but its process group still has live members. NOT stale: that is
+#             FINDINGS #6/#48's shape (viz's launcher dead, its two JVMs running two hours on),
+#             and a teardown that deleted this record would delete the only thing naming them
+#   unusable  not a pid (empty, non-numeric, < 2): its own finding, never "stale"
+#   unjudged  a symlink (never followed -- stop_one's and app_stop's rule), or the group to ask
+#             about is this shell's own (app_group_pids rc 2): nothing here can prove it dead
+#
+# 🔴 WHICH GROUP. app_<name>.pid: the one app_spawn recorded beside it, app_<name>.pgid. A stack
+# <name>.pid: its own number -- start_bg setsids, so the recorded pid IS the group's id, which is
+# the same assumption stop_one makes when it signals `-$pid`. A <name>.child.pid: no group of its
+# own to ask; its group is <name>.pid's, and that file is judged on its own line.
+#
+# 🔴 IDENTITY, and the asymmetry is deliberate. An app pidfile is checked against the app's argv
+# signature (pid_is_app), so a live number that is not the app any more is stale. The stack's
+# files carry no signature this script can check (pid_alive's header), so a live number there is
+# LIVE even if it has been recycled -- the direction that can never delete a running stack's
+# record. stack.sh's stop_one has the finer test (start time against the pidfile's mtime) and
+# applies it before it signals anything.
+PF_STATE=""; PF_PID=""; PF_GROUP=""; PF_WHY=""
+pidfile_judge() {
+    local f="$1" base name pid g="" members grc
+    PF_STATE=unjudged; PF_PID=""; PF_GROUP=""; PF_WHY=""
+    base="${f##*/}"
+    if [[ -L "$f" ]]; then PF_WHY="it is a symlink, and is not followed"; return 0; fi
+    [[ -f "$f" ]] || { PF_WHY="it is not a regular file"; return 0; }
+    pid="$(cat "$f" 2>/dev/null)"
+    PF_PID="$pid"
+    if [[ ! "$pid" =~ ^[0-9]+$ ]] || (( pid < 2 )); then
+        PF_STATE=unusable; PF_WHY="it holds '${pid:-<empty>}', which is not a pid"
+        return 0
+    fi
+    if [[ "$base" == app_*.pid ]]; then
+        name="${base#app_}"; name="${name%.pid}"
+        if pid_is_app "$pid" "$name"; then PF_STATE=live; return 0; fi
+        if pid_alive "$pid"; then
+            PF_WHY="pid $pid is alive but is not $name -- a recycled number"
+        else
+            PF_WHY="pid $pid gone"
+        fi
+        g="$(cat "$(app_pgidfile "$name")" 2>/dev/null)"
+    else
+        if pid_alive "$pid"; then PF_STATE=live; return 0; fi
+        PF_WHY="pid $pid gone"
+        [[ "$base" == *.child.pid ]] || g="$pid"
+    fi
+    if [[ "$g" =~ ^[0-9]+$ ]] && (( g > 1 )); then
+        PF_GROUP="$g"
+        members="$(app_group_pids "$g")"; grc=$?
+        if (( grc != 0 )); then
+            PF_STATE=unjudged
+            PF_WHY="$PF_WHY, and its process group $g is this shell's own, which cannot be asked"
+            return 0
+        fi
+        if [[ -n "$members" ]]; then
+            PF_STATE=group
+            PF_WHY="$PF_WHY, but its process group $g still has live member(s): $(printf '%s\n' "$members" | head -5 | tr '\n' ' ' | sed 's/ $//')"
+            return 0
+        fi
+        PF_WHY="$PF_WHY; process group $g empty"
+    fi
+    PF_STATE=stale
+    return 0
+}
