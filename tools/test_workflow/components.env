# Single source of truth for where things live and how they start.
#
# Sourced by the l0/l1/stack scripts so paths, conda envs and ports are declared once.
# Override any of these in the environment before sourcing, e.g.
#   NDT_URL=http://192.168.1.5:8000 ./l0_build_check.sh
#
# Values verified on this machine; adjust if your layout differs.
#
# [Co-developed with claude code -- Adam]

# --- repositories ---------------------------------------------------------------
: "${KERNEL_DIR:=/home/adam/Desktop/NDTwin-Kernel}"
: "${ENERGY_APP_DIR:=/home/adam/Energy-Saving-App}"
: "${SIM_MGR_DIR:=/home/adam/Simulation-Platform-Manager}"
: "${VISUALIZER_DIR:=/home/adam/Network-Traffic-Visualizer}"
: "${WEBGUI_DIR:=/home/adam/Web-GUI}"
: "${NSR_DIR:=/home/adam/Network-State-Recorder}"
: "${NTG_DIR:=/home/adam/Network-Traffic-Generator}"
: "${TE_APP_DIR:=/home/adam/Traffic-Engineering-App}"

# --- python environments --------------------------------------------------------
# Ryu 4.34 needs Python 3.8, which is why ryu-env exists separately.
: "${CONDA_ROOT:=/home/adam/miniconda3}"
: "${RYU_PY:=$CONDA_ROOT/envs/ryu-env/bin/python}"
: "${RYU_MANAGER:=$CONDA_ROOT/envs/ryu-env/bin/ryu-manager}"
: "${NTG_PY:=$CONDA_ROOT/envs/ntg-env/bin/python}"
: "${TE_PY:=$CONDA_ROOT/envs/te-env/bin/python}"
# The P4 proxy agent has its own venv (p4_proxy/venv) created by requirements.txt.
: "${P4_PROXY_PY:=$KERNEL_DIR/p4_proxy/venv/bin/python}"

# --- endpoints ------------------------------------------------------------------
: "${NDT_URL:=http://localhost:8000}"          # kernel northbound API
: "${RYU_URL:=http://localhost:8080}"          # Ryu REST (OVS mode)
: "${P4_PROXY_URL:=http://localhost:8081}"     # P4 proxy agent (P4 mode)
: "${SFLOW_PORT:=6343}"                        # kernel's sFlow collector

# --- topologies -----------------------------------------------------------------
: "${TOPO_OVS:=$KERNEL_DIR/setting/StaticNetworkTopologyMininet_10Switches.json}"
: "${TOPO_P4:=$KERNEL_DIR/setting/StaticNetworkTopologyP4_10Switches_4Hosts.json}"

# --- P4 artefacts ---------------------------------------------------------------
: "${P4_SRC:=$KERNEL_DIR/p4_proxy/p4_src/ndtwin_switch.p4}"
: "${P4_BUILD_DIR:=$KERNEL_DIR/p4_proxy/p4_src/build}"
: "${P4_TOPO_SCRIPT:=$KERNEL_DIR/p4_proxy/mininet/p4_testbed_topo.py}"
: "${OVS_TOPO_SCRIPT:=$KERNEL_DIR/testbed_topo.py}"
: "${RYU_APP:=$KERNEL_DIR/intelligent_router.py}"

# --- run artefacts --------------------------------------------------------------
# Logs and pidfiles for one test run. Kept out of the repo.
: "${RUN_DIR:=/tmp/ndtwin_test_run}"
: "${LOG_DIR:=$RUN_DIR/logs}"
: "${PID_DIR:=$RUN_DIR/pids}"
: "${BASELINE_DIR:=$RUN_DIR/baseline}"

# --- test tooling ---------------------------------------------------------------
: "${CONTRACT_DIR:=$KERNEL_DIR/tools/contract_test}"
