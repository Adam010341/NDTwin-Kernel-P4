# Single source of truth for where things live and how they start.
#
# Sourced by the l0/l1/stack scripts so paths, conda envs and ports are declared once.
# Override any of these in the environment before sourcing, e.g.
#   NDT_URL=http://192.168.1.5:8000 ./l0_build_check.sh
#
# Values verified on this machine; adjust if your layout differs.
#
# [Co-developed with claude code -- Adam]

# --- repositories ---------------------------------------------------------------
# KERNEL_DIR is derived from this file's own location, so a different checkout works without
# editing anything. WORKSPACE_ROOT is where the sibling component repos live -- discovered
# by looking for one of them rather than assumed at a fixed depth, since the kernel is not
# necessarily their direct sibling.
: "${KERNEL_DIR:=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
if [ -z "${WORKSPACE_ROOT:-}" ]; then
    WORKSPACE_ROOT="$(dirname "$KERNEL_DIR")"
    _probe="$WORKSPACE_ROOT"
    for _ in 1 2 3 4; do
        if [ -d "$_probe/Energy-Saving-App" ]; then WORKSPACE_ROOT="$_probe"; break; fi
        _parent="$(dirname "$_probe")"
        [ "$_parent" = "$_probe" ] && break
        _probe="$_parent"
    done
    unset _probe _parent
fi
: "${ENERGY_APP_DIR:=$WORKSPACE_ROOT/Energy-Saving-App}"
: "${SIM_MGR_DIR:=$WORKSPACE_ROOT/Simulation-Platform-Manager}"
: "${VISUALIZER_DIR:=$WORKSPACE_ROOT/Network-Traffic-Visualizer}"
: "${WEBGUI_DIR:=$WORKSPACE_ROOT/Web-GUI}"
: "${NSR_DIR:=$WORKSPACE_ROOT/Network-State-Recorder}"
: "${NTG_DIR:=$WORKSPACE_ROOT/Network-Traffic-Generator}"
: "${TE_APP_DIR:=$WORKSPACE_ROOT/Traffic-Engineering-App}"

# --- python environments --------------------------------------------------------
# Ryu 4.34 needs Python 3.8, which is why ryu-env exists separately.
# conda lives in the user's home, not the workspace; unrelated to where the repos are.
: "${CONDA_ROOT:=$HOME/miniconda3}"
: "${RYU_PY:=$CONDA_ROOT/envs/ryu-env/bin/python}"
: "${RYU_MANAGER:=$CONDA_ROOT/envs/ryu-env/bin/ryu-manager}"
: "${NTG_PY:=$CONDA_ROOT/envs/ntg-env/bin/python}"
: "${TE_PY:=$CONDA_ROOT/envs/te-env/bin/python}"
# The P4 proxy agent has its own venv (p4_proxy/venv) created by requirements.txt.
: "${P4_PROXY_PY:=$KERNEL_DIR/p4_proxy/venv/bin/python}"

# --- endpoints ------------------------------------------------------------------
: "${NDT_URL:=http://localhost:8000}"          # kernel northbound API
: "${RYU_URL:=http://localhost:8080}"          # Ryu REST (OVS mode)
: "${P4_PROXY_URL:=http://localhost:8081}"     # P4 proxy agent (P4 mode)
: "${SFLOW_PORT:=6343}"                        # kernel's sFlow collector

# Upper bound, in whole seconds, on waiting for LLDP discovery before starting the kernel.
# This is a timeout, not a fixed sleep: stack.sh polls the control plane until it reports the
# whole topology (counts derived from the topology file), which on a small topology takes a
# couple of seconds rather than the manual's nominal 60.
#
# The wait exists because the kernel pulls topology and destination paths exactly once at
# startup with no retry, so anything the control plane has not discovered by then is invisible
# to it for the rest of the run.
#
# Applies to both modes -- P4 needs it for the proxy's own LLDP discovery, not just Ryu's --
# hence the neutral name. RYU_CONVERGE_WAIT is still honoured as the former name.
#
# It is an upper bound, not a fixed wait: await_convergence polls and returns as soon as the
# control plane is ready. 150 rather than 60 because in OVS mode the milestone that matters --
# "all-destination paths installed", the one the user manual names -- sits behind a hard-coded
# `hub.sleep(60)` in intelligent_router.py:282, plus the time to compute and install all-pair
# paths. A 60s bound could therefore expire before the thing it is waiting for can happen.
: "${CONVERGE_WAIT:=${RYU_CONVERGE_WAIT:-150}}"

# --- topologies -----------------------------------------------------------------
: "${TOPO_OVS:=$KERNEL_DIR/setting/StaticNetworkTopologyMininet_10Switches.json}"
: "${TOPO_P4:=$KERNEL_DIR/setting/StaticNetworkTopologyP4_10Switches_4Hosts.json}"

# --- P4 artefacts ---------------------------------------------------------------
: "${P4_SRC:=$KERNEL_DIR/p4_proxy/p4_src/ndtwin_switch.p4}"
: "${P4_BUILD_DIR:=$KERNEL_DIR/p4_proxy/p4_src/build}"
: "${P4_TOPO_SCRIPT:=$KERNEL_DIR/p4_proxy/mininet/p4_testbed_topo.py}"
: "${OVS_TOPO_SCRIPT:=$KERNEL_DIR/testbed_topo.py}"
: "${RYU_APP:=$KERNEL_DIR/intelligent_router.py}"

# --- run artefacts --------------------------------------------------------------
# Logs and pidfiles for one test run. Gitignored, so it stays out of commits.
#
# Deliberately NOT under /tmp. A predictable path in a world-writable directory lets any
# local user pre-create the pidfiles that stack.sh later reads and kills, and swap files for
# symlinks between the check and the read. Workspace-local removes the shared-directory
# exposure entirely; stop_one() validates the pid regardless.
: "${RUN_DIR:=$KERNEL_DIR/.test_run}"
: "${LOG_DIR:=$RUN_DIR/logs}"
: "${PID_DIR:=$RUN_DIR/pids}"
: "${BASELINE_DIR:=$RUN_DIR/baseline}"

# --- test tooling ---------------------------------------------------------------
: "${CONTRACT_DIR:=$KERNEL_DIR/tools/contract_test}"
