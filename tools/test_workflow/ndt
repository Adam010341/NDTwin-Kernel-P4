# stack_pidfile_row -- what .test_run/pids/ claims is running, tested against /proc.
# Fills STACK_PIDFILE_PROBLEMS with one entry per file that cannot be believed.
#
# [Co-developed with claude code -- Adam]
# R7 I-3, measured 2026-09-11 02:52:03 and again at 02:52:27 -- 57 s and 81 s after the event, so
# not a race. One directory, two files, opposite stories:
#
#     ryu.pid        20717    /proc/20717 does not exist
#     ryu.child.pid  20722    /proc/20722 does not exist
#     ryu.exit       at=2026-09-11T02:51:06  status=143  reason=terminated by SIGTERM (15)
#
# Ten OVS bridges were up with no control-plane process at all, and `ndt status` printed the
# ports correctly, printed `fabric hosts 4 == 4 ok`, said not one word about the two dead
# pidfiles, and exited 0. A reader who checks the exit code, or reads the `up target` block, was
# told that round was fine.
#
# 🔴 IT IS NOT A COSMETIC GAP. .test_run/pids/ is the shared registry `ndt down` acts on, and
# port_owner_local above reads every file in it to decide whether a listener is "ours" -- so a
# recycled pid number sitting in a stale pidfile is the fuse under both. The hardened predicate
# was already in this file for the app pidfiles (pid_is_app, whose comment names root/EPERM and
# pid reuse as the two holes in `kill -0`) and had never been pointed at the stack's own.
#
# 🔴 THE OTHER DIRECTION: a live stack is the ordinary state of this directory, so "alive" is
# printed plainly and adds no problem. A row that reddened a healthy lab would be read for a
# week and then skipped, and this row's whole value is that it is read on the day it is odd.
#
# 🔴 app_*.pid is SKIPPED, and that is not an omission: the apps block has its own probe with
# three states and an identity test this row cannot make (the argv signature). Two instruments
# over one file would eventually disagree in public.
STACK_PIDFILE_PROBLEMS=()
stack_pidfile_row() {
    STACK_PIDFILE_PROBLEMS=()
    local f base name pid ev_at ev_st line
    local -a bad=() live=()
    for f in "$REPO"/.test_run/pids/*.pid; do
        [[ -f "$f" ]] || continue
        base="$(basename "$f")"
        [[ "$base" == app_* ]] && continue
        # ryu.child.pid and ryu.pid are two files about one component, so both read the one
        # .exit record: `<name>.child.pid` -> name `ryu`.
        name="${base%.pid}"; name="${name%.child}"
        pid="$(cat "$f" 2>/dev/null)"
        if [[ ! "$pid" =~ ^[0-9]+$ ]] || (( pid < 2 )); then
            bad+=("$base: unusable -- it holds '${pid:-<empty>}', which is not a pid. 'ndt down' reads these files.")
            continue
        fi
        if pid_alive "$pid"; then
            live+=("$base=$pid alive")
            continue
        fi
        ev_at="$(exit_record_field "$name" at)"; ev_st="$(exit_record_field "$name" status)"
        if [[ -n "$ev_at" || -n "$ev_st" ]]; then
            bad+=("$base: stale pidfile (pid $pid gone; $name.exit says status=${ev_st:-?} at ${ev_at:-?} -- $(exit_record_field "$name" reason))")
        else
            bad+=("$base: stale pidfile (pid $pid gone; there is no $name.exit to say how it ended)")
        fi
    done
    if (( ${#bad[@]} == 0 && ${#live[@]} == 0 )); then
        printf '  %-14s %s\n' "pidfiles" "none recorded"
        return 0
    fi
    if (( ${#bad[@]} == 0 )); then
        printf '  %-14s %s\n' "pidfiles" "$(IFS=', '; echo "${live[*]}")"
        return 0
    fi
    printf '  %-14s %s\n' "pidfiles" "${R}${bad[0]}${N}"
    for line in "${bad[@]:1}"; do printf '  %-14s %s\n' "" "${R}$line${N}"; done
    (( ${#live[@]} > 0 )) && printf '  %-14s %s\n' "" "$(IFS=', '; echo "${live[*]}")"
    printf '  %-14s %s\n' "" "a dead number here is what 'ndt down' signals and what"
    printf '  %-14s %s\n' "" "port_owner_local calls 'ours' -- delete it or run 'ndt down'"
    for line in "${bad[@]}"; do STACK_PIDFILE_PROBLEMS+=(".test_run/pids/$line"); done
    return 0
}

# claim_prev_row -- the claim that was replaced or released, and whether the lab changed hands.
# Prints nothing when there is no .prev. Never a `--check` problem: this is history, and a row
# that turned a teardown red for something that has already happened would be read once.
#
# [Co-developed with claude code -- Adam]
# 🔴 R7 I-2, condition 2 of R7's own acceptance of the fix (R7-reconciler.md section 3b,
# 04:29:25). Condition 1 passed -- `.prev` really was the claim that had been replaced, verified
# field by field against R7's independent 118-point sampling record -- and condition 2 FAILED:
# R7 grepped the WHOLE of `ndt status` for prev|changed hands|took|handover|previous|was held and
# got ZERO hits. The evidence was being kept and no interface mentioned it, so a session that
# arrived at 04:29 still could not see that the claim had been rewritten two minutes before
# unless it knew to cat a file. That is half a fix, and this is the other half.
#
# 🔴 Printed whether or not a claim is live, because the reader who needs it is the one who
# arrives AFTER the change. It does not answer "who holds the lab" -- claim_line does, from the
# live file, and it still says `none` after a release.
#
# 🔴 CHANGED HANDS only when the owner really changed. The same owner re-claiming is a rewrite
# (I-2 residue #1: a note corrected by re-claiming, which pulled `expires` three hours out), and
# it is disclosed as one. Calling every rewrite a handover would teach the reader to skip the row.
#
# The time comes from the FILE's mtime, not from a field: nothing in the claim format records
# when it was superseded, and the moment the copy was written is exactly that.
claim_prev_row() {
    local f="$CLAIM.prev" powner pexp pnote at live
    [[ -f "$f" ]] || return 0
    powner="$(claim_prev_field owner)"; pexp="$(claim_prev_field expires)"
    pnote="$(claim_prev_field note)"
    at="$(stat -c %Y "$f" 2>/dev/null)"
    printf '  %-14s %s\n' "prev claim" \
        "${powner:-<no owner field>} (until $( [[ "$pexp" =~ ^[0-9]+$ ]] && date -d "@$pexp" '+%H:%M:%S' || echo '?' ))$( [[ "$at" =~ ^[0-9]+$ ]] && printf ', superseded %s' "$(date -d "@$at" '+%Y-%m-%d %H:%M:%S')" )  (${f#$REPO/})"
    live="$(claim_field owner)"
    if [[ -z "$live" ]]; then
        printf '  %-14s %s\n' "" "nothing holds the lab now: that claim was released or replaced"
    elif [[ "$live" == "$powner" ]]; then
        printf '  %-14s %s\n' "" "the same owner re-claimed it -- a rewrite, not a handover"
    else
        printf '  %-14s %s\n' "" "changed hands: $powner -> $live"
    fi
    [[ -n "$pnote" ]] && printf '  %-14s %s\n' "" "it said: $(printf '%s' "$pnote" | cut -c1-72)"
    return 0
}

# claim_line -- one line describing who holds the lab, in the form that answers "can I touch
# this right now". Relative time first: an absolute "until 17:11:52" makes the reader do
# arithmetic against the wall clock, which is the moment they get it wrong. The four states
# are deliberately worded differently -- an expired file must not read like a live claim, and
# your own claim must not read like someone else's.
claim_line() {
    [[ -f "$CLAIM" ]] || { echo "none"; return; }
    local owner exp now left
    owner="$(claim_field owner)"; exp="$(claim_field expires)"; now="$(date +%s)"
    if [[ ! "$exp" =~ ^[0-9]+$ ]]; then
        echo "malformed (no usable expires=) -- treated as free"; return
    fi
    if (( exp <= now )); then
        printf 'EXPIRED %dm ago (was %s) -- treated as free\n' $(( (now - exp) / 60 )) "$owner"
        return
    fi
    left=$(( (exp - now + 59) / 60 ))
    if [[ -n "${NDT_OWNER:-}" && "$owner" == "$NDT_OWNER" ]]; then
        printf 'yours -- %dm left (until %s)\n' "$left" "$(date -d "@$exp" +%H:%M:%S)"
    else
        printf '%s -- %dm left (until %s)\n' "$owner" "$left" "$(date -d "@$exp" +%H:%M:%S)"
    fi
}

# git_lines -- which code this is. The 2026-08-20 NDTWIN_CLONE_DISABLE episode was an
# uncommitted edit to p4_client.py silently changing behaviour, believed by two sessions and
# reverted an hour later; a modified source file is exactly the state that makes a run
# unreproducible, so it belongs where the operator looks before measuring. Doc and scratch
# edits are counted but not listed -- they cannot change what the stack does.
git_lines() {
    local head dirty behave
    head="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo '?')"
    dirty="$(git -C "$REPO" status --porcelain 2>/dev/null | wc -l)"
    printf '  %-14s %s' "code" "$head"
    if [[ "$dirty" == 0 ]]; then
        echo "  (clean tree)"
    else
        echo "  +$dirty file(s) with uncommitted changes"
        behave="$(git -C "$REPO" status --porcelain 2>/dev/null \
                  | cut -c4- | grep -E '^(src|include|p4_proxy|tools|setting)/' | head -4)"
        if [[ -n "$behave" ]]; then
            local n; n="$(printf '%s\n' "$behave" | wc -l)"
            printf '  %-14s %s\n' "" "${Y}$n of them can change behaviour:${N}"
            printf '%s\n' "$behave" | sed 's/^/                 /'
        fi
    fi
    # 🔴 I-3. Both of these run whatever git thinks, INCLUDING on a clean tree -- the early
    # `return` that used to sit above them is the bug: the knob's most dangerous value is the
    # one that matches HEAD, and a clean tree is exactly where the old code stopped looking.
    knob_row
    tree_vs_round_row
}

# knob_row -- the "can change behaviour" alarm for p4_proxy/mininet/host_count_override,
# derived from the VALUE and never from git. I-3, Adam's decision 09-07 (grill §4D round 10).
#
# [Co-developed with claude code -- Adam]
# Two comparisons, in this order, because they answer different questions:
#   1. against the value this round started with (.test_run/round.baseline), when there is one.
#      That is "have I put it back", and it is the one the 09-05 round needed: the baseline was
#      4 while HEAD was 128, so "restore" meant writing 4, and `git checkout --` would have
#      produced 128 (LAB-RULES hard rule 5, in red).
#   2. against 4 when there is no baseline. Unconditional, per Adam's ruling: with no record of
#      what the round started with, any value but the default is a fact worth putting on the
#      screen, because it decides how big the next fabric is.
# In both cases the row says what git thinks of the file, so the reader is told the thing that
# made I-3 invisible ("git calls it clean") rather than being left to infer it.
#
# 🔴 NOT RESTORED IS A PROBLEM, so `--check` exits 1 on it. Adam's decision 09-07 (grill §4E
# round 3, E-9), after the 04:36 live arm measured the row doing exactly half its job:
#
#     ndt claim ...                        (round baseline recorded: host_count=128)
#     echo 8 > p4_proxy/mininet/host_count_override
#     ndt status --check
#       knob baseline  8 -- this round started at 128 (at 04:36:41): NOT RESTORED   <- printed
#       tree vs round  0 file(s) LEFT the uncommitted set, 1 joined it
#     $?                                                                    0       <- rc 0
#
# (rounds/08-round2.md:146, step D.) Red text with a green exit code is the shape W16-2 was
# decided against in the first place -- "a report whose rc never goes red is one more green
# light" -- and end-of-round `--check` is precisely where "have I put the knob back" has to
# bite, because the next `ndt up p4` reads this file and nothing else does.
#
# 🔴 ONLY THIS BRANCH. The other two knob outcomes stay out of the problem list: `4 (the
# default)` is not a deviation at all, and `!= 4 with no baseline` cannot distinguish a
# forgotten restore from a deliberate 128-host round that never ran `ndt claim` -- it is a
# fact worth printing, not a verdict. tree_vs_round_row stays out too, for the reason written
# above it: committing during a round changes that set for good reasons. Adam ruled on the
# NOT RESTORED sentence and this list carries that sentence only.
#
# 🔴 THREE ANSWERS, NOT TWO. Adam's decision 09-07 (R3-NDT §7-1, E-9b), the evening after E-9
# landed: `ndt up p4 4` writes the knob through set_host_count, so the standard P4 round --
# claim at 128, build 4 hosts -- turned every `--check` in the round red, and arm_up.sh would
# have recorded a non-zero rc on every P4 arm. Middle answer: the knob holds exactly what
# `ndt up p4 <n>` wrote this round (round.baseline's up_wrote=), which is a WARNING with a
# deadline -- it still has to go back -- and NOT a problem. It is `ndt release` that refuses
# while the two differ (E-11b, cmd_release), so the deadline is enforced once, at the end,
# instead of firing on every status call in between.
#
# A value that is neither the round's starting value nor the last one ndt wrote is a hand edit,
# and that is the 04:36 case E-9 was decided on: still red, still a problem, still rc 1.
STATUS_KNOB_PROBLEMS=()
knob_row() {
    local rel="p4_proxy/mininet/host_count_override"
    local now base at gitstate upw upat
    STATUS_KNOB_PROBLEMS=()
    now="$(host_count)"
    if git -C "$REPO" diff --quiet -- "$rel" 2>/dev/null && \
       git -C "$REPO" diff --cached --quiet -- "$rel" 2>/dev/null; then
        gitstate="git calls this file CLEAN (it matches HEAD) -- that is NOT 'restored'"
    else
        gitstate="git calls this file modified"
    fi
    base="$(round_baseline_field host_count)"
    if [[ -n "$base" ]]; then
        at="$(round_baseline_field at)"
        [[ "$at" =~ ^[0-9]+$ ]] && at="$(date -d "@$at" '+%H:%M:%S' 2>/dev/null || echo "$at")"
        if [[ "$now" == "$base" ]]; then
            printf '  %-14s %s\n' "knob baseline" "$now == the value this round started with (at ${at:-?})"
            return 0
        fi
        upw="$(round_baseline_field up_wrote)"
        if [[ -n "$upw" && "$now" == "$upw" ]]; then
            upat="$(round_baseline_field up_wrote_at)"
            [[ "$upat" =~ ^[0-9]+$ ]] && upat="$(date -d "@$upat" '+%H:%M:%S' 2>/dev/null || echo "$upat")"
            printf '  %-14s %s\n' "knob baseline" "${Y}$now, written by 'ndt up p4 $now' at ${upat:-?} this round; the round started at $base -- write $base back before 'ndt release'${N}"
            # 🔴 Worded differently from the NOT RESTORED advice below on purpose: the anchors
            # of mutate_ndt_round_baseline.sh's N5/N5b are that line, and an identical sentence
            # here would make them ambiguous -- a gate that cannot apply its mutation reports a
            # SURVIVOR, which is how three cells of another gate lost their power (§3, R3-NDT).
            printf '  %-14s %s\n' "" "  echo $base > $rel      # write it back; 'git checkout --' would give you HEAD"
            printf '  %-14s %s\n' "" "'ndt release' refuses while these differ; 'ndt release --force' releases anyway"
            # 🔴 NOT a --check problem. This is the round doing what it was set up to do, and
            # the value goes back at the end -- where cmd_release now checks it. E-9b.
            return 0
        fi
        printf '  %-14s %s\n' "knob baseline" "${R}$now -- this round started at $base (at ${at:-?}): NOT RESTORED${N}"
        # Naming the value ndt DID write is what separates the two reds: with up_wrote recorded
        # and the knob on something else, somebody edited the file by hand after `ndt up`.
        [[ -n "$upw" ]] && printf '  %-14s %s\n' "" "'ndt up p4' wrote $upw this round; $now is neither that nor the value the round started with"
        printf '  %-14s %s\n' "" "$gitstate"
        printf '  %-14s %s\n' "" "it decides the next 'ndt up p4'. restore by WRITING the value:"
        printf '  %-14s %s\n' "" "  echo $base > $rel      # NOT 'git checkout --', which gives you HEAD"
        # E-9. The sentence carries all three things the reader needs where problem lines are
        # the only thing a gate's caller keeps: the value now, the value the round started
        # with, and that putting it back means WRITING it -- `git checkout --` hands back HEAD,
        # which on 09-05 was the 128 nobody wanted (LAB-RULES hard rule 5).
        STATUS_KNOB_PROBLEMS+=("the P4 host knob is NOT RESTORED: $rel is $now, this round started at $base -- write $base back ('echo $base > $rel'), not 'git checkout --', which gives you HEAD. (I-3)")
        return 0
    fi
    if [[ "$now" == 4 ]]; then
        printf '  %-14s %s\n' "knob baseline" "4 (the default; no round baseline recorded -- 'ndt claim' writes one)"
        return 0
    fi
    printf '  %-14s %s\n' "knob baseline" "${Y}$now != 4, and no round baseline exists to say whether that is deliberate${N}"
    printf '  %-14s %s\n' "" "$gitstate"
    printf '  %-14s %s\n' "" "the next 'ndt up p4' builds $now hosts. (I-3)"
}

# tree_vs_round_row -- what has entered and LEFT the uncommitted set since the round started.
#
# 🔴 THE SET, NOT THE COUNT, and both directions by name. On 09-05 the count went 22 -> 21 as
# the machine left its baseline: a file that stops being dirty is indistinguishable from a
# file that was tidied up, and the number moves the reassuring way for both. The direction that
# matters is the one a count cannot express -- `-` below -- so it is listed first and said in
# words. [Co-developed with claude code -- Adam]
#
# 🔴 It does NOT feed --check's problem list. Committing during a round changes this set for
# entirely good reasons, and a gate that fires on every commit is a gate nobody reads. What
# fires is knob_row's comparison above, which is about a value somebody has to put back.
tree_vs_round_row() {
    local f; f="$(round_baseline_file)"
    if [[ ! -f "$f" ]]; then
        printf '  %-14s %s\n' "tree vs round" "no baseline in ${f#$REPO/} -- nothing here can say what this round changed ('ndt claim' records one)"
        return 0
    fi
    local nowfile basefile added removed n_add n_rem
    nowfile="$(mktemp "${TMPDIR:-/tmp}/ndt-tree-now-XXXXXX")" || return 0
    basefile="$(mktemp "${TMPDIR:-/tmp}/ndt-tree-base-XXXXXX")" || { rm -f "$nowfile"; return 0; }
    git -C "$REPO" status --porcelain 2>/dev/null | cut -c4- | sort > "$nowfile"
    round_baseline_dirty > "$basefile"
    added="$(comm -13 "$basefile" "$nowfile")"
    removed="$(comm -23 "$basefile" "$nowfile")"
    rm -f "$nowfile" "$basefile"
    n_add="$(printf '%s' "$added" | grep -c . || true)"
    n_rem="$(printf '%s' "$removed" | grep -c . || true)"
    if (( n_add == 0 && n_rem == 0 )); then
        printf '  %-14s %s\n' "tree vs round" "same set of uncommitted files as when the round started"
        return 0
    fi
    printf '  %-14s %s\n' "tree vs round" "$n_rem file(s) LEFT the uncommitted set, $n_add joined it"
    if (( n_rem > 0 )); then
        printf '  %-14s %s\n' "" "${Y}left (now matches HEAD -- which is not the same as restored):${N}"
        printf '%s\n' "$removed" | head -6 | sed 's/^/                 - /'
    fi
    if (( n_add > 0 )); then
        printf '%s\n' "$added" | head -6 | sed 's/^/                 + /'
    fi
}

netem_count() { tc qdisc show 2>/dev/null | grep -c netem || true; }

# How many OVS bridges exist. The only cheap way to tell an OVS fabric from a bmv2 one:
# ndtwin-lab names the tmux session `topo` for both. [Co-developed with claude code -- Adam]
#
# Prints the count and returns 0 only when it really got an answer; returns 2 and prints
# NOTHING when it could not ask. Those are different facts and used to be the same answer:
#
#     ovs_bridge_count() { sudo -n ovs-vsctl list-br 2>/dev/null | grep -c . || true; }
#
# discarded sudo's message (2>/dev/null), then sudo's exit status (the pipe hands on grep's),
# then grep's (`|| true`), and returned 0 for a permission error -- the same 0 as a machine
# with no bridges. `sudo -n ovs-vsctl` is in none of the manual's sudoers instructions, so on a
# machine installed by the book that 0 is what the guard below reads. See sudo_surface.sh.
#
# The two "there is no OVS here" cases are answered without sudo and definitively, so a machine
# that never installed OVS gets a real 0 rather than "cannot tell": a guard that can never pass
# is as useless as one that can never fire.
ovs_bridge_count() {
    command -v ovs-vsctl >/dev/null 2>&1 || { echo 0; return 0; }
    ovs_daemon_running                   || { echo 0; return 0; }
    local out
    out="$(ndt_sudo_capture ovs-vsctl list-br)" || return 2
    printf '%s\n' "$out" | grep -c . || true
}

# Is Open vSwitch running at all? Needs no privilege, so it cannot answer "maybe": with no
# ovs-vswitchd there is no bridge for ovs-vsctl to have listed. `ps -eo comm=` and an exact
# match rather than pgrep -- see trap note 2; comm truncates at 15 characters and
# `ovs-vswitchd` is 12, so the full name survives. [Co-developed with claude code -- Adam]
ovs_daemon_running() {
    local c
    while read -r c; do [[ "$c" == "ovs-vswitchd" ]] && return 0; done < <(ps -eo comm= 2>/dev/null)
    return 1
}

# guard_no_live_ovs -- `ndt up p4` must not build a bmv2 fabric on top of a live OVS one.
#   0 clear to proceed, 1 stop.
#
# 🔴 Three inputs, two outcomes, and the third input is the point: "I could not tell" stops the
# bring-up. What this guard protects is irreversible -- the next two statements are topo-stop
# and topo-start, which destroy whatever fabric is there. The old guard had two inputs, so a
# refused ovs-vsctl arrived as "there is no OVS here" and the teardown went ahead in silence.
#
# It still only asks when a topo session exists, as before: bridges belonging to something else
# on the machine are not this command's business. [Co-developed with claude code -- Adam]
guard_no_live_ovs() {
    topo_session || return 0
    local n brc
    n="$(ovs_bridge_count)"; brc=$?
    if (( brc != 0 )); then
        err "cannot tell whether an OVS fabric is running under the topo session."
        err "'ndt up' runs 'topo-stop' next, which destroys whatever is there, so it stops here."
        if ndt_sudo_probe ovs-vsctl; then
            err "   ovs-vsctl is permitted but did not answer; try:  sudo -n ovs-vsctl list-br"
        else
            err "   the reason is sudo, not OVS:"
            ndt_sudo_explain ovs-vsctl | while IFS= read -r l; do err "$l"; done
        fi
        return 1
    fi
    if [[ "$n" -gt 0 ]]; then
        err "an OVS fabric is running ($n bridges) under the topo session."
        err "'ndt up' would tear it down to build a bmv2 fabric in its place."
        err "take it down first:  ndt down"
        return 1
    fi
    return 0
}

# host_pid <hN> -- pid of that Mininet host's namespace, empty if it is not there.
#
# The tag is assembled at run time and only ever lives in a variable, never in a child's
# argv: `mn -c` kills by command line and matches this exact string (see trap note 1).
host_pid() {
    local tag="mininet" pid args
    tag="${tag}:$1"
    while read -r pid args; do
        [[ "${args##* }" == "$tag" ]] && { echo "$pid"; return 0; }
    done < <(ps -eo pid=,args= 2>/dev/null)
    return 1
}

# dataplane_ok <hN> <dst-ip> -- 0 forwards, 1 does not, 2 could not be tested.
#
# The only assertion in this script that moves a packet, and it exists because the checks
# either side of it structurally cannot: on 2026-08-21 `ndt up ovs4` produced a fabric where
# the kernel's graph, Ryu's topology view and "model matches fabric" were all correct and
# every host pair was 100% loss, because Ryu had computed its routes for a different number
# of hosts. Topology views agreeing is not forwarding working.
#
# `mnexec -a <pid>` rather than `mn` or `ip netns exec`: the hosts belong to a Mininet started
# in a root tmux session, and mnexec is the form THIS machine's sudoers allows without a
# password. That last clause was written from `sudo -n -l` on this laptop and is not true of a
# machine installed from the manual, which grants ndtwin-lab and nothing else.
# [Co-developed with claude code -- Adam]
#
# 🔴 The permission question is asked SEPARATELY from the forwarding question, and first.
# `ping` exits non-zero when the packets are lost, and `sudo` exits non-zero when it refuses --
# the old body could not tell those apart, so a machine without the mnexec grant was told
# `h1 cannot reach 10.0.0.2 -- fabric is up but not forwarding`: a specific claim about the
# network, manufactured from a permission error, and the one the manual's own instructions
# produce (sudo_surface.sh explains why mnexec is not in them).
#
# `mnexec -a <pid> true` enters the namespace and moves no packets, so its failure is about
# sudo or about the namespace and never about the data plane. Once it has succeeded, a failing
# ping is the data plane, and rc 1 means what it says.
# NDT_DATAPLANE_WHY carries the reason for a 2 so the caller can print which kind it was.
NDT_DATAPLANE_WHY=""
dataplane_ok() {
    NDT_DATAPLANE_WHY="no namespace for $1"
    local pid; pid="$(host_pid "$1")" || return 2
    [[ -n "$pid" ]] || return 2
    if ! ndt_sudo_capture mnexec -a "$pid" true >/dev/null; then
        if ndt_sudo_refused; then
            NDT_DATAPLANE_WHY="sudo refused mnexec"
        else
            NDT_DATAPLANE_WHY="mnexec could not enter $1's namespace (pid $pid): ${NDT_SUDO_STDERR:-no message}"
        fi
        return 2
    fi
    NDT_DATAPLANE_WHY=""
    sudo -n mnexec -a "$pid" ping -c 2 -W 2 -q "$2" >/dev/null 2>&1 || return 1
    return 0
}

# verify_dataplane <hN> <dst-ip> <hint> -- shared reporting for the check above.
#
# A 2 is reported as NOT TESTED and never as a verdict about the network. It does not fail the
# bring-up -- it did not before either -- but it now says which question went unanswered, and
# a missing sudo grant comes with the line that grants it instead of a shrug.
verify_dataplane() {
    dataplane_ok "$1" "$2"
    case $? in
        0) ok "data plane: $1 -> $2 forwards" ;;
        2) warn "data plane: forwarding NOT tested -- ${NDT_DATAPLANE_WHY:-reason unrecorded}"
           [[ "$NDT_DATAPLANE_WHY" == "sudo refused mnexec" ]] && ndt_sudo_explain mnexec ;;
        *) err "data plane: $1 cannot reach $2 -- fabric is up but not forwarding"
           err "   $3"
           return 1 ;;
    esac
    return 0
}

# --- sFlow: is anything actually sampling? ------------------------------------------
#
# [Co-developed with claude code -- Adam]
#
# Finding #4 (2026-09-02): `ndt up ovs4` built ten bridges with `sflow=[]` on every one of
# them, while the kernel listened on :6343 as always. Nothing anywhere said so. The API
# answered `{"avg_link_usage":0.0,"status":"success"}` through 3000 packets of real traffic,
# every per-flow rate read zero, and the bring-up printed `up. ready`. "We never asked" and
# "the network is idle" were the same output on every channel this script has.
#
# So the fix has two halves and this is the second one. The first half (sFlow in
# ovs_4host_topo.py) stops it happening; without this half the same silence returns the moment
# anything -- a hand-run topology, a half-applied merge, an OVS database that lost the record
# -- puts the fabric back the way it was, and the operator sees `up. ready` again.
#
# 🔴 What it checks is not "sflow is configured". That is satisfied by a configuration that
# reports nothing usable, and this bring-up would then still print ready. The agent address is
# what the kernel matches a sample to an edge by (FlowLinkUsageCollector.cpp `agentIp =
# data[2]` -> TopologyAndFlowMonitor::findEdgeByAgentIpAndPort against `props.srcIp.front()`),
# so a bridge whose agent interface has no IPv4 makes OVS fall back to the route source
# address -- one address shared by all ten switches, matching no edge, contributing nothing,
# and indistinguishable from the defect. Hence: the agent address of every bridge is compared
# against the address the kernel's own model file declares for that switch.

# The kernel's sFlow collector port. Declared here because `ndt` does not source
# components.env; ports.sh's 6343 row is the same number with the consequence attached, and
# ovs_4host_topo.py's SFLOW_COLLECTOR_PORT is the third. tests/python/test_ovs4_sflow.py
# asserts all three agree, so a change to one of them cannot leave the others lying.
SFLOW_PORT=6343

# iface_ipv4 <iface> -- its first IPv4 address, empty when it has none. Unprivileged: reading
# an address needs no root, so this cannot answer "maybe" and does not go through sudo.
iface_ipv4() {
    ip -4 -o addr show dev "$1" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1
}

# local_ipv4s -- every IPv4 address on this machine, one per line. What "a target the kernel
# could actually receive on" means, given the collector binds 0.0.0.0.
local_ipv4s() {
    ip -4 -o addr show 2>/dev/null | awk '{print $4}' | cut -d/ -f1
}

# model_agent_ips <topology-file> -- "bridge ip" per switch, from the kernel's own model.
model_agent_ips() {
    python3 - "$1" <<'PY' 2>/dev/null
import json, sys
t = json.load(open(sys.argv[1]))
for n in t["nodes"]:
    if n.get("vertex_type") != 0:
        continue
    ips = n.get("ip") or []
    print(n.get("bridge_name") or n.get("device_name"), ips[0] if ips else "")
PY
}

# sflow_query <columns> <table> -- one ovs-vsctl read, answer in NDT_SFLOW_ROWS. rc 0 answered,
# 2 could not ask.
#
# 🔴 The answer comes back in a GLOBAL and the output goes through a temp file, rather than the
# obvious `rows="$(sflow_query ...)"`. A command substitution runs its body in a subshell, and
# ndt_sudo_capture's whole contribution -- NDT_SUDO_STDERR, which is what ndt_sudo_refused
# reads -- dies with that subshell. Written the obvious way this function returned the right
# exit status and then reported every refusal as "ovs-vsctl did not answer: no message", i.e.
# it could no longer tell sudo from ovsdb: the same collapse of two causes into one message
# that sudo_surface.sh exists to prevent. Caught by tests/shell/test_ovs4_sflow_verify.sh.
NDT_SFLOW_ROWS=""
sflow_query() {
    local tmp rc
    NDT_SFLOW_ROWS=""
    tmp="$(mktemp "${TMPDIR:-/tmp}/ndt-sflow-XXXXXX")" || return 2
    ndt_sudo_capture ovs-vsctl --format=csv --no-headings --data=bare \
        --columns="$1" list "$2" >"$tmp"
    rc=$?
    NDT_SFLOW_ROWS="$(cat "$tmp" 2>/dev/null)"
    rm -f "$tmp"
    (( rc == 0 )) || return 2
    return 0
}

# sflow_why -- how to word a 2, taking the verdict from the exit status that already decided it
# and only the wording from stderr. Same division of labour as ndt_sudo_explain's callers.
sflow_why() {
    if ndt_sudo_refused; then
        echo "sudo refused ovs-vsctl"
    else
        echo "ovs-vsctl did not answer: ${NDT_SUDO_STDERR:-no message}"
    fi
}

# sflow_state <topology-file> -- 0 every bridge samples to the kernel, 1 at least one does
# not, 2 the question could not be asked. Findings land in NDT_SFLOW_PROBLEMS, the one-line
# summary in NDT_SFLOW_SUMMARY, the reason for a 2 in NDT_SFLOW_WHY.
#
# 2 is a third state on purpose, for the reason ovs_bridge_count has one: a refused ovs-vsctl
# that arrived as "no sflow rows" would print exactly the red this function exists to print,
# and the operator would go looking at the topology script instead of at sudoers.
NDT_SFLOW_PROBLEMS=()
NDT_SFLOW_SUMMARY=""
NDT_SFLOW_WHY=""
sflow_state() {
    NDT_SFLOW_PROBLEMS=(); NDT_SFLOW_SUMMARY=""; NDT_SFLOW_WHY=""
    local topo="$1"

    local bridges records
    sflow_query name,sflow bridge || { NDT_SFLOW_WHY="$(sflow_why)"; return 2; }
    bridges="$NDT_SFLOW_ROWS"
    sflow_query _uuid,agent,targets sflow || { NDT_SFLOW_WHY="$(sflow_why)"; return 2; }
    records="$NDT_SFLOW_ROWS"

    local -a names=()
    local line name rest
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        names+=("${line%%,*}")
    done <<<"$bridges"
    if [[ "${#names[@]}" -eq 0 ]]; then
        NDT_SFLOW_WHY="ovs-vsctl answered, but listed no bridges at all"
        return 2
    fi

    # -- the records, keyed by uuid: agent interface and target --
    local -A rec_agent=() rec_target=()
    local uuid agent target
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        uuid="${line%%,*}"; rest="${line#*,}"
        agent="${rest%%,*}"; target="${rest#*,}"
        rec_agent["$uuid"]="$agent"
        rec_target["$uuid"]="$target"
    done <<<"$records"

    # -- what the kernel's model says each switch's agent address must be --
    local -A want_ip=()
    local b ip
    while read -r b ip; do
        [[ -n "$b" ]] && want_ip["$b"]="$ip"
    done < <(model_agent_ips "$topo")

    local locals; locals="$(local_ipv4s)"

    local configured=0 refs u n_refs host port actual
    for name in "${names[@]}"; do
        rest="$(grep -m1 "^$name," <<<"$bridges")"; rest="${rest#*,}"
        # A bridge's sflow column is a SET. Zero members is the defect; more than one is the
        # loosening shape -- a second `create sflow` leaves the first record unreferenced and
        # a checker that only asks "is it non-empty" signs both off.
        refs="$(grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' <<<"$rest")"
        n_refs="$(printf '%s' "$refs" | grep -c . || true)"
        if [[ "$n_refs" -eq 0 ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: no sFlow record -- this bridge samples nothing, and every rate and utilisation it contributes to reads zero")
            continue
        fi
        if [[ "$n_refs" -gt 1 ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: $n_refs sFlow records referenced -- a bridge samples to one; the extras are a configuration applied twice")
            continue
        fi
        configured=$((configured+1))
        u="$refs"

        # -- the target has to be somewhere the kernel's collector actually receives --
        target="${rec_target[$u]:-}"
        host="${target%:*}"; port="${target##*:}"
        if [[ "$port" != "$SFLOW_PORT" ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: sFlow target is '$target' -- the kernel's collector is on :$SFLOW_PORT, so these datagrams go nowhere it is listening")
        elif ! grep -qx -- "$host" <<<"$locals"; then
            NDT_SFLOW_PROBLEMS+=("$name: sFlow target '$target' is not an address on this machine -- the collector binds 0.0.0.0:$SFLOW_PORT here, so nothing will arrive")
        fi

        # -- the agent address is the one the kernel matches samples to edges by --
        agent="${rec_agent[$u]:-}"
        if [[ -z "$agent" ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: sFlow record names no agent interface -- OVS then reports the route source address, the same one for every switch, and the kernel matches the samples to no edge")
            continue
        fi
        actual="$(iface_ipv4 "$agent")"
        if [[ -z "$actual" ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: sFlow agent '$agent' has no IPv4 address -- OVS falls back to the route source address, identical for all $SWITCHES bridges, and the kernel matches the samples to no edge")
        elif [[ -n "${want_ip[$name]:-}" && "$actual" != "${want_ip[$name]}" ]]; then
            NDT_SFLOW_PROBLEMS+=("$name: sFlow agent address is $actual, the model file says ${want_ip[$name]} -- samples arrive and match no edge, which reads exactly like no samples at all")
        fi
    done

    # An sFlow record nothing points at is what a second `create` leaves behind. Counted
    # separately from the per-bridge check because the per-bridge check cannot see it.
    #
    # 🔴 And the two directions of the mismatch get DIFFERENT sentences. Written as one line it
    # said "a record referenced by no bridge is a configuration that ran twice" for a database
    # holding zero records against ten bridges -- sending the reader to look for a phantom
    # extra record when the per-bridge lines above had already said the opposite. A message
    # produced from the wrong branch of the condition it is reporting on.
    local n_records; n_records="$(printf '%s\n' "$records" | grep -c . || true)"
    if [[ "$n_records" -gt "${#names[@]}" ]]; then
        NDT_SFLOW_PROBLEMS+=("the OVS database holds $n_records sFlow records for ${#names[@]} bridges -- a record no bridge references is a configuration that ran twice, or one applied to a bridge that does not exist")
    elif [[ "$n_records" -lt "${#names[@]}" ]]; then
        NDT_SFLOW_PROBLEMS+=("the OVS database holds $n_records sFlow records for ${#names[@]} bridges -- the bridges named above have none")
    fi

    NDT_SFLOW_SUMMARY="$configured/${#names[@]} bridges sampling to :$SFLOW_PORT, $n_records records"
    [[ "${#NDT_SFLOW_PROBLEMS[@]}" -eq 0 ]] && return 0
    return 1
}

# verify_sflow <topology-file> -- shared reporting. Red when a bridge is not sampling; a
# refusal is reported as NOT TESTED with the sudoers line, never as a verdict about telemetry.
verify_sflow() {
    local p
    sflow_state "$1"
    case $? in
        0) ok "sFlow: $NDT_SFLOW_SUMMARY" ;;
        2) warn "sFlow: NOT tested -- ${NDT_SFLOW_WHY:-reason unrecorded}"
           warn "   until it is, a zero from get_average_link_usage means nothing either way"
           [[ "$NDT_SFLOW_WHY" == "sudo refused ovs-vsctl" ]] && ndt_sudo_explain ovs-vsctl ;;
        *) err "sFlow: telemetry is not wired -- ${NDT_SFLOW_SUMMARY:-no bridge sampling}"
           for p in "${NDT_SFLOW_PROBLEMS[@]}"; do err "   $p"; done
           err "   the kernel will answer get_average_link_usage with 0.0 and status success,"
           err "   which is the same answer it gives for an idle network. Fix this before measuring."
           return 1 ;;
    esac
    return 0
}

# --- status -----------------------------------------------------------------------

# check_up_target <graph_hosts> <graph_edges> -- compare the running lab against the baseline
# the last `ndt up` recorded. Empty arguments mean the kernel gave no graph.
#
# [Co-developed with claude code -- Adam]
# Prints one row per field, live value beside recorded value, so the reader can see WHAT was
# compared and not merely the verdict -- the old check printed a single sentence ("the kernel
# graph does not match the topology file") that named neither the file nor the field.
#
# Fills UP_TARGET_PROBLEMS with one sentence per differing field, each naming that field.
#   rc 0  every field compared and matched
#   rc 1  at least one field differs, or could not be read (unobtainable is RED, never green)
#   rc 3  there is no record: NOT CHECKED. Never reported as a match, and never as a mismatch.
check_up_target() {
    local g_hosts="${1:-}" g_edges="${2:-}"
    UP_TARGET_PROBLEMS=()
    local f; f="$(up_target_file)"

    say "up target"
    if [[ ! -f "$f" ]]; then
        # 09-05 R7 I-1 (W12). The tense, not the exit code. "no 'ndt up' has run in this
        # checkout" is a statement about history and is false after every ordinary up->down;
        # what is true is that there is no baseline RIGHT NOW. rc 3 and the COULD NOT CHECK
        # block below are unchanged -- they were already the honest part. See kernel_exit_file.
        local kx_at kx_plane
        kx_at="$(kernel_exit_field at)"; kx_plane="$(last_kernel_plane)"
        if [[ -n "$kx_at" ]]; then
            printf '  %-14s %s\n' "record" "${Y}none -- the last 'ndt up' record was cleared by 'ndt down' at $kx_at; history is in .test_run/pids/*.exit${N}  (${f#$REPO/})"
            if [[ -n "$kx_plane" ]]; then
                printf '  %-14s %s\n' "" "that run was $kx_plane, per the --topology argument in .test_run/pids/kernel.exit -- NOT a baseline, just what ran"
            fi
        else
            printf '  %-14s %s\n' "record" "${Y}none -- nothing is being asked for right now, and there is no .test_run/pids/kernel.exit to say what ran before${N}  (${f#$REPO/})"
        fi
        printf '  %-14s %s\n' "" "there is no baseline, so --check did NOT check. this is not 'checked and matched'."
        printf '  %-14s %s\n' "" "bring the lab up from this checkout first:  ndt up <target>"
        printf '  %-14s %s\n' "" ".test_run/ is per checkout, so another checkout's 'up' is invisible here (finding #79)"
        return 3
    fi
    local plane hosts topo sum m_hosts m_edges at by
    plane="$(up_target_field plane)";       hosts="$(up_target_field hosts)"
    topo="$(up_target_field topology)";     sum="$(up_target_field topology_sha256)"
    m_hosts="$(up_target_field model_hosts)"; m_edges="$(up_target_field model_edges)"
    at="$(up_target_field at)";             by="$(up_target_field by)"
    if [[ -z "$plane" || -z "$hosts" || -z "$topo" ]]; then
        printf '  %-14s %s\n' "record" "${Y}unreadable -- ${f#$REPO/} has no plane/hosts/topology${N}"
        printf '  %-14s %s\n' "" "--check did NOT check. delete it and run 'ndt up' again."
        return 3   # a record nobody can read is the same answer as no record: nothing compared
    fi

    local when="$at"
    [[ "$at" =~ ^[0-9]+$ ]] && when="$(date -d "@$at" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$at")"
    printf '  %-14s %s\n' "asked for" "$plane, $hosts hosts   (recorded $when by ${by:-?})"
    printf '  %-14s %s\n' "topology" "$topo   (declares ${m_hosts:-?} hosts / ${m_edges:-?} edges)"

    local bad=0
    # row <field> <live> <want> -- print the comparison and record the difference by NAME.
    # Printing a comparison and reporting a difference are two acts, and only the second one
    # is the check. They are separate functions so that a gate can delete the second and leave
    # a report that still looks exactly like a working comparison. [Co-developed with claude code -- Adam]
    _ut_differs() {
        UP_TARGET_PROBLEMS+=("$1: the lab has '$2', the last 'ndt up' asked for '$3'")
        bad=1
    }
    _ut_row() {
        local field="$1" live="$2" want="$3"
        if [[ "$live" == "$want" ]]; then
            printf '  %-14s %-22s %s\n' "$field" "$live" "== $want   ok"
        else
            printf '  %-14s %-22s %s\n' "$field" "${R}$live${N}" "${R}!= $want   MISMATCH${N}"
            _ut_differs "$field" "$live" "$want"
        fi
    }
    # unreadable <field> <why> -- a question that could not be asked is a failure, not a pass.
    _ut_unreadable() {
        printf '  %-14s %s\n' "$1" "${R}$2 -- NOT COMPARED${N}"
        UP_TARGET_PROBLEMS+=("$1: could not be compared against the 'ndt up' target ($2)")
        bad=1
    }
    # [Co-developed with claude code -- Adam]
    # overlay <path> -- NAMED, AND DELIBERATELY NOT COMPARED. Never touches `bad`.
    #
    # 🔴 The row exists so that "the overlay is not part of the sha256" is something the reader
    # can SEE rather than infer from a silence, and so that a change which quietly folds it back
    # in has something to fail. Until 2026-09-06 the kernel wrote nicknames into the model file
    # itself, so an operator who did nothing worse than give a switch a friendly name turned row
    # 5 red -- and the red read "the topology file has been edited since the ndt up that loaded
    # it", which was true, useless, and indistinguishable from the edit row 5 is FOR (measured
    # live on OVS 2026-09-05; renaming and renaming back went green again, so the file's bytes
    # were the whole of it). W10 moved those names to .test_run/nickname_overlay/, outside
    # setting/, and this check keeps its baseline where it was: the model file `ndt up` loaded.
    # 🔴 "no overlay file", NOT "none set". Measured live 2026-09-06 07:15: this row said
    # `none set through the API` three times on a fabric where a nickname HAD been set through
    # the API and had just survived a down/up -- the kernel was writing to
    # <checkout>/build/.test_run/ (its cwd is build/) and this read <checkout>/.test_run/.
    # The kernel side is fixed, and so is the WORDING, because the two failures are different:
    # one was a path bug, the other is this row claiming to know something it cannot see. A
    # missing file is a fact about the check, not about the world.
    _ut_overlay_row() {
        local f="$1" n
        if [[ ! -f "$f" ]]; then
            printf '  %-14s %s\n' "device names" "no overlay file at ${f#$REPO/}"
            printf '  %-14s %s\n' "" "that is where this checkout's kernel writes them; not a claim that none are set"
            return 0
        fi
        n="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
print(len(d.get("switches",{})) + len(d.get("hosts",{})))' "$f" 2>/dev/null)"
        printf '  %-14s %-22s %s\n' "device names" "${n:-?} set through the API" \
            "not compared -- the model file is the baseline"
        printf '  %-14s %s\n' "" "${f#$REPO/}"
        return 0
    }

    # 1. the data plane. The field whose absence made this check useless on OVS: (hosts, edges)
    #    is (4, 40) for both the P4 and the OVS 4-host model, so without this row a bmv2 fabric
    #    passes as the OVS fabric that was asked for, and vice versa.
    local kind; kind="$(live_dataplane_kind)"
    case "$kind" in
        unknown) _ut_unreadable "dataplane" "cannot tell (ovs-vsctl refused; see the sudo grants block)" ;;
        *)       _ut_row "dataplane" "$kind" "$plane" ;;
    esac

    # 2. the fabric itself, counted out of ps -- the only side of this that is not the model
    #    talking about the model. 0 means the reading failed, and a failed reading is red
    #    (same rule as the model/fabric assertion in verify_p4).
    local live_hosts; live_hosts="$(fabric_host_count)"
    if [[ ! "$live_hosts" =~ ^[0-9]+$ ]] || [[ "$live_hosts" -eq 0 ]]; then
        _ut_unreadable "fabric hosts" "no host namespaces found (fabric_host_count gave '${live_hosts:-<empty>}')"
    else
        _ut_row "fabric hosts" "$live_hosts" "$hosts"
    fi

    # 3+4. the kernel's own graph, through the north-bound API, as before.
    if [[ -z "$g_hosts" || -z "$g_edges" ]]; then
        _ut_unreadable "kernel graph" "the kernel gave no graph on :8000"
    else
        _ut_row "graph hosts" "$g_hosts" "$hosts"
        _ut_row "graph edges" "$g_edges" "${m_edges:-?}"
    fi

    # 5. is the model file still the file that was loaded? An edit under a running kernel is
    #    invisible in every count above, because the kernel pulled once at startup.
    local path="$REPO/$topo" now
    # [Co-developed with claude code -- Adam]
    # W10. Where the kernel keeps the names an operator set, derived the same way the kernel
    # derives it: one overlay per model file, named after that model, under .test_run/. It is
    # worked out HERE, right beside the sha256 that is about to be taken, because the
    # relationship between the two is the decision -- this path is reported in row 6 and is not
    # an input to row 5.
    local overlay="$REPO/.test_run/nickname_overlay/$(basename "${topo%.json}").names.json"
    if [[ ! -f "$path" ]]; then
        _ut_unreadable "topology file" "$topo is gone"
    elif [[ ! "$sum" =~ ^[0-9a-f]{64}$ ]]; then
        _ut_unreadable "topology file" "no sha256 was recorded at 'up' time"
    else
        now="$(sha256sum "$path" 2>/dev/null | cut -d' ' -f1)"
        if [[ "$now" == "$sum" ]]; then
            printf '  %-14s %-22s %s\n' "topology file" "sha256 ${sum:0:12}" "== recorded   ok"
        else
            printf '  %-14s %-22s %s\n' "topology file" "${R}sha256 ${now:0:12}${N}" "${R}!= ${sum:0:12}   CHANGED SINCE up${N}"
            UP_TARGET_PROBLEMS+=("topology file: $topo has been edited since the ndt up that loaded it; the kernel pulls once and never retries")
            bad=1
        fi
    fi

    # 6. the names an operator set through the API. Named, never compared -- see _ut_overlay_row.
    _ut_overlay_row "$overlay"

    unset -f _ut_row _ut_unreadable _ut_differs _ut_overlay_row
    return "$bad"
}

# app_package_row -- the `app package` line in the configuration block, and the problems it
# raises. [Co-developed with claude code -- Adam]
#
# It sits in `configuration` and not in `running` deliberately: like the P4 host knob two rows
# up, this file is not a description of what is running -- it is what the NEXT `ndt up p4` and
# the next proxy will read. A proxy started before the knob changed is serving the old package
# and this row cannot see that; it says what the file says.
#
# 🔴 THREE BAD STATES, NAMED SEPARATELY, and all three are `--check` problems:
#   * the knob names a directory that is not there -- the proxy raises at import and the
#     bring-up dies at `[2/3] proxy did not open :8081`;
#   * the knob exists with no directive line -- app_package.read_knob refuses that outright
#     (P1-A §4-3), so it is a half-finished write, not a default;
#   * the directory is there but carries no readable package.json -- same import failure, a
#     different cause, and rendering it as "mode ndtwin" because that is the default would be
#     the silent substitution this whole feature exists to remove.
# `none` is not a problem and never colours: it is what every baseline lab reads.
STATUS_APP_PROBLEMS=()
app_package_row() {
    local rel="p4_proxy/mininet/app_package_override"
    local state mode name
    STATUS_APP_PROBLEMS=()
    state="$(app_knob_state)"
    case "$state" in
        absent)
            printf '  %-14s %s\n' "app package" "none   ($rel absent -- the baseline fabric)"
            return 0 ;;
        empty)
            printf '  %-14s %s\n' "app package" "${Y}$rel exists and names no package${N}"
            printf '  %-14s %s\n' "" "the proxy REFUSES to start on that file; delete it:  rm $rel"
            STATUS_APP_PROBLEMS+=("the app package knob ($rel) exists but names no package directory -- the proxy refuses to start on it; delete the file")
            return 0 ;;
    esac
    if [[ ! -d "$state" ]]; then
        printf '  %-14s %s\n' "app package" "${Y}$state -- THE DIRECTORY IS NOT THERE${N}"
        printf '  %-14s %s\n' "" "the proxy raises at import and 'ndt up p4' dies at [2/3]. delete it:  rm $rel"
        STATUS_APP_PROBLEMS+=("the app package knob ($rel) names $state, which does not exist -- the next 'ndt up p4' cannot start its proxy")
        return 0
    fi
    mode="$(app_package_mode "$state")"
    name="$(app_package_name "$state")"
    if [[ -z "$mode" ]]; then
        printf '  %-14s %s\n' "app package" "${Y}$state (package.json UNREADABLE -- no control-plane mode)${N}"
        STATUS_APP_PROBLEMS+=("the app package at $state has no readable package.json control_plane.mode -- the proxy cannot start on it")
        return 0
    fi
    printf '  %-14s %s\n' "app package" "$state (mode $mode)"
    printf '  %-14s %s\n' "" "${name:+$name -- }$rel; it decides the next 'ndt up p4' and the next proxy"
    return 0
}

cmd_status() {
    local check="" ; [[ "${1:-}" == "--check" ]] && check=1
    local hosts topo rate n problems=()
    # p4_proxy/mininet/host_count_override, and the P4 model that goes with it. This pair used
    # to be presented as "the configuration" of whatever is running, which is finding #8: it is
    # a P4-ONLY knob, `ndt up ovs4` never writes it, and on a 4-host OVS fabric it reported
    # `hosts 128` and the P4 128-host model file. Kept, because it really does decide the next
    # `ndt up p4`, but printed as what it is and NOT as a description of the running lab. What
    # the running lab was asked to be comes from the up-target record below.
    hosts="$(host_count)"
    topo="$(topo_for_hosts "$hosts" p4)"
    # D-2 / X-2: the plane is decided ONCE, here, and the sampling rate is read from it. Until
    # 09-06 this line was `rate="$(sample_rate)"` and sample_rate could only read the compiled
    # bmv2 artefact, so on an OVS fabric `status` printed a number belonging to a plane that was
    # not running. [Co-developed with claude code -- Adam]
    local plane_now; plane_now="$(live_dataplane_kind)"
    rate="$(sample_rate "$plane_now")"
    # The recorded target, when there is one -- it is what the "hosts" line should say.
    local ut_plane ut_hosts ut_topo
    ut_plane="$(up_target_field plane)"; ut_hosts="$(up_target_field hosts)"
    ut_topo="$(up_target_field topology)"

    # -- who has the machine, and what code is this --
    say "lab"
    local cl; cl="$(claim_line)"
    printf '  %-14s %s\n' "claim" "$cl"
    case "$cl" in
        none|EXPIRED*|malformed*|yours*) ;;
        *) problems+=("the lab is claimed by someone else") ;;
    esac
    local note; note="$(claim_field note)"
    [[ -n "$note" && "$cl" != none && "$cl" != EXPIRED* ]] && printf '  %-14s %s\n' "note" "$note"
    # R7 I-2 condition 2: the claim's own history, beside the claim. Not behind --check and not
    # behind "a claim is live" -- see claim_prev_row for whose question this is.
    claim_prev_row

    # [Co-developed with claude code -- Adam]
    # Printed UNCONDITIONALLY while a claim is live, and never behind a flag. The whole point of
    # this line is to be seen by someone who was not looking for it -- a session about to start a
    # VM or a compile, who has no reason to suspect a measurement is running. A field that only
    # appears when you ask for it protects nobody.
    #
    # Declared AND actual, side by side. The declaration alone would repeat the failure it exists
    # to prevent: on 2026-08-28 the claim was correct, honoured by everyone who read it, and the
    # machine was still at load 30 because the contention came from something the claim did not
    # describe. Showing load1 next to the declaration turns "I promised" into "and here is
    # whether it held".
    if [[ "$cl" != none && "$cl" != EXPIRED* ]]; then
        local excl l1 ncpu
        excl="$(claim_field exclusive_cpu)"; excl="${excl:-no}"
        l1="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"
        ncpu="$(nproc 2>/dev/null || echo 1)"
        if [[ "$excl" == yes ]]; then
            # Threshold on load1 rather than CPU%: CPU occupancy saturates at 1.0, so once the
            # machine is full it cannot report how full. load1 has no ceiling. Choosing the
            # bounded quantity here is the mistake this line was written in response to.
            if awk "BEGIN{exit !($l1 > $ncpu * 1.5)}" 2>/dev/null; then
                printf '  %-14s %s\n' "exclusive cpu" \
                    "${R:-}yes -- but load1 is $l1 on $ncpu cores, so it is NOT holding${N:-}"
                problems+=("a measurement claimed exclusive CPU, but load1 is $l1 on $ncpu cores")
            else
                printf '  %-14s %s\n' "exclusive cpu" "yes (load1 $l1 on $ncpu cores -- holding)"
            fi
            printf '  %-14s %s\n' "" "🔴 do not start a VM, a compile, or any heavy local job"
        else
            printf '  %-14s %s\n' "exclusive cpu" "no (heavy local jobs may overlap this claim)"
        fi
    fi

    # Only when nobody holds the lab. While a claim is live the claim IS the answer, and a
    # stale handoff line beside it would be two voices on the same question.
    if [[ -f "$HANDOFF" && ( "$cl" == none || "$cl" == EXPIRED* ) ]]; then
        local h_by h_at h_fab h_topo h_note
        h_by="$(handoff_field by)"; h_at="$(handoff_field at)"
        h_fab="$(handoff_field fabric)"; h_topo="$(handoff_field topology)"
        h_note="$(handoff_field note)"
        printf '  %-14s %s\n' "handoff" \
            "left by ${h_by:-?} at ${h_at:-?}${h_fab:+ -- fabric $h_fab}${h_topo:+ ($h_topo)}"
        [[ -n "$h_note" ]] && printf '  %-14s %s\n' "" "$h_note"
        printf '  %-14s %s\n' "" "no claim: the lab is free, this fabric included -- tear it down if you want"
    fi

    # Declared beside observed, the same pairing the exclusive-cpu row above uses and for the
    # same reason: a declaration nobody checks against reality is a promise, and reality with no
    # declaration beside it cannot say what it is FOR. This row is what `ndt check` refuses on
    # (R4-2); the rows below it are what `up` and `down` refuse on. They answer different
    # questions and are printed as two rows so they cannot be read as one.
    local declared; declared="$(measuring_declared)"
    [[ -n "$declared" ]] && printf '  %-14s %s\n' "declared" \
        "$(printf '%s' "$declared" | cut -c1-64)   (claim measuring=; 'ndt check' refuses while set)"

    local busy; busy="$(in_flight)"
    if [[ -n "$busy" ]]; then
        local extra; extra="$(printf '%s\n' "$busy" | wc -l)"
        # A measurement process cannot be measuring a fabric that does not exist. iperf3 can
        # outlive the fabric it was driving -- a client whose control channel never completes
        # just sits there, and one was found still running 32 hours after its fabric was torn
        # down (review session, 2026-08-23). Reporting that as "measuring" tells every reader,
        # human and cross-session, that the lab is busy when it is merely dirty, and the
        # advice attached to it ("wait for it") is then exactly wrong: waiting never ends.
        #
        # No timestamps needed -- the absence of a fabric is a stronger statement than any
        # age comparison. [Co-developed with claude code -- Adam]
        if [[ "$(mn_count)" -eq 0 ]]; then
            printf '  %-14s %s\n' "orphaned" "$(printf '%s' "$busy" | head -1 | cut -c1-64)"
            (( extra > 1 )) && printf '  %-14s %s\n' "" "+ $(( extra - 1 )) more process(es)"
            printf '  %-14s %s\n' "" "no fabric is running, so these are leftovers, not a measurement"
            problems+=("orphaned measurement processes with no fabric -- 'ndt clean' reaps them")
        else
            printf '  %-14s %s\n' "measuring" "$(printf '%s' "$busy" | head -1 | cut -c1-72)"
            (( extra > 1 )) && printf '  %-14s %s\n' "" "+ $(( extra - 1 )) more process(es)"
            problems+=("a measurement is in flight")
        fi
    else
        printf '  %-14s %s\n' "measuring" "nothing"
    fi
    git_lines
    # [Co-developed with claude code -- Adam]
    # E-9, Adam's decision 09-07 (grill §4E round 3). knob_row fills this while git_lines runs;
    # merging it here rather than inside knob_row keeps the row a printer and this function the
    # only place that decides what `--check` exits on. Unconditional, unlike the residue merge
    # below: nothing here costs a POST, and `problems` is only ever printed under --check.
    (( ${#STATUS_KNOB_PROBLEMS[@]} > 0 )) && problems+=("${STATUS_KNOB_PROBLEMS[@]}")
    # [Co-developed with claude code -- Adam]
    # FINDING #83, beside the `code` line and for the same reason: `code` answers "what is this
    # checkout", and until now nothing answered "and is that the code `ndt up` actually runs".
    # It is not, on this machine -- $LAB is a root-owned copy that has been five commits behind
    # since 08-30, and every live arm any branch has reported through `ndt up` since then was
    # measuring it. Printed unconditionally, including when the two agree, because "they agree"
    # is the fact a reader of a live measurement needs and cannot otherwise get.
    lab_version_report
    local labprob; labprob="$(lab_version_problem)"
    [[ -n "$labprob" ]] && problems+=("$labprob")
    echo

    # -- the state that decides every number --
    say "configuration"
    if [[ -n "$ut_plane" && -n "$ut_hosts" ]]; then
        printf '  %-14s %s\n' "hosts" "$ut_hosts   (what the last 'ndt up' asked for: $ut_plane)"
        printf '  %-14s %s\n' "topology" "${ut_topo:-?}"
        printf '  %-14s %s\n' "p4 host knob" "$hosts   (p4_proxy/mininet/host_count_override -- P4 only; decides the next 'ndt up p4')"
    else
        # 09-05 R7 I-1 (W12), the half that changed the PLANE. With no record this branch used
        # to print the P4 model the P4-only knob selects on the `topology` row, and a reader --
        # R0's script among them -- took it for the plane that had just been running. The
        # question "which plane" has no answer here, so the row says so, and what the knob
        # selects moves to its own row named for what it decides (the next `ndt up p4`), which
        # is exactly how the has-a-record branch above already labels it.
        local kx_plane kx_at
        kx_plane="$(last_kernel_plane)"; kx_at="$(kernel_exit_field at)"
        printf '  %-14s %s\n' "hosts" "unknown (no up.target) -- nothing here records what the running fabric was asked for"
        if [[ -n "$kx_plane" ]]; then
            printf '  %-14s %s\n' "topology" "unknown (no up.target); last kernel.exit ran $kx_plane"
        elif [[ -n "$kx_at" ]]; then
            printf '  %-14s %s\n' "topology" "unknown (no up.target); last kernel.exit is from $kx_at and names no model this script can classify"
        else
            printf '  %-14s %s\n' "topology" "unknown (no up.target); no kernel.exit either -- this checkout cannot say what ran"
        fi
        # 🔴 The knob's MODEL PATH is deliberately not printed here. It was the concrete carrier
        # of the harm: with no record this row used to hold setting/StaticNetworkTopologyP4_*,
        # the first setting/*.json in the whole report, and it was read -- by a person and by a
        # script -- as the plane that had just run. The knob's own number is kept, on a row that
        # names what it decides, which is what the has-a-record branch above already does.
        printf '  %-14s %s\n' "p4 host knob" "$hosts   (p4_proxy/mininet/host_count_override -- P4 only; decides the next 'ndt up p4')"
    fi
    app_package_row
    (( ${#STATUS_APP_PROBLEMS[@]} > 0 )) && problems+=("${STATUS_APP_PROBLEMS[@]}")
    printf '  %-14s %s\n' "bmv2" "$(bmv2_binary)"
    # 🔴 The source is printed on its own row, unconditionally, beside the number. X-2 survived
    # because the row said `1/256` and never said where 256 came from; on the OVS plane it came
    # out of a bmv2 build artefact nothing on that fabric loads, and the two agreed by
    # coincidence. A provenance that only appears when it is surprising is one nobody has a
    # baseline for. [Co-developed with claude code -- Adam]
    if [[ "$plane_now" != ovs ]] && stale_pipeline; then
        printf '  %-14s %s   %s\n' "sample rate" "$(rate_label "$rate")" "${Y}<- from the BUILT json; the running switches predate it${N}"
        problems+=("the fabric predates the current build of ndtwin_switch.json")
    else
        printf '  %-14s %s\n' "sample rate" "$(rate_label "$rate")"
    fi
    printf '  %-14s %s\n' "rate source" "$(rate_source "$plane_now")"
    # [Co-developed with claude code -- Adam] the two lies `status` could not see before 09-02,
    # and the three the OVS side can tell (D-2): a fabric with no sflow record samples nothing,
    # ten records that disagree have no single rate, and a refused ovs-vsctl is not a default.
    case "$rate" in
        DISABLED:lo=*)  problems+=("the compiled pipeline samples nothing (rng lower bound above 0) -- restore + recompile") ;;
        OVS-NOSFLOW)    problems+=("no sFlow record exists on any OVS bridge -- nothing on this fabric is sampled, so every bandwidth number is 0") ;;
        OVS-DISAGREE:*) problems+=("the OVS sflow records disagree (${rate#OVS-DISAGREE:}) -- this fabric has no single sampling rate") ;;
        UNREADABLE:*)   problems+=("the sampling rate could not be read (${rate#UNREADABLE:}) -- the bandwidth numbers below have no known rate behind them") ;;
    esac
    if [[ "$plane_now" != ovs ]] && source_ahead_of_build; then
        printf '  %-14s %s\n' "pipeline" "${Y}ndtwin_switch.p4 is NEWER than build/ndtwin_switch.json -- restored source, never recompiled${N}"
        problems+=("ndtwin_switch.p4 is newer than its compiled json (restored source, never recompiled)")
    fi
    printf '  %-14s %s\n' "note" "/ndt/get_cpu_utilization is fabricated in MININET mode; use cpu_probe.py"
    echo

    # -- what is running --
    say "running"
    n="$(bmv2_count)"; printf '  %-14s %-8s' "bmv2 switches" "$n"
    printf '%-14s %s\n' "topo session" "$(topo_session && echo present || echo absent)"
    n="$(mn_count)";   printf '  %-14s %-8s' "host/switch" "$n"
    printf '%-14s %s\n' "manifest" "$( [[ -e $MANIFEST ]] && echo present || echo absent )"
    printf '  %-14s %-8s' ":8000 kernel" "$(port_open 8000 && echo open || echo closed)"
    printf '%-14s %-8s' ":8081 proxy" "$(port_open 8081 && echo open || echo closed)"
    printf '%s\n' ":8080 ryu $(port_open 8080 && echo open || echo closed)"
    local running
    running="$(ps -eo args= 2>/dev/null | grep -o '/[^ ]*simple_switch_grpc' | sort -u | head -1)"
    [[ -n "$running" ]] && printf '  %-14s %s\n' "binary" "$running"
    # R7 I-3. Printed unconditionally rather than under --check, for the same reason the
    # exclusive_cpu row is: the ports above are read from the machine and these files are read
    # from disk, and "the ports are shut" plus "the registry still names two live processes" is
    # the pair that was in front of R7 while nothing put them side by side.
    stack_pidfile_row
    (( ${#STACK_PIDFILE_PROBLEMS[@]} > 0 )) && problems+=("${STACK_PIDFILE_PROBLEMS[@]}")
    echo

    # -- network health: fetch the graph once and reuse it --
    local body="" gstate=""
    if port_open 8000; then
        body="$(http_get_graph)"
        [[ -n "$body" ]] && gstate="$(printf '%s' "$body" | graph_summary)"
    fi

    say "network health"
    if [[ -n "$gstate" ]]; then
        read -r g_sw g_up g_en g_sdis g_hosts g_edges g_edown g_edis <<<"$gstate"
        printf '  %-14s %s up, %s enabled, %s admin-disabled\n' "switches" "$g_up" "$g_en" "$g_sdis"
        printf '  %-14s %s total, %s down, %s admin-disabled\n' "links" "$g_edges" "$g_edown" "$g_edis"
        (( g_up  < g_sw )) && problems+=("$(( g_sw - g_up )) switch(es) are down")
        (( g_sdis > 0 ))   && problems+=("$g_sdis switch(es) are admin-disabled -- a power test may not have been undone")
        (( g_edown > 0 ))  && problems+=("$g_edown link(s) are down")
        (( g_edis  > 0 ))  && problems+=("$g_edis link(s) are admin-disabled")
        # The model comparison that used to live here compared the kernel graph against the
        # P4 model that host_count_override selects -- on an OVS fabric, a file nobody loaded.
        # It has moved into the "up target" block below, where the baseline is what `ndt up`
        # was actually asked for and the data plane kind is part of the comparison. (#8)
    else
        printf '  %-14s %s\n' "switches" "kernel not answering; no graph"
    fi
    local nem; nem="$(netem_count)"
    if [[ "${nem:-0}" -gt 0 ]]; then
        printf '  %-14s %s\n' "tc netem" "${Y}$nem qdisc(s) still shaping -- leftover fault injection?${N}"
        problems+=("$nem tc netem qdisc(s) are still installed")
    else
        printf '  %-14s %s\n' "tc netem" "none"
    fi
    # A missing sudo grant makes other lines on this page lie rather than fail, so it belongs
    # in --check: without ovs-vsctl the `up` guard cannot see an OVS fabric, and without mnexec
    # the forwarding check reports a specific routing failure it never measured. The table
    # decides which grants matter; this loop only reports them. [Co-developed with claude code -- Adam]
    local sudo_report; sudo_report="$(ndt_sudo_report)"; local src=$?
    case $src in
        0) printf '  %-14s %s\n' "sudo grants" "all $(ndt_sudo_rows all | wc -l) granted" ;;
        1) printf '  %-14s %s\n' "sudo grants" "${R}refused -- readings below them are not measurements${N}"
           printf '%s\n' "$sudo_report" | sed 's/^/                 /'
           problems+=("a sudo grant ndt needs is refused; see the sudo grants block above") ;;
        *) printf '  %-14s %s\n' "sudo grants" "${Y}could not be tested${N}"
           printf '%s\n' "$sudo_report" | sed 's/^/                 /'
           problems+=("a sudo grant ndt needs could not be tested on this machine") ;;
    esac
    # [Co-developed with claude code -- Adam]
    # app_probe, not app_running. This line printed "none running" through a TE-App crash loop
    # that ran 20h07m02s (2026-08-31; measured from the log, not from the process -- see
    # doc/audit/2026-08-31_live-recipes/app_te_log_evidence.txt), because the only witness it
    # consulted was a pidfile that the crash had taken with it. An app nothing is tracking is
    # strictly more dangerous than a tracked one -- nobody is going to stop it on the way out --
    # so it is named separately rather than folded into the running list.
    local appson="" orphans="" a
    app_elsewhere_reset; APP_ATTRIB_BLIND=""
    for a in $APP_NAMES; do
        app_probe "$a"
        case "$APP_STATE" in
            running)                appson="${appson:+$appson, }$a" ;;
            pidfile-lost-but-alive) orphans="${orphans:+$orphans, }$a(${APP_LIVE_PIDS[*]})" ;;
        esac
    done
    printf '  %-14s %s\n' "apps" "${appson:-none running}"
    case "$appson" in *energy*|*te*) problems+=("an app that changes the network is running: $appson") ;; esac
    if [[ -n "$orphans" ]]; then
        printf '  %-14s %s\n' "untracked" "${R}$orphans -- running, and no pidfile names them${N}"
        # [Co-developed with claude code -- Adam]
        # ROLE-4 T3, 2026-09-11 01:56:27-01:57:54. This line used to read "these survive 'ndt
        # down'", and the `ndt down` in that same round printed `nsr is running untracked (pid
        # 2666802 2666801) -- stopping it by pid` and killed both of them (`ps` counted 0
        # afterwards, 10-t3-down-by-owner.log). cmd_down's [0/3] gate is app_probe, not
        # app_running, and that was a deliberate change -- G-6, because the app whose pidfile has
        # gone is the one that most needs stopping. So this sentence was describing the code as it
        # had been before the fix that made it wrong, and the fix and the sentence were in the
        # same file. What is still true is the part that matters when you are NOT tearing down:
        # nothing else on this machine will ever stop them, and until something does they go on
        # polling the kernel API.
        printf '  %-14s %s\n' "" "'ndt down' does stop these -- it scans for them rather than"
        printf '  %-14s %s\n' "" "trusting the pidfile (G-6). Nothing else will, and until then"
        printf '  %-14s %s\n' "" "they keep polling the kernel: 'ndt apps stop <name>'"
        problems+=("untracked app process(es) with no pidfile: $orphans")
    fi
    # [Co-developed with claude code -- Adam]
    # 🔴 C10-8. Its own row and NOT a `problems+=` entry: `--check` is the command a session
    # runs to decide whether the machine it is about to measure is clean, and another tree's
    # test fixtures are not an answer to that question. They are printed because the row above
    # used to be red about them and a reader needs to see where they went.
    if (( ${#APP_ELSEWHERE[@]} > 0 )); then
        local ecol="" ee
        for ee in "${APP_ELSEWHERE[@]}"; do
            ecol="${ecol:+$ecol, }$(cut -d' ' -f2 <<<"$ee")(${ee%% *})"
        done
        printf '  %-14s %s\n' "elsewhere" "$ecol -- another checkout's; not counted, not stopped"
    fi
    # W16-2, Adam's decision 09-06 (grill §4D round 7, against the recommendation): --check
    # prints residue and goes red on it. G-12 was measured with `ndt status --check` answering
    # rc 0 over a rule and a lock that were still on the network -- the row above this one is
    # about PROCESSES and was right; nothing asked the other question.
    #
    # 🔴 --check ONLY. The scan is a flow-table GET plus three acquire probes, and plain
    # `ndt status` is read dozens of times an hour by sessions deciding whether to touch the
    # machine. A gate may pay for a reading; a status page may not.
    if [[ -n "$check" ]]; then
        status_residue_row
        (( ${#STATUS_RESIDUE_PROBLEMS[@]} > 0 )) && problems+=("${STATUS_RESIDUE_PROBLEMS[@]}")
    fi
    echo

    # -- the numbers themselves --
    if [[ -n "$gstate" ]]; then
        say "kernel graph"
        printf '  %s switches (%s up, %s enabled), %s hosts, %s edges\n' \
            "$g_sw" "$g_up" "$g_en" "$g_hosts" "$g_edges"
    fi
    if port_open 8081; then
        local paths ph="${ut_hosts:-$hosts}"
        paths="$(curl -s --max-time 5 http://localhost:8081/ryu_server/all_destination_paths | json_len all_destination_paths)"
        say "proxy"
        echo "  ${paths:-?} destination paths (want $(( ph * (ph - 1) )) for $ph hosts)"
        [[ -n "$paths" && "$paths" != "$(( ph * (ph - 1) ))" ]] &&
            problems+=("proxy reports $paths destination paths, want $(( ph * (ph - 1) ))")
    fi

    # -- does the running lab match what `ndt up` was asked for? (#8, decision N12 (a)) --
    echo
    check_up_target "${g_hosts:-}" "${g_edges:-}"; local utrc=$?
    (( ${#UP_TARGET_PROBLEMS[@]} > 0 )) && problems+=("${UP_TARGET_PROBLEMS[@]}")

    # --check turns the report into a gate. Plain `status` always exits 0, so reading it by
    # hand never looks like a failure.
    if [[ -n "$check" ]]; then
        echo
        # 🔴 "could not check" is its own answer, and it outranks "ok". With no baseline the
        # report is not a verdict about the lab, so it must not exit 0 -- and it must not exit
        # 1 either, because 1 means "I compared and found this wrong". Its own code, 3, and its
        # own sentence. (The mismatch wording is unreachable from here: nothing was compared.)
        if (( utrc == 3 )); then
            say "${Y}check: COULD NOT CHECK -- no 'ndt up' target recorded in this checkout${N}"
            printf '  - %s\n' "no baseline: run 'ndt up <target>' here first. this is NOT 'checked and matched'."
            if (( ${#problems[@]} > 0 )); then
                printf '  %s\n' "everything else this report could still check:"
                printf '  - %s\n' "${problems[@]}"
            fi
            return 3
        fi
        if (( ${#problems[@]} == 0 )); then
            say "${G}check: ok${N}"
            printf '  %s\n' "compared against the last 'ndt up': dataplane, fabric hosts, kernel graph, topology file"
            return 0
        fi
        say "${R}check: ${#problems[@]} problem(s)${N}"
        printf '  - %s\n' "${problems[@]}"
        return 1
    fi
    return 0
}

