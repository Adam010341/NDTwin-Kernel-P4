# --- the way IN, once the lab is up ----------------------------------------------------------
#
# [Co-developed with claude code -- Adam]
# 🔴 Adam, 2026-09-12 11:23. `ndt up p4` ended on `proxy :8081  kernel :8000  Mininet CLI: ...`;
# `ndt up ovs` ended on nothing of the kind, so an operator who had just built a 128-host fabric
# on the DEFAULT plane was not told how to get into it.
#
# ONE function for both planes. Two copies of a command an operator pastes drift, and this file
# has the evidence: up_p4 and up_ovs carry two copies of the H4 tab unpacking and one of them was
# wrong for a day (section 11 of tests/shell/test_ndt_up_down_robust.sh).
#
# 🔴 The command is not invented here. All three of ndtwin-lab's launch verbs -- topo-start,
# ovs-topo-start and ovs-topo-4host -- open the session as `-s topo` on the `-L ndtwinlab`
# socket, and each of them PRINTS this same line as its own `(attach: ...)` hint. The suite
# compares the two files rather than trusting this string.
lab_attach_cmd() { printf 'sudo tmux -L ndtwinlab attach -t topo\n'; }

# lab_entry_points <plane> -- the ports and the CLI, for a lab that came up and verified.
# OVS has no proxy: naming one there would send a reader to a port nothing is listening on.
lab_entry_points() {
    case "$1" in
        p4)  info "proxy :8081   kernel :8000   Mininet CLI: $(lab_attach_cmd)" ;;
        ovs) info "Ryu :8080   kernel :8000   Mininet CLI: $(lab_attach_cmd)" ;;
    esac
}

up_p4() {
    local hosts topo binary rate n want_paths
    # [Co-developed with claude code -- Adam]
    # 🔴 ROLE-9, 2026-09-12. An explicit host count on the command line wins and IS written
    # through to the override -- but not here, and not before the refusals below. This was
    # `set_host_count "$1"` as the first statement, so every refusal under it was a refusal
    # that had already changed a file of Adam's that nothing was going to change back, and the
    # H4 message three refusals down then quoted the value this command had just written. The
    # write now happens after the last refusal that can be decided without touching the
    # machine; see knob_snapshot / knob_restore. `hosts` is the count ASKED FOR, which is what
    # every check below has to be about: asking the knob here instead would compare NDT_TOPO
    # against the value of the last round and let `ndt up p4 128` build a 4-host fabric, which
    # is H4 reached by way of H4's own fix.
    KNOB_SAVED=""
    hosts="$(host_count)"
    KNOB_ENTRY="$hosts"
    local knob_wanted="" knob_layout=splitter
    # --- the app package, if there is one ---------------------------------------------------
    #
    # [Co-developed with claude code -- Adam]
    # Everything in this block is a refusal that can be decided without touching the machine,
    # and it is FIRST for the reason set_host_count's position is what it is: a package that
    # cannot be brought up must not have moved a file on the way to saying so. The knob itself
    # is written far below, beside the host-count knob, under the same rule.
    local app_dir="" app_mode="" app_model=""
    if [[ -n "${NDT_APP_DIR:-}" ]]; then
        app_dir="$NDT_APP_DIR"
        # 🔴 A package SIZES the fabric -- it names every host -- so a host count beside it is
        # two answers to one question. Refused rather than ranked.
        if [[ -n "${1:-}" ]]; then
            err "ndt up p4 --app <dir> takes no host count: the package's model declares its hosts."
            err "  got '$1' as well. Drop it, or drop --app."
            return 2
        fi
        app_model="$(app_model_path "$app_dir")"
        if [[ ! -f "$app_model" ]]; then
            err "refusing to build: $app_dir carries no ${app_model#$app_dir/}"
            err "  that file is what the kernel is handed and what the fabric is built from;"
            err "  tools/p4_exercise/convert.py writes it. This is not an app package."
            return 5
        fi
        # -- 1. pre-flight, printed verbatim. The package is somebody else's artefact and this
        #       is the only reader that judges it against the p4info it carries.
        say "app package pre-flight"
        info "package      $app_dir"
        if ! app_preflight "$app_dir"; then
            echo
            err "refusing to build: the app package did not pass pre-flight (table above)."
            err "  nothing was started and nothing was written -- p4_proxy/mininet/app_package_override"
            err "  is UNCHANGED at $(app_knob_state)."
            err "  fix the red rows, then:  ndt up p4 --app $app_dir"
            # 🔴 rc 5: a GUARD REFUSED and nothing was built -- the same code the two H4
            # refusals below and record_up_target's give. The distinction rc 1 carries is
            # "this command looked at the machine and did not like what it found", and this
            # refusal never looked at the machine at all. (NDT-8's contract, `ndt help`.)
            return 5
        fi
        echo
        # -- 2. the size comes out of the model, not off the command line.
        hosts="$(topo_model_counts "$app_model")"; hosts="${hosts%% *}"
        if [[ ! "$hosts" =~ ^[0-9]+$ ]]; then
            err "refusing to build: this script could not count the hosts $app_model declares."
            err "  it is what host_count_override, the kernel's model and every check below"
            err "  would be sized from, so an uncounted model is not a package this can build."
            return 5
        fi
        local app_sw; app_sw="$(topo_model_switches "$app_model")"
        if [[ ! "$app_sw" =~ ^[0-9]+$ ]] || (( app_sw == 0 )); then
            err "refusing to build: $app_model declares no switches this script can count."
            return 5
        fi
        # 🔴 The fabric size that every check in this function and in verify_p4 compares
        # against. It was the literal 10 because every topology in setting/ has ten switches;
        # exercises/basic's pod-topo has four, so leaving the literal would make the bring-up
        # wait 180 s for six switches that are never coming and then call the fabric dead.
        SWITCHES="$app_sw"
        knob_wanted="$hosts"
        knob_layout=package
        # -- 3. NDT_TOPO. Set to the package's model so the EXISTING consistency check below
        #       runs against it, and refused when the operator has already pointed it
        #       somewhere else: a package naming one model while NDT_TOPO names another is
        #       2026-08-21 in a new costume -- one of them builds the fabric and the other is
        #       handed to the kernel, and every topology view reads correct either way.
        local tv
        for tv in NDT_TOPO NDTWIN_P4_TOPO_FILE; do
            local cur="${!tv:-}"
            [[ -z "$cur" ]] && continue
            if [[ "$(readlink -f "$cur" 2>/dev/null)" != "$(readlink -f "$app_model" 2>/dev/null)" ]]; then
                err "refusing to build: $tv=$cur and the app package's model are two different files."
                err "  the package declares  $app_model"
                err "  one of them would build the fabric while the other was handed to the kernel."
                err "  unset $tv, or point it at the package's model."
                return 5
            fi
        done
        NDT_TOPO="$app_model"
        app_mode="$(app_package_mode "$app_dir")"
    elif [[ -n "${1:-}" ]]; then
        [[ "$1" =~ ^[0-9]+$ ]] || { err "usage: ndt up p4 [host-count] | ndt up p4 --app <dir>"; return 2; }
        host_count_buildable "$1" || return 1
        knob_wanted="$1"
        hosts="$1"
    fi
    # 🔴 The path, the rc AND the reason out of ONE call, and not because three lines would be
    # untidy: a command substitution is a subshell, so `topo="$(topo_for_hosts ...)"` alone left
    # TOPO_REFUSAL empty in this shell and this refusal printed its fallback sentence, naming no
    # numbers. That is F8's failure mode exactly (LAB_KERNEL_DIR_SOURCE, ndt:1065), reproduced
    # here within a day of it being fixed there, and caught by section 8 of
    # tests/shell/test_ndt_up_down_robust.sh rather than by a reader.
    local trc both rest
    both="$(topo_for_hosts "$hosts" p4; printf '\t%s\t%s' "$?" "$TOPO_REFUSAL")"
    # 🔴 `%%$'\n'*`, and it is not cosmetic. topo_for_hosts prints the path with `echo`, and a
    # command substitution strips only TRAILING newlines -- here the tab and the rc follow it, so
    # the newline is in the middle of the captured string and survives. Without this line `topo`
    # was "<path>\n": every [[ -f "$topo" ]] false, sha256sum and topo_model_counts failing
    # silently into `topology_sha256=unavailable` and an empty `model_hosts=`, and the kernel
    # started with a --topology it could not open. Measured live by ROLE-6 on 2026-09-11, both
    # planes: `Cannot open topology file` / `No port has been opened`, rc 1 after ~318 s with
    # `rollback INCOMPLETE`. The packing itself is right -- see the note above about F8 -- and
    # this is the unpacking of its first field, which is a path and therefore one line.
    topo="${both%%$'\t'*}"; topo="${topo%%$'\n'*}"; rest="${both#*$'\t'}"
    trc="${rest%%$'\t'*}"; TOPO_REFUSAL="${rest#*$'\t'}"
    binary="$(bmv2_binary)"
    # 🔴 F1 (F-OFFLINE-1 §1.14). `sample_rate` with no argument asks live_dataplane_kind, so
    # on a machine where an OVS fabric was left up this printed OVS's sampling rate -- or
    # `NO sFlow record on any bridge -- this fabric samples NOTHING` -- under the label
    # "(compiled into ndtwin_switch.json)", and the reuse refusal below then asserted that ten
    # bmv2 switches were not running a number that came out of OVSDB. This function is BUILDING
    # the P4 plane; the plane is not something to look up here.
    rate="$(sample_rate p4)"

    # H4. rc 3 is "you named a real model, of a different network" -- a separate answer from
    # "there is no model with this host count", and it needs a separate message: the file the
    # operator named is right there, and telling them to derive one would be wrong.
    if (( trc == 3 )); then
        err "refusing to build: ${TOPO_REFUSAL:-NDT_TOPO does not match the host count}"
        err "  this run asked for a fabric of $hosts host(s), and the kernel would load the"
        err "  model NDT_TOPO names. Two networks, one bring-up."
        # 🔴 ROLE-9: the value the OPERATOR arrived with. This line used to read "the fabric is
        # built from p4_proxy/mininet/host_count_override ($hosts)" and $hosts was what this
        # very command had written into that file a tenth of a second earlier -- a refusal
        # quoting a state only the refusal had created. The write is now below this check, so
        # the sentence can say the true thing instead.
        err "  p4_proxy/mininet/host_count_override is UNCHANGED at $KNOB_ENTRY: the knob is"
        err "  written after this check, never before it, so this refusal moved nothing."
        err "  either drop NDT_TOPO, or set the knob to the model's count:  ndt up p4 <n>"
        # 🔴 rc 5: a refusal, not a dirty reading -- nothing on the machine was looked at.
        return 5
    fi
    if [[ -z "$topo" ]]; then
        err "no P4 topology model in setting/ has $hosts hosts."
        err "the kernel would load a model of a different network. derive one first:"
        err "  python3 tools/test_workflow/derive_p4_topology_json.py \\"
        err "      setting/StaticNetworkTopologyMininet_10Switches.json \\"
        err "      setting/StaticNetworkTopologyP4_10Switches_${hosts}Hosts.json"
        return 1
    fi
    want_paths=$(( hosts * (hosts - 1) ))

    local held; held="$(foreign_claim)"
    if [[ -n "$held" ]]; then
        err "the lab is claimed by $held; 'ndt up' may restart the stack under them."
        # 🔴 rc 5: refused. (Adam, 2026-09-12)
        return 5
    fi
    local busy; busy="$(in_flight)"
    if [[ -n "$busy" ]]; then
        err "a measurement is running; 'ndt up' may restart the fabric under it:"
        printf '%s\n' "$busy" | sed 's/^/        /' >&2
        # 🔴 rc 5: refused, the same as the claim above it.
        return 5
    fi

    say "ndt up p4"
    info "hosts        $hosts        (p4_proxy/mininet/host_count_override)"
    info "topology     ${topo#$REPO/}"
    # Printed on the same page as the four numbers it changes, because it decides all of them:
    # the model, the host count, the switch count and the control plane.
    if [[ -n "$app_dir" ]]; then
        info "app package  $app_dir (mode ${app_mode:-unreadable}, $SWITCHES switch(es))"
    else
        info "app package  none (baseline fabric)"
    fi
    info "bmv2         $binary"
    info "sample rate  $(rate_label "$rate")     (compiled into ndtwin_switch.json)"
    echo

    # 🔴 `return $?`, not `return 1`: preflight answers 5 when a guard refused and 1 when it
    # found something. Flattening it here would put the distinction back one screen after it
    # was made.
    preflight p4 || return $?

    # What this run was asked for, written down before anything is built, so `status --check`
    # has a baseline that does not depend on reading a P4-only knob back afterwards. (#8, N12)
    record_up_target p4 "$hosts" "$topo" || return $?

    # [Co-developed with claude code -- Adam]
    # 🔴 ROLE-9. THE KNOB IS WRITTEN HERE, and this line's position is the fix: everything above
    # it is a refusal that can be decided without touching the machine, and every one of them
    # used to run with this file already rewritten. record_up_target is above it too -- it is
    # the second H4 guard and can still refuse -- so the last thing that can say no has said it
    # before the only persistent file an `ndt up` writes is moved.
    #
    # Nothing below this point may leave the knob moved unless the fabric really came up at
    # that size: the three refusals in [1/3] and rollback_up all call knob_restore.
    if [[ -n "$knob_wanted" ]]; then
        knob_snapshot
        set_host_count "$knob_wanted" "$knob_layout" || { knob_restore "the knob write itself was refused"; return 1; }
    fi
    # [Co-developed with claude code -- Adam]
    # 🔴 THE APP KNOB, at the same point and under the same rule. The two branches are both
    # writes to persistent state, and the clearing one is not the harmless half: a knob left
    # over from an earlier `ndt up p4 --app` is read by the proxy and by p4_testbed_topo.py, so
    # `ndt up p4 4` with a stale knob would build somebody's exercise fabric under a banner
    # that says baseline. Every `ndt up` states which of the two it is.
    if [[ -n "$app_dir" ]]; then
        app_knob_write "$app_dir" || {
            knob_restore "the app package knob could not be written"
            err "nothing was started."
            return 1; }
    else
        app_knob_clear "this 'ndt up' asked for the baseline fabric" || return 1
    fi
    # [Co-developed with claude code -- Adam]
    # 🔴 THE NOTE DOES NOT NAME THE PACKAGE, deliberately. This line is the literal anchor of
    # mutate_ndt_honesty.sh's M10 ("ndt up p4 stops writing the note"), and an anchor that no
    # longer resolves makes that gate report a SURVIVOR -- a cell losing its power is worse
    # than a note losing a word. What another session needs is on `ndt status`'s own
    # `app package` row and in .test_run/up.target's topology path, which under a package IS
    # the package's model. If the note should carry it, move M10's anchor in the same commit.
    claim_note_up "p4 $hosts"

    # -- 1. fabric --
    say "[1/3] bmv2 fabric"
    n="$(bmv2_count)"
    local live_hosts; live_hosts="$(fabric_host_count)"
    # Reuse requires BOTH counts to match. The switch count alone identifies nothing -- every P4
    # topology here has ten -- so a fabric of the wrong size passed as "already up". See
    # fabric_host_count.
    if topo_session && [[ "$n" -eq "$SWITCHES" && "$live_hosts" -eq "$hosts" ]]; then
        if stale_pipeline; then
            # Reusing here would measure the old pipeline while every readout says the new one.
            err "the fabric predates the current build of ndtwin_switch.json."
            err "bmv2 loads the pipeline at exec time and never reloads, so these $n switches"
            err "are NOT running $(rate_label "$rate"). take it down and back up:  ndt down && ndt up"
            knob_restore "this bring-up was refused before it changed anything"
            return 1
        fi
        ok "already up: $n switches, $live_hosts hosts, reusing"
    else
        if topo_session && [[ "$n" -eq "$SWITCHES" && "$live_hosts" -ne "$hosts" ]]; then
            info "the running fabric has $live_hosts hosts, this run wants $hosts; rebuilding it"
        fi
        if [[ "$n" -gt 0 ]] && ! topo_session; then
            # Orphans outlive `mn -c`. Which ports that costs, and why the resulting error
            # reads like a P4 pipeline problem, is now a row in ports.sh rather than a
            # sentence here -- and the row is printed, so the operator sees the actual held
            # ports instead of a count of processes. [Co-developed with claude code -- Adam]
            warn "$n orphan bmv2 process(es) with no topo session; sweeping first"
            ndt_port_residue p4 | sed 's/^/  /'
            # [Co-developed with claude code -- Adam]
            # FINDING #21. This was `sudo -n "$LAB" cleanup >/dev/null 2>&1`: output discarded,
            # exit status discarded, and then a fabric built on top of whatever survived. Until
            # G-9 that was invisible rather than wrong -- every kill in the old cleanup was
            # `|| true`, so it was structurally incapable of returning non-zero and had nothing
            # to say. G-9 made it able to fail AND made it name the survivor, so both halves are
            # now a real loss. The consequence is in ports.sh's 30051-30060 row: an orphan that
            # outlived TERM and KILL keeps a gRPC port, the fabric this function is about to
            # build cannot bind, and what the operator sees is an error that reads like a P4
            # pipeline problem rather than a leftover process.
            local cout crc
            cout="$(sudo -n "$LAB" cleanup 2>&1)"; crc=$?
            printf '%s\n' "$cout" | sed 's/^/      /'
            if (( crc != 0 )); then
                err "the orphan sweep exited $crc: it did not finish, and what survived is named"
                err "above. Building a fabric over it is how a leftover process turns into an"
                err "error that looks like a P4 problem (ports.sh, the 30051-30060 row), so this"
                err "refuses instead of proceeding. Ports still held:"
                ndt_port_residue p4 | sed 's/^/        /' >&2
                err "deal with it, then retry:  ndt down --deep && ndt up p4"
                knob_restore "this bring-up was refused before it changed anything"
                return 1
            fi
        fi
        # [Co-developed with claude code -- Adam]
        # Refuse a live OVS fabric instead of quietly removing it. `up_ovs` already refuses the
        # mirror case ("starting Ryu under a live Mininet is the /stats/flow wedge trigger");
        # this side used to be a bare `topo-stop >/dev/null 2>&1`, so `ndt up` on a running OVS
        # fabric destroyed it with no message at all. The asymmetry was invisible because all
        # three ndtwin-lab verbs name their tmux session `topo`, so the session's existence
        # cannot tell the two planes apart -- the bridges can.
        # The whole decision, including "could not tell", lives in guard_no_live_ovs so a test
        # can call it on its own. Inline, it sat behind topo_session and a bmv2 count that had
        # already returned in every branch a test could reach.
        guard_no_live_ovs || { knob_restore "this bring-up was refused before it changed anything"; return 1; }
        topo_session && { info "stopping the existing topo session"; sudo -n "$LAB" topo-stop >/dev/null 2>&1; }
        # Recorded before the call, not after: a topo-start that fails part way through has
        # still changed the machine, and topo-stop/cleanup are idempotent. See rollback_up.
        up_started fabric
        # [Co-developed with claude code -- Adam]
        # The output is PRINTED, not discarded. topo-start's one line is "topo session started
        # from <KERNEL_DIR>", and ndtwin-lab prints it deliberately -- its comment there says
        # "Which tree, every time. FINDING-01 ran the main tree's 128-host topology against a
        # 4-host model for a whole round without a line of output that could have caught it."
        # This call site's `>/dev/null` then silenced exactly that line, so on 09-10 the same
        # two-tree run happened again with nothing on screen naming either tree (R5-P4-128).
        # Kept on stdout rather than routed to a log: the reader who needs it is the operator
        # watching the bring-up, and the guard above only fires when the trees differ -- this
        # line is what says which tree was used when they do NOT.
        local tsout tsrc
        tsout="$(sudo -n "$LAB" topo-start 2>&1)"; tsrc=$?
        [[ -n "$tsout" ]] && printf '%s\n' "$tsout" | sed 's/^/      /'
        if (( tsrc != 0 )); then
            err "topo-start failed"
            # [Co-developed with claude code -- Adam]
            # The bridge may never have been launched at all here -- `ndtwin-lab topo-start`
            # refuses outright when a topo session is already up -- so whatever topo.log holds
            # is quite possibly the PREVIOUS round's. Printed anyway, and labelled: the other
            # likely cause is a bridge that started and died before tmux could report it, and
            # for that case this is the only record. An unlabelled tail would be worse than
            # none, because a stale traceback read as this run's is a wrong diagnosis.
            err "topo.log may be the PREVIOUS round's -- the bridge may not have started:"
            topo_log_tail 30
            rollback_up "topo-start failed; this run had already begun changing the machine"
            return 1
        fi
        info "waiting for $SWITCHES switches and the manifest"
        local i
        for i in $(seq 1 180); do
            n="$(bmv2_count)"
            [[ "$n" -ge "$SWITCHES" && -s "$MANIFEST" ]] && break
            sleep 1
        done
        n="$(bmv2_count)"
        if [[ "$n" -lt "$SWITCHES" || ! -s "$MANIFEST" ]]; then
            err "fabric did not come up: $n/$SWITCHES switches, manifest $( [[ -s $MANIFEST ]] && echo present || echo missing )"
            err "look at the pane:  sudo -n $LAB topo-out 40"
            # [Co-developed with claude code -- Adam]
            # 🔴 THE PANE IS NOT A RECORD, and the line above was the only instrument this
            # branch had. On 2026-09-18 the bridge died of a KeyError before write_manifest,
            # tmux reaped the session on exit, and `topo-out` then answered "no topo session" --
            # so the traceback naming the line existed nowhere by the time anybody read this
            # message. ntg_bmv2_topo.py tees its output to .test_run/logs/topo.log for exactly
            # this moment; printed BEFORE rollback_up, because rollback runs `ndtwin-lab
            # cleanup` and the operator should see the cause above the recovery.
            topo_log_tail 30
            rollback_up "the fabric never came up, and a half-built one holds :3005x/:909x"
            return 1
        fi
        ok "$n switches up after ${i}s, manifest written"
    fi
    # The binary that is *running*, not the one the override file names -- a stale fabric
    # started before an override edit is the difference between 40 and 500 Mbit/s.
    local running
    running="$(ps -eo args= 2>/dev/null | grep -o '/[^ ]*simple_switch_grpc' | sort -u | head -1)"
    [[ -n "$running" ]] && ok "running binary: $running"

    # -- 2 + 3. proxy and kernel, via stack.sh --
    say "[2/3] proxy + kernel"
    info "stack.sh prompt is answered immediately: the fabric is already up"
    # CONVERGE_WAIT is an upper bound, not a sleep. 128 hosts means 16256 destination paths.
    local out rc
    up_started stack
    out="$(printf '\n' \
           | TOPO_P4="$topo" CONVERGE_WAIT="${CONVERGE_WAIT:-300}" NO_COLOR=1 \
             bash "$STACK" up p4 2>&1)"
    rc=$?
    if (( rc != 0 )); then
        err "stack.sh up p4 exited $rc"
        printf '%s\n' "$out" | tail -20 | sed 's/^/      /'
        # [Co-developed with claude code -- Adam]
        # 🔴 THE PROXY'S OWN LAST WORDS, not stack.sh's report of its silence. P1-A §4-11 makes
        # proxy_agent/main.py raise AT IMPORT when the app package or its topology model cannot
        # be read -- which is the intended outcome, because starting on the baseline fabric
        # because somebody's package would not parse is the silent substitution the whole
        # feature exists to remove. But stack.sh only ever sees `proxy did not open :8081`, and
        # under a package that sentence is true of every possible cause. The traceback that
        # names the field is in the log and nothing was printing it.
        proxy_log_tail 10
        rollback_up "stack.sh could not bring the proxy/kernel up over this fabric"
        return 1
    fi
    printf '%s\n' "$out" | grep -E 'started|converged|up$|waiting for|already running|DIFFERENT command' | sed 's/^/      /'

    # -- verify --
    say "[3/3] verify"
    verify_p4 "$topo" "$want_paths" "$app_mode"
}

# proxy_log_tail <n> -- the last n lines of the P4 proxy's log, or a line saying there is none.
# The path is stack.sh's $LOG_DIR/p4_proxy.log; $RUN_DIR defaults to $KERNEL_DIR/.test_run
# (components.env), and NDT_PROXY_LOG overrides it for the tests.
proxy_log_tail() {
    local n="${1:-10}" f="${NDT_PROXY_LOG:-$REPO/.test_run/logs/p4_proxy.log}"
    if [[ ! -s "$f" ]]; then
        err "no proxy log at ${f#$REPO/} -- the proxy never got far enough to write one"
        return 0
    fi
    err "the last $n line(s) of ${f#$REPO/}:"
    tail -n "$n" "$f" | sed 's/^/      /' >&2
    return 0
}

# topo_log_tail <n> -- the last n lines of the bmv2 bridge's log, or a line saying there is none.
#
# [Co-developed with claude code -- Adam]
# The same shape as proxy_log_tail above and for the same reason, one layer down: `ndt up` can
# only ever observe the fabric's ABSENCE (`0/4 switches, manifest missing`), which is true of
# every possible cause, and ntg_bmv2_topo.py's own words -- the pre-flight refusal, the
# per-switch bind error, the traceback -- were until 2026-09-18 only ever in a tmux pane that
# stops existing the moment the script does.
#
# 🔴 THE LAB'S TREE, NOT OURS. The writer is `sudo ndtwin-lab topo-start`, which runs the bridge
# out of $KERNEL_DIR -- the helper's, which is not necessarily this checkout (FINDING-01 is
# exactly the two-tree case). lab_kernel_dir() is the same answer `ndt` already uses for
# app_sim.log. NDT_TOPO_LOG overrides it for the tests and is the name topo_log.py reads.
topo_log_tail() {
    local n="${1:-30}" f="${NDT_TOPO_LOG:-$(lab_kernel_dir)/.test_run/logs/topo.log}"
    if [[ ! -s "$f" ]]; then
        err "no topology log at ${f#$REPO/} -- the bridge never got far enough to write one"
        return 0
    fi
    err "the last $n line(s) of ${f#$REPO/}:"
    tail -n "$n" "$f" | sed 's/^/      /' >&2
    return 0
}

verify_p4() {
    local topo="$1" want_paths="$2" mode="${3:-}" rc=0

    # [Co-developed with claude code -- Adam]
    # 🔴 UNDER AN EXTERNAL CONTROL PLANE THIS CHECK HAS NO SUBJECT, and saying so is not the
    # same as passing it. `mode: external` means the proxy opens no arbitration stream, sends
    # no LLDP, starts no watchdog and installs no route (P1-A §2.3) -- so all_destination_paths
    # is 0 BY DESIGN, and so is forwarding until the exercise's own controller runs. A bring-up
    # that reported `0/6 destination paths, never settled` would be reporting the mode as a
    # fault; one that quietly counted it as ok would be the "report zero, not an error" shape
    # this project keeps finding. Both unrunnable checks are therefore NAMED, individually,
    # with what would have to happen before they could be run -- and every other check in this
    # function still runs, because switches, graph, model and fabric are all assertable.
    #
    # 🔴 ONE verdict block at the bottom of this function and ONE call to the entry-points
    # helper under it, not an early return with a second copy of each.
    # tests/shell/test_ndt_up_down_robust.sh counts that call site and asserts it sits on the
    # line after the `ready` line, and it counts it because up_p4 and up_ovs have already
    # shipped two copies of one paragraph with one of them wrong for a day.
    if [[ "$mode" == external ]]; then
        warn "proxy: destination paths NOT CHECKED -- this package declares an external control"
        warn "  plane, so the proxy installs no routes and 0 is the designed answer, not a"
        warn "  reading. The exercise's own controller is what puts rules on these switches:"
        warn "  tools/p4_exercise/run_external_controller.py <pkg> <controller.py>"
    else
        # Settle, do not sample. Measured 2026-08-20: stack.sh reported "converged after 4s" at
        # 16256 paths and a read seconds later returned 13184, with the proxy still installing
        # routes and the kernel making its one startup topology pull in the same window; it was
        # then rock-steady at 16256 for 40s. So the count is not a monotonic progress bar, and a
        # single equality check at an arbitrary instant can read a list mid-repopulation.
        # Require the target twice, at least 3s apart, before calling it ready.
        local paths hits=0 i
        for i in $(seq 1 40); do
            paths="$(curl -s --max-time 5 http://localhost:8081/ryu_server/all_destination_paths \
                     | json_len all_destination_paths)"
            if [[ "$paths" == "$want_paths" ]]; then
                hits=$(( hits + 1 ))
                (( hits >= 2 )) && break
            else
                hits=0
            fi
            sleep 3
        done
        if (( hits >= 2 )); then
            ok "proxy: $paths/$want_paths destination paths (stable)"
        else
            err "proxy: ${paths:-no answer}/$want_paths destination paths, never settled"
            rc=1
        fi
    fi

    verify_p4_graph "$topo" || rc=1

    # Same blind spot as the OVS path, for a different reason: the destination-path count
    # above is what the proxy *says* it installed, and install-then-delete on bmv2 has been
    # observed to leave a black hole that still counts as a path.
    #
    # [Co-developed with claude code -- Adam]
    # 🔴 THE PAIR COMES OUT OF THE MODEL. `h1 10.0.0.2` was written here as a literal, and it is
    # a fact about the two baseline models only -- exercises/basic's pod-topo has h1 on 10.0.1.1
    # and h2 on 10.0.2.2. Under that package the literal names an address no host in that fabric
    # holds, and `ping` would fail for that reason while this function reported `fabric is up but
    # not forwarding`: a specific claim about routing, manufactured from a wrong destination.
    # For both baseline models topo_model_ping_pair returns exactly `h1 10.0.0.2`.
    if [[ "$mode" == external ]]; then
        warn "data plane: forwarding NOT TESTED for the same reason -- nothing has programmed"
        warn "  these switches yet. Test it after the controller has run."
    else
        local pair src dst
        pair="$(topo_model_ping_pair "$topo")"
        if [[ -z "$pair" ]]; then
            err "data plane: forwarding NOT TESTED -- ${topo#$REPO/} does not name two hosts this"
            err "  script can read a source and a destination out of. An untested check must not"
            err "  print ok, so this is a failure."
            rc=1
        else
            read -r src dst <<<"$pair"
            verify_dataplane "$src" "$dst" \
                "the proxy reports its paths installed; that is not the same as bmv2 forwarding them" || rc=1
        fi
    fi

    echo
    if (( rc == 0 )); then
        say "up. ${G}ready${N}"
        lab_entry_points p4
        # 🔴 The caveat is its own line under an unchanged verdict, not a suffix on it. `ready`
        # is the word an operator and half a dozen scripts grep for; qualifying it in place
        # would make the sentence mean two things depending on the package.
        if [[ "$mode" == external ]]; then
            warn "external control plane: this fabric is up and EMPTY. NDTwin has programmed"
            warn "  nothing and will not; the exercise's own controller is what makes it"
            warn "  forward. Until it runs, every ping between these hosts fails."
        fi
    else
        say "up, ${R}but not verified${N} -- do not measure on this"
    fi
    return $rc
}

# verify_p4_graph <topology-file> -- the kernel's graph, against the model it was handed and
# against the fabric that was actually built. rc 1 if any of the three disagrees or cannot be
# read.
#
# [Co-developed with claude code -- Adam]
# Split out of verify_p4 so that the external-control-plane branch can ask all three of these
# questions. They are the ones an external package leaves assertable: the switches, the graph
# and the host namespaces exist whether or not anybody has programmed them. Split rather than
# copied, for the reason up_p4 and up_ovs's two copies of the H4 unpacking are recorded as a
# defect one screen up.
verify_p4_graph() {
    local topo="$1" rc=0
    local graph
    graph="$(curl -sf --max-time 5 http://localhost:8000/ndt/get_graph_data \
             | python3 -c "
import json,sys
d=json.load(sys.stdin)
sw=[n for n in d.get('nodes',[]) if n.get('vertex_type')==0]
print(len(sw), sum(1 for n in sw if n.get('is_up')), sum(1 for n in sw if n.get('is_enabled')),
      sum(1 for n in d.get('nodes',[]) if n.get('vertex_type')==1), len(d.get('edges',[])))" 2>/dev/null)"
    if [[ -z "$graph" ]]; then
        err "kernel: no usable answer from /ndt/get_graph_data"
        return 1
    fi
    read -r total up enabled hosts edges <<<"$graph"

    local want_hosts
    want_hosts="$(python3 -c '
import json,sys; t=json.load(open(sys.argv[1]))
print(sum(1 for n in t["nodes"] if n.get("vertex_type")==1))' "$topo" 2>/dev/null)"

    # 🔴 THE DENOMINATOR COMES OUT OF THE MODEL THIS FUNCTION WAS HANDED, not out of $SWITCHES.
    # [Co-developed with claude code -- Adam]
    # The global is the literal 10, and up_p4 overwrites it from the package -- but this
    # function is reached by more than one path and a global that some caller forgot to set is
    # a denominator that silently belongs to another fabric. Measured live on 2026-09-18 under
    # `ndt up p4 --app basic`: the fabric, the proxy and the kernel all had FOUR switches and
    # this printed `kernel: 4 switches, 4 up (want 10/10)` and `is_enabled=4/10`, i.e. it
    # reported a correct fabric as broken. `$topo` is the file the kernel was handed and is
    # already what `want_hosts` below is counted from -- counting the switches from the same
    # place is one reader for one question. topo_model_switches is C's helper, unchanged.
    # For both baseline models this is 10, so the baseline verdict is the one it always was.
    local want_sw; want_sw="$(topo_model_switches "$topo")"
    if [[ ! "$want_sw" =~ ^[0-9]+$ ]] || (( want_sw == 0 )); then
        # Unobtainable is RED, exactly as it is for the host count below: a check whose
        # expected value could not be read has not been run, and must not print ok.
        err "kernel: UNCHECKED -- cannot count the switches ${topo#$REPO/} declares"
        err "  the kernel says $total switches with $up up, and there is nothing to judge that"
        err "  against. topo_model_switches gave '${want_sw:-<empty>}'."
        rc=1
    elif [[ "$total" == "$want_sw" && "$up" == "$want_sw" ]]; then
        ok "kernel: $total switches, $up up, $edges edges, $hosts hosts"
    else
        err "kernel: $total switches, $up up (want $want_sw/$want_sw)"
        rc=1
    fi
    # The graph must describe the network we actually built.
    #
    # [Co-developed with claude code -- Adam]
    # FIXED 2026-08-30 (T-8, FINDING-01). Until this commit both sides of this comparison came
    # from the model: `$hosts` is the kernel's graph and `$want_hosts` is the topology JSON the
    # kernel was handed. A check named "model matches fabric" that never reads the fabric cannot
    # fail, and on 08-30 it printed `ok model matches fabric: 4 hosts` over a fabric with 128
    # host namespaces. The old comment claimed it was "the check that would have caught a wrong
    # TOPO_P4"; it was the check that could not.
    #
    # The fabric-side quantity is fabric_host_count() -- host namespaces counted out of `ps`.
    # Why that one of the three candidates FINDING-01 offered:
    #   * it is the quantity that was counted BY HAND to establish the finding (128), so the fix
    #     is checked against the same reading that exposed the defect;
    #   * it already decides fabric reuse at up_p4 and gates the OVS build, so this adds no
    #     third opinion about "how big is the fabric" -- a disagreement between two existing
    #     readers is a bug we would have to adjudicate, and there is no reason to create one;
    #   * the manifest (/tmp/ndtwin_p4_switches.json) is keyed by SWITCH and cannot answer a
    #     question about hosts at all;
    #   * veth count is a function of the topology's link layout as well as its host count, so
    #     it needs a per-topology constant to interpret -- another number that can drift.
    #
    # Unobtainable is RED, not green. fabric_host_count returns 0 when `ps` gives nothing or
    # when the "mininet:h<N>" argv convention it matches on changes. A fabric that this script
    # just brought up always has at least one host, so 0 here means THE READING FAILED, and the
    # whole point of the fix is lost if a failed reading is allowed to pass. That is the branch
    # the old code effectively took for every value.
    local live_hosts; live_hosts="$(fabric_host_count)"
    if [[ ! "$live_hosts" =~ ^[0-9]+$ ]] || [[ "$live_hosts" -eq 0 ]]; then
        err "model/fabric UNCHECKED: no fabric-side host count obtainable (fabric_host_count gave '${live_hosts:-<empty>}')."
        err "  the kernel graph says $hosts hosts and the topology file says $want_hosts, but neither is the fabric."
        err "  this is reported as a failure on purpose: an unverifiable check must not print ok."
        rc=1
    elif [[ "$hosts" == "$want_hosts" && "$hosts" == "$live_hosts" ]]; then
        ok "model matches fabric: $hosts hosts (kernel graph, topology file and $live_hosts host namespaces all agree)"
    else
        err "model/fabric mismatch: kernel graph has $hosts hosts, topology file has $want_hosts, the FABRIC has $live_hosts host namespaces"
        rc=1
    fi
    if [[ "$want_sw" =~ ^[0-9]+$ ]] && [[ "$enabled" != "$want_sw" ]]; then
        # Structural in P4 mode, not a fault: nothing calls /ndt/inform_switch_entered.
        # The denominator is the model's, for the reason above -- `is_enabled=4/10` on a
        # four-switch package read as two faults where there were none.
        info "is_enabled=$enabled/$want_sw -- expected in P4 mode, nothing calls inform_switch_entered"
    fi
    return $rc
}

up_ovs() {
    # $1 = 128 (NTG's own OVS fabric) or 4 (the P4 test bed's layout on OVS, so a P4-vs-OVS
    # comparison varies the data plane and nothing else -- every such comparison before
    # 2026-08-17 also changed the topology and could not attribute its difference).
    local ovs_hosts="${1:-128}" ovs_verb=ovs-topo-start
    [[ "$ovs_hosts" == 4 ]] && ovs_verb=ovs-topo-4host

    # [Co-developed with claude code -- Adam]
    # The OVS plane has exactly two fabric sizes, and neither is a parameter. `ovs-topo-start`
    # runs NTG's own testbed_topo.py -- another repo, 128 hosts hard-coded, no host argument --
    # and `ovs-topo-4host` runs ours at 4. Any other N used to pick a *model* of that size and
    # then build 128 hosts anyway, and report success: measured 2026-08-21, `ndt up ovs 16` gave
    # "model matches fabric: 16 hosts" over a 128-host fabric with 160 veths.
    #
    # CORRECTED 2026-08-30 (T-8, FINDING-01). That measurement was written down here for nine
    # days as a reason to REFUSE odd sizes, and read as if the check downstream would have
    # caught it for the sizes we do allow. It would not have. Both sides of that comparison came
    # from the model, so "model matches fabric: 16 hosts" was not a check that missed a 128-host
    # fabric -- it was a check that could not see any fabric at all, and the same false pass was
    # observed again on the P4 arm on 08-30 (`ok model matches fabric: 4 hosts` over 128 host
    # namespaces). The line recorded here is therefore evidence about the CHECK, not only about
    # the size argument. verify_p4 now reads fabric_host_count(); verify_ovs's equivalent was
    # renamed to "kernel graph matches the model file" because for host count it is close to
    # tautological and the old name claimed a guarantee it does not give.
    # 🔑 A defect recorded next to the code is not a defect fixed.
    #
    # The refusal below still stands on its own: it is the mirror of the ovs4 defect fixed
    # earlier on 08-21 (4-host fabric, 128-host Ryu model). Refused here rather than checked
    # afterwards, because the size is decided by which verb runs and nothing downstream can
    # change it -- which remains the right shape even now that the downstream check works.
    if [[ "$ovs_hosts" != 4 && "$ovs_hosts" != 128 ]]; then
        err "OVS can only build 4 or 128 hosts, not $ovs_hosts."
        err "  128 comes from NTG's testbed_topo.py, 4 from tools/test_workflow/ovs_4host_topo.py;"
        err "  neither takes a host count, so 'ndt up ovs $ovs_hosts' would build 128 and a model"
        err "  of $ovs_hosts would be loaded beside it."
        err "  use:  ndt up ovs   (128)   |   ndt up ovs4   (4)   |   ndt up p4 $ovs_hosts"
        return 2
    fi
    # One call, three answers -- see the note in up_p4: TOPO_REFUSAL set inside a command
    # substitution dies with the subshell.
    local ovs_topo ovs_trc ovs_both ovs_rest
    ovs_both="$(topo_for_hosts "$ovs_hosts" ovs; printf '\t%s\t%s' "$?" "$TOPO_REFUSAL")"
    # The same stray newline as up_p4's -- see the long note at that site. Two sites, because
    # these are two copies of the same three lines; one plane fixed is not both.
    ovs_topo="${ovs_both%%$'\t'*}"; ovs_topo="${ovs_topo%%$'\n'*}"; ovs_rest="${ovs_both#*$'\t'}"
    ovs_trc="${ovs_rest%%$'\t'*}"; TOPO_REFUSAL="${ovs_rest#*$'\t'}"
    if (( ovs_trc == 3 )); then
        err "refusing to build: ${TOPO_REFUSAL:-NDT_TOPO does not match the host count}"
        err "  on OVS the size is the VERB -- ovs-topo-start builds 128, ovs-topo-4host builds"
        err "  4 -- so nothing here can make the fabric follow the model NDT_TOPO names. (H4)"
        # 🔴 rc 5: the same refusal up_p4 gives. One plane changed is not both.
        return 5
    fi
    if [[ -z "$ovs_topo" ]]; then
        err "no OVS topology model in setting/ has $ovs_hosts hosts"
        return 1
    fi
    # Inverted order: Ryu must be listening before the switches dial out, so stack.sh has to
    # start first and then block on its prompt while the fabric is built. The prompt cannot be
    # waited for by reading stdout -- `read -p` writes to /dev/tty, and on a FIFO stdin the
    # string never arrives -- so this waits on the "[2/3]" banner that precedes it. Getting
    # that wrong does not hang, it does something worse: stack.sh proceeds and brings a proxy
    # up on an empty fabric that then serves perfectly normal-looking answers.
    local fifo out i n
    out="$(mktemp -t ndt_ovs_out.XXXXXX)"
    fifo="$(mktemp -u -t ndt_ovs_in.XXXXXX)"
    mkfifo "$fifo" || return 1

    say "ndt up ovs${ovs_hosts/128/}"
    info "hosts        $ovs_hosts"
    info "topology     ${ovs_topo#$REPO/}"
    # 🔴 The code is READ BEFORE the housekeeping. `rm -f ...; return $?` would return the rc
    # of `rm`, which is 0 -- a refusal silently becoming a successful bring-up.
    local pf_rc
    preflight ovs; pf_rc=$?
    (( pf_rc != 0 )) && { rm -f "$fifo" "$out"; return "$pf_rc"; }

    n="$(mn_count)"
    if [[ "$n" -gt 0 ]]; then
        err "a Mininet is already running ($n host/switch processes)."
        err "starting Ryu under a live Mininet is the /stats/flow wedge trigger."
        err "take it down first:  ndt down"
        rm -f "$fifo" "$out"; return 1
    fi

    # Same as up_p4: the target is recorded once every pre-lab refusal has passed and just
    # before the first thing that changes the machine. (#8, N12)
    local rut_rc
    record_up_target ovs "$ovs_hosts" "$ovs_topo"; rut_rc=$?
    (( rut_rc != 0 )) && { rm -f "$fifo" "$out"; return "$rut_rc"; }
    # [Co-developed with claude code -- Adam]
    # 🔴 THE OVS PLANE CLEARS THE APP KNOB TOO, and it is not housekeeping. The knob is P4-only
    # in the sense that only P4 readers act on it -- which is exactly why an OVS round is where
    # a stale one survives unnoticed. The next `ndt up p4 4` in this checkout would then build
    # somebody's exercise fabric under a banner reading `app package  none`. Same placement
    # rule as everything else here: after the last refusal, before the first thing that changes
    # the machine. `--app` on this plane was refused at the dispatch, so there is never a
    # package to keep.
    app_knob_clear "this 'ndt up ovs' does not use one" || { rm -f "$fifo" "$out"; return 1; }
    claim_note_up "ovs $ovs_hosts"

    say "[1/4] control plane (Ryu)"
    # NDTWIN_RYU_TOPO_FILE is set to the SAME file as TOPO_OVS, and that is the whole point.
    #
    # TOPO_OVS is the kernel's model. Ryu reads its own, from this variable
    # (intelligent_router.py:36-38), defaulting to the 128-host Mininet model regardless of
    # how many hosts the fabric actually has. Until 2026-08-21 `ndt` set only the first, so
    # `ndt up ovs4` built a 4-host fabric, gave the kernel the 4-host model, and let Ryu
    # install routes for 128 hosts: 100% loss between every pair, while the kernel's graph,
    # Ryu's /v1.0/topology/hosts and this script's own "model matches fabric" all read
    # correct. Found by another session, reproduced here.
    #
    # The variable had exactly one reader and no automated setter anywhere -- the only
    # `export` in the repo was a hand-typed line in a report from the 2026-08-17 round, which
    # is why that round's numbers are sound and every unattended run since was not. This is
    # the mirror image of NDTWIN_CLONE_DISABLE, which has setters and no reader.
    # [Co-developed with claude code -- Adam]
    # Recorded before the launch: this is the first thing in up_ovs that changes the machine,
    # and by the time it has failed Ryu may already own :8080/:6653/:6633. See rollback_up.
    up_started stack
    ( cd "$REPO" && TOPO_OVS="$ovs_topo" NDTWIN_RYU_TOPO_FILE="$ovs_topo" \
        CONVERGE_WAIT="${CONVERGE_WAIT:-400}" NO_COLOR=1 \
        bash "$STACK" up ovs > "$out" 2>&1 < "$fifo" ) &
    local stack_pid=$!
    exec 3> "$fifo"

    for i in $(seq 1 90); do
        grep -q '2/3' "$out" && break
        kill -0 "$stack_pid" 2>/dev/null || {
            err "stack.sh exited early"; sed 's/^/      /' "$out"
            exec 3>&-; rm -f "$fifo" "$out"
            rollback_up "stack.sh exited before the Mininet prompt; Ryu may already hold :6653"
            return 1; }
        sleep 1
    done
    if ! grep -q '2/3' "$out"; then
        err "Ryu never reached the Mininet prompt"; sed 's/^/      /' "$out"
        exec 3>&-; kill "$stack_pid" 2>/dev/null; rm -f "$fifo" "$out"
        # `kill $stack_pid` ends the shell that launched Ryu, not Ryu: start_bg setsids it into
        # its own process group, which is precisely why a failed `ndt up ovs4` left :8080/:6653/
        # :6633 bound on 09-02. stack.sh down is the thing that knows how to stop it.
        rollback_up "Ryu never reached the Mininet prompt"
        return 1
    fi
    ok "Ryu up, prompt reached"

    say "[2/4] data plane (OVS fabric)"
    up_started fabric
    sudo -n "$LAB" "$ovs_verb" >/dev/null || {
        err "$ovs_verb failed"; exec 3>&-; rm -f "$fifo" "$out"
        rollback_up "$ovs_verb failed; it may still have left a topo session behind"
        return 1; }
    # Wait on the HOST count, not on "at least N processes". `-ge` against hosts+10 was
    # satisfied by any fabric at least that big -- 139 >= 26 -- which is how a 128-host fabric
    # passed for 16. [Co-developed with claude code -- Adam]
    local want_procs=$(( ovs_hosts + 10 )) live_hosts
    for i in $(seq 1 300); do
        live_hosts="$(fabric_host_count)"
        [[ "$live_hosts" -eq "$ovs_hosts" ]] && break
        sleep 1
    done
    live_hosts="$(fabric_host_count)"
    n="$(mn_count)"
    if [[ "$live_hosts" -ne "$ovs_hosts" ]]; then
        err "fabric has $live_hosts hosts, expected $ovs_hosts"
        exec 3>&-; kill "$stack_pid" 2>/dev/null; rm -f "$fifo" "$out"
        rollback_up "the fabric built $live_hosts hosts, not $ovs_hosts"
        return 1
    fi
    if [[ "$n" -lt "$want_procs" ]]; then
        err "fabric did not build: $n host/switch processes"
        exec 3>&-; kill "$stack_pid" 2>/dev/null; rm -f "$fifo" "$out"
        rollback_up "the data plane did not build ($n host/switch processes)"
        return 1
    fi
    ok "$n host/switch processes after ${i}s"

    say "[3/4] proxy-less convergence + kernel"
    # Was "a hard-coded 60s sleep, so this takes >60s", then "default 10". The default is 40 as
    # of 2026-08-22 and the whole `ndt up ovs` takes ~52s; 10 is known to leave the twin unable
    # to see 128 of its own hosts (doc/audit/2026-08-22_settle-gate-acceptance/).
    #
    # This message has now been wrong twice, in both directions, for the same reason: the
    # fallback here is a SECOND copy of a default that lives in intelligent_router.py, and
    # nothing makes them move together. Read it from the source of truth instead, so the next
    # change to that default cannot leave this line lying. [Co-developed with claude code -- Adam]
    local settle_default
    settle_default="$(grep -oP 'NDTWIN_RYU_SETTLE_S", "\K[0-9]+' "$REPO/intelligent_router.py" 2>/dev/null)"
    info "Ryu settles for ${NDTWIN_RYU_SETTLE_S:-${settle_default:-?}}s before installing paths (NDTWIN_RYU_SETTLE_S)"
    echo "" >&3
    wait "$stack_pid"; local rc=$?
    exec 3>&-; rm -f "$fifo"
    if (( rc != 0 )); then
        # The measured case, 2026-09-02 23:36: stack.sh's [3/3] refused :8000 and `ndt up`
        # returned here, leaving Ryu, the topo session and 15 processes running with no kernel.
        err "stack.sh up ovs exited $rc"; tail -20 "$out" | sed 's/^/      /'; rm -f "$out"
        rollback_up "stack.sh could not bring the kernel up over this fabric"
        return 1
    fi
    grep -E 'started|converged|up$|already running|DIFFERENT command' "$out" | sed 's/^/      /'
    rm -f "$out"

    # 🔴 From here on nothing rolls back, and that is the decision rather than an omission. The
    # stack is UP; what follows can only report that it does not measure what it should. That is
    # the state an operator has to be able to look at -- "up, but not verified" already says
    # what it is -- and tearing it down would answer a question nobody asked. rollback_up is for
    # a bring-up that could not finish. [Co-developed with claude code -- Adam]
    say "[4/4] verify"
    local graph
    graph="$(curl -sf --max-time 5 http://localhost:8000/ndt/get_graph_data \
             | python3 -c "
import json,sys
d=json.load(sys.stdin)
sw=[n for n in d.get('nodes',[]) if n.get('vertex_type')==0]
print(len(sw), sum(1 for n in sw if n.get('is_up')), sum(1 for n in sw if n.get('is_enabled')),
      sum(1 for n in d.get('nodes',[]) if n.get('vertex_type')==1), len(d.get('edges',[])))" 2>/dev/null)"
    [[ -z "$graph" ]] && { err "kernel: no usable answer from /ndt/get_graph_data"; return 1; }
    read -r total up enabled hosts edges <<<"$graph"

    # What the topology file says the kernel should have ended up with.
    local want; want="$(python3 -c '
import json,sys; t=json.load(open(sys.argv[1]))
print(sum(1 for n in t["nodes"] if n.get("vertex_type")==1), len(t["edges"]))' "$ovs_topo" 2>/dev/null)"
    local want_hosts="${want% *}" want_edges="${want#* }"

    local rc=0
    if [[ "$total" == "$SWITCHES" && "$up" == "$SWITCHES" && "$enabled" == "$SWITCHES" ]]; then
        ok "kernel: $total switches up+enabled"
    else
        err "kernel: $total switches, $up up, $enabled enabled (want $SWITCHES)"
        rc=1
    fi
    # Asserted, not just printed. Ryu's link count is not monotonic during discovery --
    # measured 2026-08-20: links went 32 -> 31 -> 29 -> 32 while converging, and stack.sh's
    # gate releases on the first exact match. The kernel then pulls the topology once and
    # never retries, so a pull landing in a dip leaves it permanently short of edges with
    # nothing logged. Comparing against the file is what would catch that.
    # Named for what it compares. It reads the kernel's graph against the topology FILE, and
    # both sides come from TOPO_OVS -- so for host count it is close to tautological, and
    # calling it "model matches fabric" claimed a guarantee it does not give. What it does give
    # is real and is the reason it exists (see above): a kernel that pulled during a link-count
    # dip shows fewer edges than the file declares. The fabric itself is checked by the host
    # count above. [Co-developed with claude code -- Adam]
    if [[ "$hosts" == "$want_hosts" && "$edges" == "$want_edges" ]]; then
        ok "kernel graph matches the model file: $hosts hosts, $edges edges"
    else
        err "model/fabric mismatch: kernel has $hosts hosts / $edges edges," \
            "topology file says $want_hosts / $want_edges"
        err "the kernel pulls once and never retries -- restart it rather than trusting this"
        rc=1
    fi

    verify_dataplane h1 10.0.0.2 \
        "Ryu computes routes from NDTWIN_RYU_TOPO_FILE, not from the fabric. Check that
   the Ryu process has it set to ${ovs_topo#$REPO/}" || rc=1

    # Telemetry is verified beside forwarding, and for the same reason the forwarding check
    # exists: every structural view above can be correct while the thing the operator is about
    # to measure reports nothing. Finding #4 is that case -- ten bridges with `sflow=[]`, a
    # green bring-up, and `avg_link_usage` pinned at 0.0 under real traffic.
    # [Co-developed with claude code -- Adam]
    verify_sflow "$ovs_topo" || rc=1

    echo
    if (( rc == 0 )); then
        say "up. ${G}ready${N}"
        lab_entry_points ovs
    else
        say "up, ${R}but not verified${N}"
    fi
    return $rc
}

# --- down -------------------------------------------------------------------------

# wait_reaped <budget-seconds> -- wait, up to a bound, for the processes the sweep has just
# signalled to actually leave the process table. Then let the caller assert.
#
# [Co-developed with claude code -- Adam]
# FINDING #49. `ndt down` printed "XX bmv2 switches: 5 still running" and "not clean", and
# `ps -eo comm=` counted 0 of them twenty seconds later (round3-restart-concurrency, 15_,
# 2026-09-03). Nothing was wrong with the teardown. The verdict was taken before the machine
# had finished agreeing with it: a kill is a request to the kernel, not an event that has
# already happened, and `mn -c` -- which is what removes the host namespaces -- forks its own
# children to do it. The verify and the sweep were simply not synchronised.
#
# 🔴 Fixed on THIS side rather than in the helper, and that is not a preference. `ndt` runs
# from the repo, so this takes effect immediately; the sweep runs from /usr/local/sbin/
# ndtwin-lab, which on this machine is the 08-30 copy whose cleanup is `pkill -f ... || true`
# with no wait at all and no rc (finding #83). A wait added to the helper would not execute
# here until somebody runs `sudo install`. This one works under either helper.
#
# 🔴 A WAIT, not a retry-until-green. The bound is real: when it expires the assertion runs
# anyway, against whatever is actually there. A loop that ended when the machine finally looked
# clean would be #49 with the sign flipped -- a genuine leftover reported as a clean teardown,
# which is strictly worse than the false negative it replaces.
#
# 🔴 And it says it waited. "clean, after 6.0s" and "clean" are different statements: the first
# one says the sweep was slow, which is the fact that was invisible.
#
# Deliberately NOT inside cmd_clean. `ndt clean` is the teardown ASSERTION, separately callable
# to ask "is this machine clean right now"; giving that question a 20-second wait would answer
# a different one.
wait_reaped() {
    local budget="${1:-20}" i n0 m0 n m ticks=0
    n0="$(bmv2_count)"; m0="$(mn_count)"
    [[ "$n0" -eq 0 && "$m0" -eq 0 ]] && return 0
    for (( i = 0; i < budget * 2; i++ )); do
        sleep 0.5
        ticks=$(( ticks + 1 ))
        n="$(bmv2_count)"; m="$(mn_count)"
        if [[ "$n" -eq 0 && "$m" -eq 0 ]]; then
            info "waited $(( ticks / 2 )).$(( (ticks % 2) * 5 ))s for $n0 bmv2 + $m0 host/switch process(es) to be reaped"
            return 0
        fi
    done
    warn "still $(bmv2_count) bmv2 and $(mn_count) host/switch process(es) after ${budget}s;"
    warn "not waiting further -- the assertion below reports what is actually there"
    return 1
}

# --- a teardown that is still running ---------------------------------------------
#
# [Co-developed with claude code -- Adam]
# 🔴 H3, measured live by ROLE-2 on 2026-09-11 (ROLE-2-CYCLES-REPORT §4, cycle-13). A second
# `ndt up p4` thirteen seconds after a backgrounded `ndt down`:
#
#   * preflight saw :30051-30060 and :9091-9100 still held by the DYING fabric and answered
#     `unknown` rather than refusing -- correctly, on its own terms: bmv2 runs as root, so a
#     live P4 fabric always looks like that (the reuse path depends on it);
#   * [1/3] printed `ok already up: 10 switches, 4 hosts, reusing` -- it reused a fabric that
#     was being torn down;
#   * [3/3] then PASSED `ok model matches fabric: 4 hosts (kernel graph, topology file and 4
#     host namespaces all agree)`, with the next line in the log a bare `Terminated`;
#   * it ended `h1 cannot reach 10.0.0.2 -- fabric is up but not forwarding`, which is the
#     wrong diagnosis: the fabric was not failing to forward, it no longer existed;
#   * the background `down` then reported the SECOND up's brand-new kernel and proxy as
#     residue -- `residue: ndtwin_kernel pid 1916426 holding :8000` -- and advised
#     `ndt down --deep`, which would have killed what the operator had just started;
#   * and its clear_up_target removed the second up's baseline, so `--check` fell from rc 1
#     (which could still state facts) to rc 3, "COULD NOT CHECK", exactly when a live half
#     stack most needed describing.
#
# On the OVS plane the same overlap is refused cleanly one second in, because mn_count() sees
# the Mininet still standing: `a Mininet is already running (15 host/switch processes)`. The
# P4 plane has no such reading -- bmv2 is root-owned and its ports look identical whether the
# fabric is coming up, up, or going down -- so the missing fact was never observable from the
# machine. It has to be RECORDED, by the only process that knows: the teardown itself.
#
# 🔴 A marker, not a lock. It says "pid N is tearing down, since T", and a bring-up refuses on
# it. What it must never do is outlive the teardown -- a crashed `down` that made every later
# `up` impossible would be worse than the overlap -- so the reader verifies the pid is alive
# and removes the marker itself when it is not.
down_marker() { echo "${NDT_DOWN_MARKER:-$REPO/.test_run/down.inflight}"; }

# teardown_in_flight -- "<pid> <at>" while an `ndt down` from this checkout is running; rc 1
# otherwise. A marker whose pid is gone is STALE: it is removed here, out loud, and reported as
# no teardown. Same checkout and same user, so `kill -0` is the whole test.
teardown_in_flight() {
    local f pid at
    f="$(down_marker)"
    [[ -f "$f" ]] || return 1
    pid="$(sed -n 's/^pid=//p' "$f" | head -1)"
    at="$(sed -n 's/^at=//p' "$f" | head -1)"
    if [[ ! "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; then
        warn "removing a stale teardown marker: pid ${pid:-?} (recorded ${at:-?}) is gone." >&2
        warn "  a crashed 'ndt down' must not make every later bring-up impossible. (${f#$REPO/})" >&2
        rm -f "$f"
        return 1
    fi
    printf '%s %s\n' "$pid" "${at:-?}"
    return 0
}

# teardown_in_flight_refusal <action> <"pid at"> -- the two lines every refusal about a teardown
# that is already running opens with. One function, because three commands now refuse on this
# one fact -- a bring-up would reuse the fabric being destroyed, a second teardown would steal
# the marker, and `clean` would call that fabric residue -- and three hand-written versions of
# one sentence drift apart. ROLE-12 read the pid out of one of them and it was the wrong pid;
# that is only legible at all because every refusal prints it in the same place.
teardown_in_flight_refusal() {
    local action="$1" tif="$2"
    err "refusing to $action: an 'ndt down' from this checkout is still running."
    err "  pid ${tif%% *}, started ${tif#* }   ($(down_marker | sed "s|^$REPO/||"))"
}

# [Co-developed with claude code -- Adam]
# 🔴 ROLE-12, measured 2026-09-12 02:07:18-02:07:32 (hunt-0911/logs/ROLE-12/c2b-*, the marker
# sampled every 0.2 s). This marker had no OWNER: the write was an unconditional `pid=$$` and
# the removal an unconditional `rm -f`, so two `ndt down`s 3 s apart did this --
#
#   02:07:18.107  D1 writes the marker, pid=2455882.
#   02:07:22.115  D2 overwrites it with ITS pid while D1 is still alive, so for the next 11 s
#                 every bring-up that was refused named the wrong process.
#   02:07:32.687  D1 finishes first and removes the marker. The marker was D2's. D2 is alive.
#   02:07:32.691  `ndt up p4 4` is NOT refused, exits 0, and reaches [3/3].
#
# H3's guard, switched off by an overlap -- which is the only situation it exists for. Two
# rules, one missing word: a marker held by a LIVE process is not yours to overwrite, and a
# marker that does not name your pid is not yours to remove.
mark_teardown_start() {
    local f pid at tif
    f="$(down_marker)"
    pid=""; at=""
    if [[ -f "$f" ]]; then
        pid="$(sed -n 's/^pid=//p' "$f" | head -1)"
        at="$(sed -n 's/^at=//p' "$f" | head -1)"
    fi
    # teardown_in_flight is the single reader of staleness -- it removes a marker whose pid is
    # gone, out loud, and reports no teardown -- so asking it here needs no second copy of that
    # rule, and the dead-marker case keeps behaving exactly as the bring-up guard does.
    if tif="$(teardown_in_flight)"; then
        if [[ "${tif%% *}" != "$$" ]]; then
            teardown_in_flight_refusal "tear down" "$tif"
            err "  two teardowns of one lab do not take turns. The second would overwrite this"
            err "  marker with its own pid, and whichever finished first would remove the"
            err "  other's -- measured 09-12 02:07:32: the marker went away while the teardown"
            err "  that owned it was still running, and the next 'ndt up p4 4' was not refused"
            err "  and built on the fabric being destroyed. That is H3 with the guard removed."
            err "  wait for it to finish, then run 'ndt down'."
            return 1
        fi
        # Our own marker. `cmd_down` re-entered, or wrote it earlier in this same process;
        # rewriting it changes nothing, and refusing here would refuse ourselves.
    elif [[ -n "$pid" ]]; then
        info "taking over the teardown marker left by pid $pid (recorded ${at:-?}): that"
        info "  process is gone, so nothing is being torn down under it."
    fi
    mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
    printf 'pid=%s\nat=%s\nby=%s\n' "$$" "$(date '+%Y-%m-%dT%H:%M:%S%z')" "${NDT_OWNER:-unset}" > "$f"
}

# 🔴 Only ours. The unconditional `rm -f` this replaces is the half of ROLE-12 that actually
# took the guard away: the teardown that finished first deleted the marker of the one still
# running. A marker this process did not write is left where it is, and said so -- silence here
# would be indistinguishable from having removed it.
mark_teardown_end() {
    local f pid; f="$(down_marker)"
    [[ -f "$f" ]] || return 0
    pid="$(sed -n 's/^pid=//p' "$f" | head -1)"
    if [[ "$pid" == "$$" ]]; then rm -f "$f"; return 0; fi
    warn "leaving the teardown marker in place: it records pid ${pid:-?}, not this process ($$)."
    warn "  removing it would take the H3 guard away from a teardown that is still running."
}

# guard_no_teardown_in_flight -- the refusal. Called from preflight, which is the one thing both
# planes run before the machine is touched.
guard_no_teardown_in_flight() {
    local tif; tif="$(teardown_in_flight)" || return 0
    teardown_in_flight_refusal build "$tif"
    err "  a bring-up that overlaps a teardown does not fail cleanly -- it REUSES the fabric"
    err "  being destroyed. Measured 09-11: [1/3] said 'already up: 10 switches, reusing',"
    err "  [3/3] passed 'model matches fabric', and the fabric was mid-SIGTERM. The teardown"
    err "  then reported this run's own kernel and proxy as residue and advised 'ndt down"
    err "  --deep', which would have killed them."
    err "  wait for it to finish, then bring up. On OVS this was already refused by"
    err "  mn_count (a Mininet is already running); bmv2 is root-owned and its ports look the"
    err "  same coming up and going down, so on P4 nothing could see it. (H3)"
    return 1
}

