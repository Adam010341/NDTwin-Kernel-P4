# flow_table_rows -- flow-entries JSON on stdin, how many rows the WHOLE table holds, or
# UNREADABLE. Counts, and decides nothing: the sentence the count produces is in residue_report.
#
# [Co-developed with claude code -- Adam]
# G-55. "0 rules in this app's window" and "0 rules anywhere" are two different readings and
# residue_report printed one sentence for both, so the table's own size is read ONCE per report
# -- before the per-app loop, which is the only place a reader can be told that everything below
# it is about an empty table. It is a separate fetch-free call rather than a number smuggled out
# of residue_rule_lines, because that function runs once per app and is not reached at all when
# no app has a window: on an idle machine the size of the table would then never be read.
#
# 🔴 `3<&0` BEFORE the heredoc, for the reason residue_rule_lines' header gives: `python3 -`
# takes the script itself on stdin, so a json.load(sys.stdin) here would parse the end of its own
# source and report every table as UNREADABLE -- an "empty table" sentence that never appears,
# produced by a plumbing bug, which is the exact shape G-12 is about.
flow_table_rows() {
    python3 - 3<&0 <<'PY'
import json, os, sys
# 🔴 `switch`, not `sw`, and the NAME is load-bearing -- the same lesson as proc_checkout's
# `pargv`. suspect_rules() above iterates `for sw in entries or []:` and
# tests/shell/mutate_apps_stop_lists_rules.sh anchors a mutation on that exact line; a second
# byte-identical copy makes the anchor match twice, and an ambiguous anchor mutates a site the
# gate was not named for. check_gate_anchors.py reports it as DUP, which is how this one was
# caught (2026-09-12, count 2 want 1).
try:
    entries = json.load(os.fdopen(3))
    n = 0
    for switch in entries or []:
        for _key, rows in sorted((switch.get("flows") or {}).items()):
            n += len(rows or [])
except Exception:
    print("UNREADABLE"); sys.exit(0)
print(n)
