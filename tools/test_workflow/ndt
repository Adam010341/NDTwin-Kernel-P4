}

# lock_probe <type> -- "held <lease> <retry_after_s>" | "free" | "unknown <why>".
#
# 🔴 There is no read-only way to ask. The kernel exposes acquire/release/renew and nothing
# else: `grep -o '/ndt/[a-z_]*' src/ndt_core/http/HttpSession.cpp` lists no lock-status route.
# So the question is asked the only way it can be -- by acquiring -- with `ttl: 0`, which the
# API documents as "already expired, not unlimited": the acquire it performs on a FREE lock
# excludes nobody, because a second caller's acquire succeeds immediately. That is the least
# invasive probe this kernel offers, and it is still a POST, so it is named as a probe in the
# output rather than presented as a reading.
#
# Its one side effect: on a lock whose holder let the TTL run out without releasing, this
# reclaims that dead lease, so the NEXT legitimate acquire sees reclaimed_expired_lease false
# where it would have seen true. An expired lease was already available to anyone; what is lost
# is a breadcrumb, and it is lost only in the case where the holder had already gone.
lock_probe() {
    local t="$1" out code body
    out="$(curl -s --max-time 5 -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' \
        -d "{\"type\":\"$t\",\"ttl\":0}" http://localhost:8000/ndt/acquire_lock 2>/dev/null)"
    [[ -n "$out" ]] || { echo "unknown :8000 gave no answer"; return 0; }
    code="${out##*$'\n'}"; body="${out%$'\n'*}"
    case "$code" in
        423) echo "held $(json_field "$body" held_by_lease) $(json_field "$body" retry_after_s)" ;;
        200) echo "free" ;;
        *)   echo "unknown http ${code:-none}" ;;
    esac
}

# json_field <json> <key> -- one top-level scalar, or "?" . Never guesses on malformed input.
json_field() {
    printf '%s' "$1" | python3 -c '
import json,sys
try: d = json.load(sys.stdin)
except Exception: print("?"); sys.exit(0)
v = d.get(sys.argv[1]) if isinstance(d, dict) else None
print("?" if v is None else v)' "$2" 2>/dev/null || echo "?"
}

# residue_rule_lines <started-epoch> <now-epoch> <plane> [<window-end-epoch>] -- flow entries
# JSON on stdin, one line per rule that cannot be excluded from this app's window. A leading
# `CANNOTWINDOW <reason>` line means the plane has no time axis at all and everything after it is
# UNKNOWN.
#
# [Co-developed with claude code -- Adam]
# F3. The fourth argument is the window's RIGHT edge and is empty for a live app, whose window
# runs to now. It exists because a window read from disk (app_window_read) belongs to an app that
# has already stopped, and a rule installed after it stopped is somebody else's.
residue_rule_lines() {
    # 🔴 `3<&0` BEFORE the heredoc, and the JSON is read from fd 3. `python3 - <<'PY'` takes the
    # script itself on stdin, so a `json.load(sys.stdin)` here reads the end of its own source
    # and reports the flow table as unreadable -- a clean-looking "no residue" produced by a
    # plumbing bug, which is the exact failure shape G-12 is about. Redirections apply left to
    # right, so fd 3 is the caller's pipe and fd 0 is the script.
    python3 - "$1" "$2" "${3:-unknown}" "${4:-}" 3<&0 <<'PY'
import json, os, sys
# --- BEGIN residue_rules (pure; extracted verbatim by tests/python/test_app_residue_rules.py) ---
# Imported inside the markers as well as above them: the test execs this region on its own, and
# a region that only works because of a line outside it is a region the test is not testing.
import json


def _age(sec):
    sec = int(sec)
    if sec < 60:
        return "%ds" % sec
    if sec < 3600:
        return "%dm%02ds" % (sec // 60, sec % 60)
    return "%dh%02dm" % (sec // 3600, (sec % 3600) // 60)


def _all_rows(entries):
    """Every flow row in the endpoint's per-switch envelope, flat."""
    return [f for sw in entries or []
            for _k, rows in sorted((sw.get("flows") or {}).items())
            for f in rows or []]


def _no_time_axis(f):
    """duration_sec AND duration_nsec both exactly 0 -- a counter with no clock behind it.

    🔴 Measured 2026-09-07 (W16-3, P4 4 hosts, trunk 862c4bf8, logs/w163-*): a route was
    installed on the P4 plane and /ndt/get_switch_openflow_table_entries read twice, +12 s and
    +32 s later. That entry and EVERY pre-existing entry reported duration_sec 0 and
    duration_nsec 0, while packet_count and byte_count moved. p4_proxy/proxy_agent/
    ryu_flow_stats.py synthesises these rows and has no install time to put in them.

    A real switch does not produce this pair: OpenFlow's duration is (sec, nsec) since install,
    so a rule installed under a second ago has duration_sec 0 and a NON-zero nsec, and one
    installed longer ago has a non-zero sec. Both zero is the synthetic signature -- and read
    as "0 seconds ago" it dates every rule on the plane to right now, i.e. inside every window.
    """
    dur, nsec = f.get("duration_sec"), f.get("duration_nsec")
    if not isinstance(dur, int) or isinstance(dur, bool) or dur != 0:
        return False
    return not (isinstance(nsec, int) and not isinstance(nsec, bool) and nsec > 0)


def window_blindspot(entries, plane):
    """Why NO rule on this plane can be dated -- '' when they can.

    Two ways to be blind, and both are stated rather than worked around:
      * the plane is P4. Its flow stats are synthesised by the proxy and carry no time axis at
        all, so the answer does not depend on what happens to be in the table right now.
      * every row in the table reports duration 0/0. That is the same synthetic signature seen
        from the data instead of from the plane, and it covers a P4 table read through a path
        that did not tell us the plane.
    """
    if plane == "p4":
        return ("the P4 plane synthesises flow stats (proxy_agent/ryu_flow_stats.py) and they"
                " carry NO install time")
    rows = _all_rows(entries)
    if rows and all(_no_time_axis(f) for f in rows):
        return ("every flow entry in this table reports duration_sec=0 AND duration_nsec=0 --"
                " a counter with no clock behind it")
    return ""


def suspect_rules(entries, started, now, plane="unknown", until=None):
    """Rules that cannot be excluded from the window [started, until or now], as printable lines.

    SUSPECTED, never attributed: there is no owner and no usable cookie anywhere in this
    system (see the block comment above app_started_at in `ndt`), so the only discriminator
    is when a rule arrived. `duration_sec` is the switch's own answer to that.

    🔴 A rule that does not say how old it is is NOT excluded. "Could not tell" and "not this
    app's" are different answers, and a residue report that silently drops the first one is
    the same failure G-12 is about -- an existing verb going green over something it never
    looked at. Those rules are listed with age UNKNOWN and counted separately.

    🔴 AND A ZERO IS NOT AN AGE. W16-3, decided after the 09-07 P4 run above: on the P4 plane
    duration is 0/0 for every rule, so believing it dates the whole table to "just installed"
    -- inside every window, however short. That is worse than listing nothing, because a
    caller cannot tell a table full of genuine residue from a plane that cannot answer. Those
    rows go to UNKNOWN, and window_blindspot() says once, at the top, that the plane is blind.
    """
    inside, unknown = [], []
    blind = plane == "p4"
    # 🔴 F3. `until` closes the window on the right. It is None for every app that is still
    # running -- their window really does run to now -- and a timestamp for a window read back
    # from a stop's own record, where a rule installed after the app stopped is NOT that app's
    # residue. Without the bound, a record kept on disk would attribute the whole of the
    # fabric's later traffic to an app that stopped yesterday, which is a verb that is red
    # forever, i.e. one nobody reads.
    stop = now if until is None else int(until)
    for sw in entries or []:
        dpid = sw.get("dpid")
        for _key, rows in sorted((sw.get("flows") or {}).items()):
            for f in rows or []:
                pri = f.get("priority")
                match = json.dumps(f.get("match", {}), sort_keys=True)
                acts = json.dumps(f.get("actions", []))
                head = "dpid=%s table=%s pri=%s match=%s actions=%s" % (
                    dpid, f.get("table_id"), pri, match, acts)
                dur = f.get("duration_sec")
                if not isinstance(dur, int) or isinstance(dur, bool) or dur < 0:
                    unknown.append(head + "  age=UNKNOWN (no usable duration_sec -- it can be"
                                          " placed neither inside nor outside the window)")
                    continue
                if blind:
                    unknown.append(head + "  age=UNKNOWN (P4 plane: synthesised flow stats"
                                          " carry no install time)")
                    continue
                if _no_time_axis(f):
                    unknown.append(head + "  age=UNKNOWN (duration_sec=0 AND duration_nsec=0:"
                                          " a synthesised counter, not a rule installed now)")
                    continue
                if now - dur < started:
                    continue
                if now - dur > stop:
                    continue
                inside.append((dpid, pri, head + "  installed %s ago" % _age(dur)))
    inside.sort(key=lambda r: (str(r[0]), -(r[1] or 0)))
    return [r[2] for r in inside] + unknown
# --- END residue_rules ---

started, now = int(sys.argv[1]), int(sys.argv[2])
plane = sys.argv[3]
# Empty means the window is open: this app is running, so it runs to `now`.
until = int(sys.argv[4]) if len(sys.argv) > 4 and sys.argv[4] else None
try:
    entries = json.load(os.fdopen(3))
except Exception:
    print("UNREADABLE"); sys.exit(0)
blind = window_blindspot(entries, plane)
if blind:
    print("CANNOTWINDOW " + blind)
for line in suspect_rules(entries, started, now, plane, until):
    print(line)
PY
}

# --- what the residue report FOUND, as counts, so a caller can have an exit code -------------
#
# [Co-developed with claude code -- Adam]
# W16-1/W16-2 (Adam's decision 09-06, grill §4D round 7, AGAINST the recommendation that this
# stay report-only): residue must turn `ndt apps orphans` and `ndt status --check` red. The
# counting is separated from the printing for the same reason check_up_target separates _ut_row
# from _ut_differs: printing a finding and reporting it are two acts, and a gate must be able to
# delete the second and leave a report that still looks like it is working.
#
# Four numbers, not one, because they mean four different things to a caller:
#   RESIDUE_RULES      rules that were DATED and fell inside an app's window   -> something is there
#   RESIDUE_LOCKS      locks held right now                                    -> something is there
#   RESIDUE_UNDATABLE  rules listed with age=UNKNOWN                           -> could not place them
#   RESIDUE_BLIND      questions that could not be asked at all                -> could not look
#
# [Co-developed with claude code -- Adam]
# 🔴 3-51 adds a FIFTH, and it is deliberately not one of the four above:
#   RESIDUE_UNKNOWABLE apps whose "did it ever run here" cannot be asked at all
# The difference from RESIDUE_BLIND is the difference Adam drew on E-7 ("查不了可以不紅，沒去查
# 不准長得像查了沒事"): BLIND is a question this tool COULD have answered and did not get an
# answer to, and it is red. UNKNOWABLE is a question that has no channel to ask on this machine
# -- energy has no disk log because the lab helper never gives it one -- and making that red
# would put `ndt status --check` permanently in the red on every machine, for a fact about the
# helper that no operator can act on. It is NOT red; it is PRINTED, so the row cannot be read as
# "everything was asked and everything was clean".
RESIDUE_RULES=0
RESIDUE_LOCKS=0
RESIDUE_UNDATABLE=0
RESIDUE_BLIND=0
RESIDUE_UNKNOWABLE=0
RESIDUE_UNKNOWABLE_APPS=""
# [Co-developed with claude code -- Adam]
# G-55 adds a SIXTH, and like RESIDUE_UNKNOWABLE it is deliberately not one of the four above:
#   RESIDUE_EMPTY_TABLE  the flow table was read and it has nothing in it  -> 0 of 0, not 0 of N
#   RESIDUE_TABLE_ROWS   how many rows that reading found ("" = not read, UNREADABLE = not JSON)
# It changes no exit code. An empty table is the normal state of an idle lab, and a `--check`
# that went NOT CHECKED on it would be red on every clean machine; what it must not do is look
# like a window that excluded something.
RESIDUE_EMPTY_TABLE=0
RESIDUE_TABLE_ROWS=""

# RESIDUE_WINDOW[<app>] -- a window START read before something destroyed the record it came
# from. Filled only by `cmd_apps stop`; empty for every other caller.
#
# [Co-developed with claude code -- Adam]
# 🔴 3-51. `ndt apps stop <app>` verifies the app is gone, removes its pidfile, and THEN prints
# the residue report -- so the report ran after the command had deleted the only thing that
# could date the app, and printed "no pidfile and no live process -- no window" about the app it
# had just stopped. That is the one moment residue matters most: the rules are on the wire and
# the process that installed them is gone. Reading the window before the loop is the only order
# in which both are true.
declare -A RESIDUE_WINDOW=()

# residue_verdict -- the exit code for what residue_report last found.
#
#   0  looked at everything, and there is nothing on the network
#   4  RESIDUE: a rule inside a window, or a held lock. Something is there.
#   5  NOT CHECKED: the kernel was down, a reading failed, or the plane cannot be windowed.
#
# 🔴 4 and 5 are deliberately NOT 1. `ndt apps orphans` has answered 1 for "untracked app
# PROCESSES are running" since 09-02 and callers read it that way; reusing 1 would mean a
# script could not tell a live process from a leftover rule, and the two have different
# remedies (`ndt apps stop <name>` versus a hand-written delete_flow_entry).
# 🔴 An UNDATABLE rule is 5, not 4. "I found a rule I cannot place" is a failure to check, not
# a finding -- and on the P4 plane it is EVERY rule (W16-3), so calling it residue would make
# the verb red on every healthy P4 fabric and teach everyone to ignore it.
# 🔴 RESIDUE_UNKNOWABLE is NOT here, and that is Adam's E-7 ruling rather than an oversight: a
# question with no channel to ask it on cannot be answered by anyone at any time, so folding it
# in would make every verb red on every machine forever. What it must not do is disappear --
# see the row in status_residue_row and the tally line in residue_report.
residue_verdict() {
    (( RESIDUE_RULES > 0 || RESIDUE_LOCKS > 0 )) && return 4
    (( RESIDUE_UNDATABLE > 0 || RESIDUE_BLIND > 0 )) && return 5
    return 0
}

# status_residue_row -- W16-2: the one row `ndt status --check` prints about the network, and
# the problem entries it raises. Fills STATUS_RESIDUE_PROBLEMS.
#
# [Co-developed with claude code -- Adam]
# 🔴 THE ROW IS CALLED `rules-in-window` AND NOT `residue`, Adam's ruling 2026-09-12 12:3x
# (RESIDUE-1 §7-5). One word named two different findings in one tool: `ndt clean` prints
# `XX residue: ndtwin_kernel pid 2511227 holding :8000` -- a PROCESS holding a port, which
# `ndt down` removes -- and this row printed `residue N rule(s)` about FLOW RULES, which nothing
# in this tool deletes and which have a different remedy entirely (a delete_flow_entry by hand).
# A report that quoted both, one after the other, read as one finding twice (ROLE-11's row 21).
# The process half keeps the word; the network half is the one that moved, here and everywhere
# it is printed -- the `apps orphans` verdict lines, residue_report's heading and `ndt help`.
#
# 🔴 The FUNCTION names did not move (residue_report, residue_verdict, status_residue_row,
# RESIDUE_*), and that is deliberate: the ruling is about what an operator reads, and renaming
# the identifiers would rewrite every anchor in tests/shell/mutate_apps_stop_lists_rules.sh and
# tests/shell/mutate_ndt_*.sh in the same commit as a wording change, which is exactly how a
# rename stops being reviewable. Whoever renames them next should do it on its own.
# 🔴 RED ON 4, NOT ON 5, and the row says which it was on every run. Adam's ruling is "有殘留
# ⇒ rc 非 0" -- residue found, not residue unmeasurable. The difference matters because of
# W16-3, measured after that ruling: on the P4 plane NO rule can be dated at all, ever, so
# folding 5 into the verdict would make `ndt status --check` permanently red on every healthy
# P4 fabric -- and doc/2026-08-17_testing-manual.md:279 makes rc 0 the P4 acceptance criterion.
# A gate that can never pass is ignored within a day, which is how G-12's own green checks
# stopped being read. So 5 is printed, in words, saying it is NOT 'the network is clean'.
STATUS_RESIDUE_PROBLEMS=()
status_residue_row() {
    STATUS_RESIDUE_PROBLEMS=()
    if ! port_open 8000; then
        printf '  %-14s %s\n' "rules-in-window" "${Y}NOT CHECKED -- :8000 is closed, so no rule and no lock was read${N}"
        printf '  %-14s %s\n' "" "this is not 'the network is clean'. (G-12; the kernel rows above already fail)"
        return 0
    fi
    # shellcheck disable=SC2086
    residue_report $APP_NAMES >/dev/null 2>&1
    residue_verdict; local rrc=$?
    case "$rrc" in
        4) printf '  %-14s %s\n' "rules-in-window" "${R}$RESIDUE_RULES rule(s) inside an app window, $RESIDUE_LOCKS lock(s) HELD${N}"
           printf '  %-14s %s\n' "" "listed by:  ndt apps orphans      (nothing deletes them)"
           STATUS_RESIDUE_PROBLEMS+=("rules-in-window: $RESIDUE_RULES rule(s) installed inside an app's window and $RESIDUE_LOCKS held lock(s) -- 'ndt apps orphans' lists them (G-12)") ;;
        5) printf '  %-14s %s\n' "rules-in-window" "${Y}NOT CHECKED: $RESIDUE_UNDATABLE rule(s) could not be dated, $RESIDUE_BLIND question(s) unanswerable${N}"
           printf '  %-14s %s\n' "" "this is not 'the network is clean'; it is 'this plane cannot answer'."
           printf '  %-14s %s\n' "" "on P4 that is permanent (W16-3): its flow stats carry no install time."
           printf '  %-14s %s\n' "" "the locks WERE checked: $RESIDUE_LOCKS held.  details:  ndt apps orphans" ;;
        *) printf '  %-14s %s\n' "rules-in-window" "none -- 0 rule(s) in any app window, 0 lock(s) held (asked, not assumed)" ;;
    esac
    # [Co-developed with claude code -- Adam]
    # 🔴 G-55. `none ... (asked, not assumed)` above is a true sentence about an empty table and
    # a true sentence about a table full of rules none of which fell in a window, and until now
    # those were the SAME sentence -- the one row `--check` prints about the network said `none`
    # over a fabric whose table had not been programmed yet (CELLS-2 cell 1, 2026-09-12 15:00:47,
    # ten seconds after a converged bring-up). Printed under whichever branch ran, including the
    # red one, because "the rules I found were the whole table" is as much a qualifier on 4 as on
    # 0. It carries NO `listed by:` line: that string is bound to the red path and a live cell
    # reads its absence as the fix holding (CELLS-1 §7-1).
    if (( RESIDUE_EMPTY_TABLE > 0 )); then
        printf '  %-14s %s\n' "" "${Y}flow table read empty -- a window over an empty table frames nothing${N}"
        printf '  %-14s %s\n' "" "0 entry(s) on the whole plane, so the row above did not exclude anything:"
        printf '  %-14s %s\n' "" "it had nothing to exclude. within ~10s of 'ndt up' the table can still"
        printf '  %-14s %s\n' "" "be empty while the fabric is programmed. (G-55)"
    fi
    # [Co-developed with claude code -- Adam]
    # 🔴 3-51 / Adam's E-7 ruling: "查不了可以不紅，沒去查不准長得像查了沒事". This row is the
    # whole of what `--check` says about the network, and until 09-07 it printed
    # "none ... (asked, not assumed)" on a lab where energy and sim had never been asked anything
    # at all -- there was no channel to ask them on and nothing said so. Not red (nobody can act
    # on it, and a permanently red gate is an ignored gate), never invisible.
    if (( RESIDUE_UNKNOWABLE > 0 )); then
        printf '  %-14s %s\n' "" "${Y}$RESIDUE_UNKNOWABLE app(s) could not be asked whether they ran here: $RESIDUE_UNKNOWABLE_APPS${N}"
        printf '  %-14s %s\n' "" "the lab helper keeps no log for them, so 'nothing found' above excludes them."
    fi
    return 0
}

# residue_report <app>... -- print what these apps may have left on the network. NEVER deletes.
#
# One kernel fetch and one lock probe for the whole call, not one per app: `ndt apps stop all`
# would otherwise POST fifteen acquires to answer one question.
#
# Always returns 0: it is a report. The exit code lives in residue_verdict above, which reads
# the counters this fills in.
residue_report() {
    local now started entries lock t line n_rules n_unk n_locks=0 a any=0 lease retry
    local wend wrec wwhy wseal
    local plane blind_said="" elog rpid
    local -a live=()
    now="$(date +%s)"
    RESIDUE_RULES=0; RESIDUE_LOCKS=0; RESIDUE_UNDATABLE=0; RESIDUE_BLIND=0
    RESIDUE_UNKNOWABLE=0; RESIDUE_UNKNOWABLE_APPS=""
    RESIDUE_EMPTY_TABLE=0; RESIDUE_TABLE_ROWS=""

    say "rules-in-window (nothing below is deleted)"
    if ! port_open 8000; then
        warn "the kernel is not up (:8000 closed) -- rules and locks CANNOT be checked."
        warn "this is not 'the lab is clean'. it is 'nobody asked'. (KNOWN-ISSUES G-12)"
        RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 ))
        return 0
    fi
    # W16-3: which plane's flow table this is. On P4 the answer decides everything below -- its
    # stats are synthesised and have no time axis -- so it is read once, here, and passed down.
    plane="$(live_dataplane_kind)"
    entries="$(http_get_flow_entries)"
    if [[ -z "$entries" ]]; then
        warn "the kernel gave no flow table on :8000 -- rules NOT checked (not 'none found')."
        RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 ))
    else
        # [Co-developed with claude code -- Adam]
        # 🔴 G-55, measured 2026-09-12 15:00:47 (CELLS-2 cell 1). Said HERE, before the first
        # window, because it changes what every line under it means -- the same reason
        # CANNOT WINDOW is said once at the top rather than per rule.
        #
        # What was measured: a converged `ndt up ovs 4` (paths=installed, h1 -> 10.0.0.2
        # forwards, sFlow recording) and the kernel's flow table still read `[]` for about ten
        # seconds afterwards (+0 s = 0, +5 s = 0, +10 s = 61). Every window over that table
        # framed 0 rules and this report printed `no flow entry arrived during that window` --
        # WORD FOR WORD what it prints about a window that really did exclude the rules that
        # were there. An offline probe of both cases against the `ndt` of trunk 628d84f1
        # produced two byte-identical reports
        # (scratch/.../logs/ndt11-0912/q1-empty-table-probe.ndt11-0912-r1.log).
        # A reader could not tell "this window excluded everything on the wire" from "there was
        # nothing on the wire", and only the cell's own premise assertion kept that from being
        # a green check over a tool that had stopped looking.
        #
        # 🔴 IT IS NOT COUNTED AS BLIND, and that is a decision rather than an oversight. An
        # empty flow table is the NORMAL state of every idle lab with a kernel up and no fabric,
        # so folding it into RESIDUE_BLIND would make `ndt status --check` answer NOT CHECKED on
        # every clean machine -- a gate that can never pass, which is how G-12's own green checks
        # stopped being read. The reading is stated, in words, and the exit code is unchanged.
        # DOC-4 §7-8 asked for NOT CHECKED here and Adam has not ruled; FIX-NDT-11 §7 carries it.
        RESIDUE_TABLE_ROWS="$(printf '%s' "$entries" | flow_table_rows)"
        if [[ "$RESIDUE_TABLE_ROWS" == 0 ]]; then
            RESIDUE_EMPTY_TABLE=1
            warn "  flow table read empty -- a window over an empty table frames nothing."
            warn "        the kernel answered and its answer is 0 entry(s) on the whole plane, so"
            warn "        every 'no flow entry arrived during that window' below is true of an"
            warn "        empty table whatever the window was: that line discriminates NOTHING"
            warn "        here. NOT 'these apps left nothing'. (KNOWN-ISSUES G-55)"
            warn "        a table read within ~10s of 'ndt up' can still be empty while the"
            warn "        fabric is being programmed (measured 2026-09-12 15:00:47: +0s 0,"
            warn "        +5s 0, +10s 61). Poll it to non-empty, or install a datable rule of"
            warn "        your own, before reading a residue claim off this report."
        fi
    fi

    for t in routing_lock graph_lock power_lock; do
        lock="$(lock_probe "$t")"
        case "$lock" in
            held*)
                # 🔴 NOT `set -- $lock`. That rebinds this function's OWN positional parameters,
                # which are the list of apps to report on -- so the first held lock replaced
                # "energy" with "held 4 30" and every app afterwards was reported as having no
                # window. Caught by tests/shell/test_apps_residue.sh 5G on 2026-09-06, and the
                # reason that case drives a HELD lock rather than a free one.
                read -r _ lease retry <<<"$lock"
                err "  lock  $t HELD -- held_by_lease=${lease:-?}, frees itself in ${retry:-?}s (TTL)"
                n_locks=$(( n_locks + 1 )) ;;
            free)     info "  lock  $t free" ;;
            *)        warn "  lock  $t NOT CHECKED (${lock#unknown })"
                      RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 )) ;;
        esac
    done
    RESIDUE_LOCKS="$n_locks"
    (( n_locks > 0 )) && info "  a held lock is not attributed to any app: the lease id is not an owner"
    info "        field (LockManager.hpp), and the kernel has no lock-status endpoint, so the"
    info "        three lines above come from an acquire probe with ttl 0, which excludes nobody."

    for a in "$@"; do
        # [Co-developed with claude code -- Adam]
        # 3-51. A window captured by cmd_apps stop BEFORE it stopped this app wins over anything
        # readable now: a verified stop removes the pidfile, so by the time this report runs the
        # only record of when the app ran has been deleted by the command that is printing the
        # report. Empty for every other caller, which is why `apps orphans` and `--check` still
        # answer from the machine's own state.
        started="${RESIDUE_WINDOW[$a]:-}"
        [[ -n "$started" ]] || started="$(app_started_at "$a")" || started=""
        # [Co-developed with claude code -- Adam]
        # F3. The fourth source, and the only one that survives the process that read it: the
        # record a verified stop left on disk. Asked LAST, after the pidfile and the live
        # process, because those two describe an app that is running NOW and this one describes
        # one that has stopped -- and asked at all, which is the whole of F3: before this, every
        # report taken after a teardown answered "the window is LOST" about the apps whose rules
        # were on the wire at that moment. wend is the window's right edge; empty means "open",
        # i.e. up to now.
        wend=""; wwhy=""
        # [Co-developed with claude code -- Adam]
        # 🔴 RESIDUE-1, Adam's ruling 2026-09-12 12:3x. The right edge for the one source that
        # never had one: a pidfile whose process is gone. app_window_seal answers only for that
        # source (see its header), so it is asked unconditionally -- a live app and an app with
        # no pidfile both get rc 1 and keep a window that runs to now, which for them is true.
        # Asked BEFORE app_window_read for the same reason app_started_at reads the pidfile
        # before the scan: a pidfile that is still on disk is this app's own record, and a stop's
        # record is what answers when there is no pidfile left.
        if [[ -n "$started" ]] && wseal="$(app_window_seal "$a")"; then
            wend="${wseal%% *}"; wwhy="${wseal#* }"
        fi
        if [[ -z "$started" ]] && wrec="$(app_window_read "$a")"; then
            started="${wrec%% *}"; wend="${wrec##* }"
        fi
        if [[ -z "$started" ]]; then
            # 🔴 3-51, Adam's ruling E-8 point 4. This branch used to open with "no pidfile and
            # no live process" WITHOUT ever looking for a live process -- it was reached solely
            # by app_started_at returning 1, and app_started_at only read the pidfile. It
            # printed that sentence about a sim that was running in tmux at the time (lw16pw).
            # app_started_at now asks the scan too, so reaching this line usually does mean
            # nothing is running; "usually" is not a thing to print, so it is checked.
            live=()
            app_scan_here "$a"
            for rpid in ${APP_SCAN_HERE[@]+"${APP_SCAN_HERE[@]}"}; do
                [[ "$rpid" =~ ^[0-9]+$ ]] && live+=("$rpid")
            done
            if (( ${#live[@]} > 0 )); then
                warn "  $a: running as pid(s) ${live[*]} but no pidfile, and its start time"
                warn "      could not be read -- no window, so no rule can be dated against it."
                warn "      NOT 'this app left nothing'. (G-12)"
                RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 ))
                continue
            fi
            info "  $a: no pidfile and no live process -- no window, so no rule can be dated"
            info "      against it. NOT 'this app left nothing'. (G-12)"
            # 🔴 Only a LOST window counts against the exit code, and the log is what tells the
            # two apart. Five apps have no pidfile on a machine where nobody ever started them,
            # and counting that as "could not check" would make `ndt apps orphans` answer 5 on
            # every clean machine -- a gate that can never pass, which is how G-12's own green
            # checks stopped being read. app_spawn creates the log, so a non-empty log is
            # evidence the app RAN here and its record has since gone.
            #
            # 🔴 3-51, ruling E-8 point 3: WHICH log. Not ours -- the one whoever started it
            # writes to, which for sim is the helper's KERNEL_DIR and for energy does not
            # exist. Reading $REPO's copy made this discriminator answer "never ran here" for
            # every helper-started app in every worktree.
            elog="$(app_evidence_log "$a")" || elog=""
            if [[ -z "$elog" ]]; then
                warn "      and whether it ran here CANNOT BE ASKED: the helper keeps no log for $a"
                warn "      ('$LAB $a-start' gives it no 'script -f', so its output only ever"
                warn "      exists in a tmux pane). That is 'nobody could ask', not 'it never ran'."
                RESIDUE_UNKNOWABLE=$(( RESIDUE_UNKNOWABLE + 1 ))
                RESIDUE_UNKNOWABLE_APPS="${RESIDUE_UNKNOWABLE_APPS:+$RESIDUE_UNKNOWABLE_APPS }$a"
            elif [[ -s "$elog" ]]; then
                warn "      and its log is NOT empty, so it did run here: the window is LOST,"
                warn "      not absent. rules it installed cannot be found by this tool."
                RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 ))
                info "      (log read: $elog)"
            else
                info "      (its log is empty or absent too -- no sign it ever ran here)"
                info "      (log read: $elog)"
            fi
            continue
        fi
        any=1
        if [[ -n "$wwhy" ]]; then
            # 🔴 E-7, and it is printed ABOVE the window line rather than below it. A window of
            # zero seconds excludes every rule there is, and the sentence "no flow entry arrived
            # during that window" over it is a check that could not look wearing the face of a
            # check that looked and found nothing. It goes above because the line AFTER a window
            # line is that window's answer -- `no flow entry arrived ...` or the first rule --
            # and tools/test_workflow/live_cells/stale_app_pidfile_does_not_frame_the_fabric.sh
            # reads exactly that adjacency (its `nxt`). A caveat wedged between the two would
            # make the report's own shape depend on which branch this took.
            (( wend == started )) && {
                warn "      the window below has NO extent: nothing on this machine can date when"
                warn "      $a stopped, so NOTHING can be attributed to it. That is 'nobody could"
                warn "      ask', NOT 'this app left nothing'. (G-12)"
            }
            # [Co-developed with claude code -- Adam]
            # RESIDUE-1. A sealed window, on ONE line, and it names both the edge and where the
            # edge came from: a reader has to be able to tell "the app stopped here" from "this
            # is the last thing on the machine that could date it". `window closed` is the same
            # two words the app_window_read branch below uses, because both are closed windows
            # and a reader -- and that live cell -- should not need a third spelling.
            printf '  %-6s window %s -> window closed at %s (%ss wide; %s)\n' "$a" \
                "$(date -d "@$started" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$started")" \
                "$(date -d "@$wend" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$wend")" \
                "$(( wend - started ))" "$wwhy"
        elif [[ -n "$wend" ]]; then
            # F3. A CLOSED window, and the line says so and says where it came from: a reader
            # who sees a window for an app that is not running has to be able to tell a record
            # from a live reading, and the record is the only one of the two that another
            # process wrote.
            printf '  %-6s window %s -> %s (window closed %ss ago; from %s)\n' "$a" \
                "$(date -d "@$started" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$started")" \
                "$(date -d "@$wend" '+%H:%M:%S' 2>/dev/null || echo "$wend")" \
                "$(( now - wend ))" "$(app_windowfile "$a")"
        else
            printf '  %-6s window %s -> now (%s)\n' "$a" \
                "$(date -d "@$started" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$started")" \
                "$(( now - started ))s"
        fi
        if [[ -z "$entries" ]]; then continue; fi
        n_rules=0; n_unk=0
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            if [[ "$line" == UNREADABLE ]]; then
                warn "      the flow table on :8000 was not valid JSON -- rules NOT checked"
                RESIDUE_BLIND=$(( RESIDUE_BLIND + 1 ))
                n_rules=-1; break
            fi
            # W16-3. Said once per run, before the first rule, because it changes what every
            # line under it means: with no time axis the list below is the WHOLE table.
            if [[ "$line" == CANNOTWINDOW\ * ]]; then
                if [[ -z "$blind_said" ]]; then
                    warn "      CANNOT WINDOW -- ${line#CANNOTWINDOW }."
                    warn "      every rule below is age=UNKNOWN and NONE is attributed to an app;"
                    warn "      this is the whole flow table, not a rules-in-window list. (W16-3, measured"
                    warn "      2026-09-07: a rule installed on P4 still read duration 0/0 32s later)"
                    blind_said=1
                fi
                continue
            fi
            err "      rule  $line"
            case "$line" in *age=UNKNOWN*) n_unk=$(( n_unk + 1 )) ;; esac
            n_rules=$(( n_rules + 1 ))
        done < <(printf '%s' "$entries" | residue_rule_lines "$started" "$now" "$plane" "$wend")
        if (( n_rules == 0 )); then
            ok "      no flow entry arrived during that window"
        elif (( n_rules > 0 )); then
            err "      $n_rules rule(s) listed: $(( n_rules - n_unk )) dated inside the window,"
            err "      $n_unk with age=UNKNOWN. the dated ones are SUSPECTED by time only -- a"
            err "      rule has no owner and its cookie is 0 everywhere, so anything installed"
            err "      in that window is listed, whoever installed it. an UNKNOWN one is not a"
            err "      finding at all: it is a rule this tool could not place."
            RESIDUE_RULES=$(( RESIDUE_RULES + n_rules - n_unk ))
            RESIDUE_UNDATABLE=$(( RESIDUE_UNDATABLE + n_unk ))
        fi
    done

    echo
    info "  NOT deleted, and nothing here deletes them."
    info "  a lock heals: it expires at its TTL and the next acquire is told it reclaimed it."
    info "  a rule does not: no TTL, no owner, no cleanup path. to remove one, by hand:"
    info "    curl -s -X POST -H 'Content-Type: application/json' \\"
    info "      -d '{\"dpid\": <dpid>, \"priority\": <pri>, \"match\": <match>}' \\"
    info "      http://localhost:8000/ndt/delete_flow_entry"
    (( any == 0 )) && info "  (no app had a datable window in this run)"
    # The tally the exit code is computed from, printed so a reader can check the code against
    # what they just saw rather than against this function's source. [Co-developed with claude code -- Adam]
    info "  tally: $RESIDUE_RULES dated rule(s) in a window, $RESIDUE_LOCKS lock(s) held," \
         "$RESIDUE_UNDATABLE rule(s) that could not be dated, $RESIDUE_BLIND question(s) not answerable"
    # [Co-developed with claude code -- Adam]
    # 3-51. Printed on its own line and outside the tally above, because it is outside the exit
    # code: this is the count of apps nobody can ask, not of things that went wrong.
    (( RESIDUE_UNKNOWABLE > 0 )) &&
        info "  and $RESIDUE_UNKNOWABLE app(s) could not be asked whether they ran here at all:" \
             "$RESIDUE_UNKNOWABLE_APPS (no log channel exists for them -- see above)"
    return 0
}

# stack_state -- what of the STACK is up, for the one report that never looked. Report only:
# it returns 0 always and changes no exit code.
#
# [Co-developed with claude code -- Adam]
# 🔴 H2, measured live by ROLE-2 on 2026-09-11 (ROLE-2-CYCLES-REPORT §4). `ndt apps orphans`
# answers two questions -- are any APP processes untracked, and is anything of an app's still on
# the NETWORK -- and every round's restore check reads its verdict as "the lab is clean". It is
# not the same statement, and three measurements say what the gap costs:
#
#   cycle-07  10 bmv2 + 14 mininet processes + a live proxy, kernel down.  CLEAN.
#   cycle-12  10 OVS bridges + 15 mininet processes + a topo session.      CLEAN.
#   cycle-13  kernel serving a 14-node graph on :8000, 0 bmv2, 0 mininet, no topo session,
#             proxy alive on :8081.                                        CLEAN.
#
# All three verdicts were correct about what they measured. None of them measured the stack.
#
# 🔴 FACTS, and the classification beside them, in ONE line the reader can parse -- the same
# shape as residue_report's `tally:` line and for the same reason: a reader should be able to
# check the word against the numbers rather than against this function's source.
#
#   stack: kernel=up|down dataplane=p4|mininet|none bmv2=<n> mininet=<n> proxy=up|down
#          verdict=whole-up|whole-down|HALF
#
# 🔴 Only readings that need no privilege: two port probes and two process counts. Reaching for
# ovs_bridge_count or topo_session here -- both of which go through sudo -- would make
# `ndt apps orphans`, a read-only question anyone can ask, depend on a grant, and a refused
# privileged call would arrive as a missing half, which is the shape this line exists to make
# visible. (Spelled as function names on purpose: tests/shell/test_ndt_sudo_surface.sh extracts
# every `sudo -n <cmd>` in this file INCLUDING the ones in comments, because a command a comment
# teaches needs a grant as much as one the code runs -- so naming them literally here would
# demand rows for commands this function does not call.)
#
# 🔴 HALF means the two halves DISAGREE: a control plane with no data plane, or a data plane
# with no control plane. Not "something is up" -- `apps orphans` is asked BEFORE the down as
# well, on a healthy fabric, where whole-up is the right answer and must stay CLEAN.
#
# 🔴 The one false positive this can produce is a kernel started with `--mode physical`, which
# has no bmv2 and no Mininet by design. `ndt up` cannot build one (resolve_up_target has no
# physical target) so it cannot arise from this tool, and the physical testbed is out of service;
# it is named in the printed line rather than guessed at, and FIX-NDT-2 SUMMARY §7 carries it.
stack_state() {
    local kernel proxy nb nm dp verdict
    kernel=down; port_open 8000 && kernel=up
    proxy=down;  port_open 8081 && proxy=up
    nb="$(bmv2_count)"; nm="$(mn_count)"
    [[ "$nb" =~ ^[0-9]+$ ]] || nb=0
    [[ "$nm" =~ ^[0-9]+$ ]] || nm=0
    if   (( nb > 0 )); then dp=p4
    elif (( nm > 0 )); then dp=mininet
    else                    dp=none
    fi
    if [[ "$kernel" == up && "$dp" == none ]]; then verdict=HALF
    elif [[ "$kernel" == down && "$dp" != none ]]; then verdict=HALF
    elif [[ "$kernel" == up ]]; then verdict=whole-up
    else verdict=whole-down
    fi
    printf 'stack: kernel=%s dataplane=%s bmv2=%s mininet=%s proxy=%s verdict=%s\n' \
        "$kernel" "$dp" "$nb" "$nm" "$proxy" "$verdict"
    return 0
}

# stack_report -- stack_state, printed, with the sentence a HALF answer needs. Report only.
stack_report() {
    local line v
    line="$(stack_state)"
    v="${line##*verdict=}"
    info "  $line"
    case "$v" in
        HALF)
            warn "  HALF A STACK. the two halves disagree: one of the kernel and the data plane"
            warn "  is there and the other is not. this verb answers about APP processes and"
            warn "  about the NETWORK; it does not answer about the stack, and on 09-11 it said"
            warn "  CLEAN three times over a machine in this state (H2). a kernel with no"
            warn "  fabric serves a graph of a network that is not there; a fabric with no"
            warn "  kernel forwards with nothing recording it. take it down:  ndt down"
            warn "  (a kernel started with --mode physical reads like this too and is not a"
            warn "  finding -- 'ndt up' cannot build one.)" ;;
        whole-up)
            info "  the stack is up. that is not residue -- 'apps orphans' is asked before a"
            info "  teardown as well as after it." ;;
        whole-down)
            info "  no kernel and no data plane: nothing of the stack is up." ;;
    esac
    return 0
}

# apps_elsewhere_report -- the column C10-8 adds: processes that wear one of these apps'
# signatures and belong to another checkout on this machine.
#
# [Co-developed with claude code -- Adam]
# Printed whether or not an orphan of ours was found, because the reader's question is the same
# either way: "what did the scan see, and why is it not in the verdict". Nothing here is a
# finding about THIS lab, so it changes no exit code -- the count is in the text, and a reader
# who wants it in a gate has orphans_verdict.sh's `elsewhere=` field.
apps_elsewhere_report() {
    local e pid name why n
    n="${#APP_ELSEWHERE[@]}"
    if (( n > 0 )); then
        warn "seen elsewhere (not this checkout): $n process(es)"
        for e in "${APP_ELSEWHERE[@]}"; do
            pid="${e%% *}"; why="${e#* }"; name="${why%% *}"; why="${why#* }"
            warn "    $name  pid $pid  $(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | cut -c1-80)"
            warn "        $why"
        done
        warn "    they carry an app signature and nothing ties them to this checkout, so they are"
        warn "    NOT in the verdict and 'ndt down' here does not stop them. Whoever owns that"
        warn "    tree stops them. (C10-8, 2026-09-12)"
    fi
    # E-7: the pids nobody could attribute are counted as ours (app_claims_pid), and saying so
    # is the difference between "it is ours" and "we could not tell and did not guess in our own
    # favour".
    [[ -n "$APP_ATTRIB_BLIND" ]] &&
        warn "who owns these could NOT be established, so they are counted as this checkout's: $APP_ATTRIB_BLIND"
    return 0
}

apps_orphans() {
    local a found=0 pid e blind="" s spid lp known
    local -a unnamed=()
    app_elsewhere_reset; APP_ATTRIB_BLIND=""
    for a in $APP_NAMES; do
        app_probe "$a"
        app_survivors "$a"
        [[ -n "$APP_SURVIVOR_BLIND" ]] && blind="${blind:+$blind; }$a: $APP_SURVIVOR_BLIND"
        if [[ "$APP_STATE" == pidfile-lost-but-alive ]]; then
            found=$(( found + 1 ))
            err "$a: pidfile-lost-but-alive -- $(app_label "$a")"
            for pid in "${APP_LIVE_PIDS[@]}"; do
                err "    pid $pid  $(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | cut -c1-80)"
            done
            err "    stop it with:  ndt apps stop $a"
            continue
        fi
        # The 09-02 shape: no pidfile, no signature in any argv, and the children are still
        # there. Reported by the channel that found them, because "how do you know" is the
        # question this whole family of failures could not answer.
        #
        # [Co-developed with claude code -- Adam]
        # 🔴 3-51b, measured live 2026-09-07 (lw351, 1/1). app_survivors answers "which processes
        # do these channels find", NOT "which of them is nobody tracking" -- and this verb went
        # straight from the first question to the second word. With a RUNNING sim, tracked by the
        # pidfile 3-51 had just taught `ndt` to write, it printed:
        #
        #     sim: children with no pidfile and no signature
        #         pid 3729217  (process group 3729217)
        #
        # 3729217 was the contents of the pidfile, verified alive by app_probe seconds earlier,
        # and printed by `apps status` as `running` in the same run. The group channel finds it
        # because the pidfile is exactly where app_recorded_pgid starts; nothing then compared
        # it against what the probe had already accounted for. app_stop does that comparison --
        # its `extra` loop -- and this verb never got one.
        #
        # 🔴 The subtraction is APP_LIVE_PIDS and NOT the pidfile's contents. A pidfile naming a
        # dead or recycled pid must not silence a survivor with that number: APP_LIVE_PIDS holds
        # only pids /proc has confirmed are this app (pid_is_app), which is the set "tracked"
        # can honestly mean. FINDING #48 is untouched -- the 09-02 viz JVMs carry no signature,
        # so they are in no APP_LIVE_PIDS and every one of them still comes out below.
        unnamed=()
        for s in ${APP_SURVIVORS[@]+"${APP_SURVIVORS[@]}"}; do
            spid="${s%% *}"; known=0
            for lp in ${APP_LIVE_PIDS[@]+"${APP_LIVE_PIDS[@]}"}; do
                [[ "$lp" == "$spid" ]] && { known=1; break; }
            done
            (( known == 0 )) && unnamed+=("$s")
        done
        (( ${#unnamed[@]} == 0 )) && continue
        found=$(( found + 1 ))
        # Two headlines, because "no pidfile" is a statement of fact and it was false in lw351.
        # A tracked app with an extra process nothing names is still worth rc 1 -- `ndt apps
        # stop` is still the remedy, and it reaches this one through the group -- but the
        # sentence has to describe what was actually found.
        if [[ "$APP_STATE" == running ]]; then
            err "$a: RUNNING as pid(s) ${APP_LIVE_PIDS[*]}, and these belong to it with nothing naming them -- $(app_label "$a")"
        else
            err "$a: children with no pidfile and no signature -- $(app_label "$a")"
        fi
        for e in "${unnamed[@]}"; do
            # pid in a variable of its own rather than `${e%% *}` inline: this argv line is one
            # of the sites tests/shell/test_redirection_order.sh lifts out of this file and runs
            # against a pid that cannot exist, and that harness binds `pid`.
            pid="${e%% *}"
            err "    pid $pid  (${e#* })"
            err "      $(tr '\0' ' ' 2>/dev/null < "/proc/$pid/cmdline" | cut -c1-80)"
        done
        err "    stop it with:  ndt apps stop $a"
    done
    # [Co-developed with claude code -- Adam]
    # 🔴 C10-8. Its own column, above the verdict, in warn() and not err(): these processes are
    # REAL and somebody should know they are there -- but they are not this checkout's to count
    # and not this checkout's to stop, and the 15:05:14 grid stop is what happens when the two
    # are the same column. Deliberately carries neither `pidfile-lost-but-alive` nor `running
    # with nothing tracking them`: those two strings are what orphans_verdict.sh's process half
    # reads, and a NOTE that matched them would be a NOTE in name only.
    apps_elsewhere_report
    if (( found == 0 )); then
        if [[ -n "$blind" ]]; then
            # "Could not look" is not "nothing there", and this verb gates measurements.
            warn "no untracked app processes found, but a channel was blind: $blind"
            return 2
        fi
        ok "no untracked app processes"
        return 0
    fi
    err "$found app(s) are running with nothing tracking them"
    # [Co-developed with claude code -- Adam]
    # 🔴 3-51c. Printed HERE too, and it used to be printed only when nothing was found. A
    # channel that could not look is a fact about the answer, not about the verdict: with one
    # orphan named and another channel blind, "$found" is a floor and not a count, and a reader
    # who takes it for a count stops looking at exactly the point where the tool did.
    [[ -n "$blind" ]] &&
        warn "and a channel was blind, so this is a floor and not a count: $blind"
    return 1
}

apps_status() {
    say "apps"
    local a shown bytes over=0 log why
    for a in $APP_NAMES; do
        app_probe "$a"
        # The third state gets its own word in the column that used to print "-" for it. "-"
        # meant "not running" and was printed for a crash-looping app for 20h07m02s.
        case "$APP_STATE" in
            running)                shown=running ;;
            pidfile-lost-but-alive) shown="${R}ORPHAN${N}" ;;
            *)                      shown="-" ;;
        esac
        printf '  %-8s %-9s %s\n' "$a" "$shown" "$(app_label "$a")"
        [[ "$APP_STATE" == pidfile-lost-but-alive ]] &&
            printf '  %-8s %-9s %s\n' "" "" "^ pid(s) ${APP_LIVE_PIDS[*]}, no pidfile names it -- 'ndt apps stop $a'"
        # [Co-developed with claude code -- Adam]
        # The log's size, because on 09-02 nothing in this repo would have told anyone that
        # app_viz.log had reached 875 MB on a filesystem at 85% -- it was found by hand, after
        # the round. The size is printed whenever there is a log, not only over the threshold:
        # a number that appears only when it is bad is a number nobody has a baseline for.
        bytes="$(app_log_bytes "$a")" || bytes=""
        if [[ -n "$bytes" ]]; then
            if (( bytes > APP_LOG_MAX_BYTES )); then
                over=1
                printf '  %-8s %-9s %s\n' "" "" \
                    "${Y}log $(human_bytes "$bytes") -- over $(human_bytes "$APP_LOG_MAX_BYTES"); 'ndt apps trim $a'${N}"
            else
                printf '  %-8s %-9s %s\n' "" "" "${D}log $(human_bytes "$bytes")${N}"
            fi
            # [Co-developed with claude code -- Adam]
            # 🔴 3-51c. The size above came out of stat(2) -- a READ, which succeeds on a file
            # this user could never truncate -- and the row above then names `ndt apps trim`
            # without ever asking whether that verb can do anything here. For every
            # helper-started sim it cannot: `sudo ndtwin-lab sim-start` wrote the log as root.
            log="$(app_logfile "$a")"
            if [[ ! -w "$log" ]] && [[ "$(app_log_owner "$log")" == 0 ]]; then
                printf '  %-8s %-9s %s\n' "" "" "${Y}log is root's ($log); trim needs sudo${N}"
            elif ! why="$(app_log_blocked_reason "$log")"; then
                printf '  %-8s %-9s %s\n' "" "" "${Y}log cannot be trimmed here: $why${N}"
            fi
        fi
    done
    (( over == 1 )) && info "a log over the cap is a disk problem before it is a logging problem: 875 MB in 1h54m on 09-02"
    return 0
}

# apps_trim [name...] -- bound a running app's log without stopping the app.
#
# [Co-developed with claude code -- Adam]
# Truncate in place, never rotate: the app holds the fd, so `mv` would leave the writer
# appending to the file under its new name while a fresh empty one sits where everybody looks.
# app_spawn opens the log with `>>`, so after ftruncate the next write goes to offset 0 rather
# than back to where the file used to end -- without O_APPEND this would produce a sparse file
# whose apparent size never drops, which is the shape that makes `ls -l` and `du` disagree.
#
# The tail is kept because the end of a log is the part that explains what the app is doing now.
apps_trim() {
    local a bytes log rc=0 why
    for a in "$@"; do
        case " $APP_NAMES " in *" $a "*) ;; *) err "unknown app: $a (known: $APP_NAMES)"; rc=1; continue ;; esac
        log="$(app_logfile "$a")"
        bytes="$(app_log_bytes "$a")" || { info "$a has no log"; continue; }
        if (( bytes <= APP_LOG_MAX_BYTES )); then
            info "$a log is $(human_bytes "$bytes") -- under $(human_bytes "$APP_LOG_MAX_BYTES"), left alone"
            continue
        fi
        # [Co-developed with claude code -- Adam]
        # 🔴 3-51c. Asked BEFORE the tail is written, and not discovered by the truncate below
        # failing. The old order kept 1 MB into <log>.tail and only then found out it could not
        # truncate: a file created, a byte count unchanged, and a message that named the
        # failure without naming either its cause or the one command that fixes it.
        if ! why="$(app_log_blocked_reason "$log")"; then
            err "cannot truncate $log: $why"
            err "   $a's log is $(human_bytes "$bytes"), over the $(human_bytes "$APP_LOG_MAX_BYTES") cap, and it is NOT trimmed"
            rc=1; continue
        fi
        tail -c 1048576 "$log" >"$log.tail" 2>/dev/null || { err "$a: could not keep the tail; not truncating"; rc=1; continue; }
        if truncate -s 0 "$log" 2>/dev/null; then
            ok "$a log truncated: $(human_bytes "$bytes") -> 0 (last 1 MB kept as $(basename "$log").tail)"
        else
            err "$a: truncate failed on $log"; rc=1
        fi
    done
    return "$rc"
}

cmd_apps() {
    local sub="${1:-}"
    case "$sub" in
        ""|status)
            apps_status
            [[ "$sub" == status ]] && return 0
            # Only offer the picker on a terminal; piped or scripted, status is the answer.
            [[ -t 0 && -t 1 ]] || return 0
            echo
            if ! port_open 8000; then
                warn "the kernel is not up (:8000 closed) -- every app below reads its API."
                warn "run 'ndt up' first, or start them anyway and expect connection errors."
            fi
            echo "  which to start? (names or numbers, space separated; empty = none)"
            local i=1 a
            for a in $APP_NAMES; do printf '    %d) %-7s %s\n' "$i" "$a" "$(app_label "$a")"; i=$(( i + 1 )); done
            local reply; read -r -p "  > " reply || return 0
            [[ -z "${reply// }" ]] && { info "nothing selected"; return 0; }
            local sel=() tok
            for tok in $reply; do
                if [[ "$tok" =~ ^[0-9]+$ ]]; then
                    sel+=( "$(echo $APP_NAMES | cut -d' ' -f"$tok")" )
                else
                    sel+=( "$tok" )
                fi
            done
            for a in "${sel[@]}"; do [[ -n "$a" ]] && app_start "$a"; done
            ;;
        stop)
            shift
            local targets="${*:-all}"
            [[ "$targets" == all ]] && targets="$APP_NAMES"
            # [Co-developed with claude code -- Adam]
            # G-6. Was `for a in $targets; do app_stop "$a" || rc=1; done`. With app_stop's new
            # rc 2 that `||` would call "there was nothing to stop" a failure, which is the
            # opposite error to the one being fixed. The three outcomes are counted instead:
            #
            #     1  at least one app could not be stopped        (a real failure)
            #     2  nothing was stopped because nothing was up   (a truthful no-op)
            #     0  at least one app was running and now is not
            #
            # `ndt apps stop all` on an idle machine therefore exits 2 rather than 0. That is the
            # point: D1 (2026-09-02) recorded APPS_STOP_ALL_RC=0 from a teardown that stopped
            # three of five and reported the same code it would have reported for zero of five.
            local a arc awin n_fail=0 n_noop=0 n_stopped=0
            # [Co-developed with claude code -- Adam]
            # 🔴 3-51. Every target is dated BEFORE the loop, because app_stop destroys the
            # record it is dated by: a verified stop removes the pidfile (both branches do, for
            # the reason written at each), and app_started_at's live-process source dies with
            # the process. Without this the residue report below always printed "no window" for
            # exactly the apps this command had just stopped -- and that is the moment the
            # rules it left are on the wire with nothing running to own them.
            RESIDUE_WINDOW=()
            for a in $targets; do
                awin="$(app_started_at "$a")" && [[ -n "$awin" ]] && RESIDUE_WINDOW["$a"]="$awin"
            done
            for a in $targets; do
                app_stop "$a"; arc=$?
                case "$arc" in
                    0) n_stopped=$(( n_stopped + 1 )) ;;
                    2) n_noop=$(( n_noop + 1 )) ;;
                    *) n_fail=$(( n_fail + 1 )) ;;
                esac
            done
            # G-12 / W16. Printed for EVERY outcome of the loop above, including the "nothing
            # was running" one -- which is the shape the finding was measured in: the app had
            # already been killed by pid, `stop` found nothing to stop, and the rule and the
            # lock it left were still on the network. A residue report that only ran when
            # something was stopped would miss the only case that needed it.
            echo
            # shellcheck disable=SC2086
            residue_report $targets
            (( n_fail > 0 )) && { err "$n_fail app(s) could not be stopped"; return 1; }
            if (( n_stopped == 0 )); then
                info "nothing to stop ($n_noop app(s) were already not running)"
                return 2
            fi
            (( n_noop > 0 )) && info "stopped $n_stopped; $n_noop were already not running"
            return 0
            ;;
        # The pre-run check. Same scan as `stop`, without stopping anything.
        #
        # G-12 / W16-1. Adam decided this one AGAINST the recommendation (grill §4D round 7,
        # 09-06): residue must make this verb red. The recommendation had been to leave the
        # exit code meaning "processes" so `arm_up.sh` and the other gates kept working -- and
        # Adam's point is the stronger one: G-12 IS "every existing check went green over it",
        # so a residue report whose exit code cannot fail is one more green check.
        #
        # 🔴 THE CODES ARE DISJOINT, and every caller that gates on this has to be updated:
        #     0  no untracked processes AND nothing on the network
        #     1  untracked app PROCESSES are running          (unchanged since 09-02)
        #     2  a liveness channel was blind                 (unchanged)
        #     4  processes are clean, but the NETWORK carries residue (a rule, or a held lock)
        #     5  processes are clean, and the residue COULD NOT BE CHECKED (kernel down, a
        #        reading failed, or the plane cannot be windowed at all -- every P4 fabric)
        # The process answer wins when it is non-zero: a live process is still changing the
        # network, and `ndt apps stop <name>` is a different remedy from deleting a flow entry.
        # Callers in this repo: tests/shell/test_ndt_app_orphans.sh (drives apps_orphans, the
        # process half, directly) and doc/2026-08-17_testing-manual.md. Out of tree:
        # scratch/overnight-2026-09-05/arm_down.sh restore check 2/3.
        orphans)
            apps_orphans; local orc=$?
            echo
            # H2. Printed HERE, in the command, and not inside apps_orphans or residue_report:
            # those two are the process half and the network half, they are driven directly by
            # tests/shell/test_ndt_app_orphans.sh and tests/shell/test_apps_residue.sh, and
            # neither of their answers changes. This is a third reading, and the rc below is
            # untouched by it -- `ndt`'s 0/1/2/4/5 table is the spec (`ndt help`).
            say "stack"
            stack_report
            echo
            # shellcheck disable=SC2086
            residue_report $APP_NAMES
            residue_verdict; local rrc=$?
            if (( orc != 0 )); then
                (( rrc != 0 )) && err "and the network is not clean either (rules-in-window rc would be $rrc)"
                return "$orc"
            fi
            case "$rrc" in
                4) err "RULES-IN-WINDOW: the processes are gone and the network is not clean -- rc 4."
                   err "  rc 4 is NOT rc 1: nothing is running, so 'ndt apps stop' has nothing"
                   err "  to do. remove the rule by hand (the command is printed above); a held"
                   err "  lock frees itself at its TTL." ;;
                5) warn "NOT CHECKED: the rules-in-window question could not be answered -- rc 5."
                   warn "  this is not 'the network is clean'. see the lines above for which"
                   warn "  reading failed. (KNOWN-ISSUES G-12)" ;;
            esac
            return "$rrc" ;;
        # The disk half of findings #6/#48: bound a log that is still being written to.
        trim)
            shift
            local ttargets="${*:-all}"
            [[ "$ttargets" == all ]] && ttargets="$APP_NAMES"
            # shellcheck disable=SC2086
            apps_trim $ttargets ;;
        *)
            local a; for a in "$@"; do app_start "$a"; done
            ;;
    esac
}

# --- NTG mode ---------------------------------------------------------------------
#
# NTG's prompt and Mininet's CLI are mutually exclusive and chosen by one line in NTG's own
# config, not by anything here. Reads always; writes only when asked, and says so, because
# this edits a file in a sibling repo.
NTG_YAML=/home/adam/Network-Traffic-Generator/setting/Mininet.yaml

cmd_ntg() {
    [[ -f "$NTG_YAML" ]] || { err "not found: $NTG_YAML"; return 1; }
    local cur; cur="$(sed -n 's/.*mode:[[:space:]]*"\?\([a-z]*\)"\?.*/\1/p' "$NTG_YAML" | head -1)"
    case "${1:-}" in
        "")
            say "NTG mode: ${cur:-unknown}"
            info "cli    -> the topology drops into Mininet's CLI"
            info "prompt -> the topology hands control to NTG's own prompt"
            info "change it with:  ndt ntg cli|prompt     (takes effect on the next 'ndt up')" ;;
        cli|prompt)
            if [[ "$cur" == "$1" ]]; then ok "NTG mode already $1"; return 0; fi
            sed -i "s/\(mode:[[:space:]]*\)\"\?[a-z]*\"\?/\1\"$1\"/" "$NTG_YAML"
            warn "edited $NTG_YAML (a sibling repo's config): mode $cur -> $1"
            info "takes effect on the next 'ndt up'; the running topology keeps its current mode" ;;
        *) err "usage: ndt ntg [cli|prompt]"; return 2 ;;
    esac
}

# --- what `ndt up` means ----------------------------------------------------------

# [Co-developed with claude code -- Adam]
# resolve_up_target <arg1> <arg2> -- prints "<fn> <arg>" for `ndt up`'s arguments, or nothing
# with rc 2 when they name nothing this script can build.
#
# A FUNCTION, above the source seam, and not a case block inside the dispatch: the dispatch
# runs only when this file is executed, so a case block there is reachable from a test only by
# bringing up a real fabric. The one thing worth testing here is which plane and which size a
# given argv means -- see tests/shell/test_ndt_up_target.sh.
#
# 🔴 THE DEFAULT PLANE IS OVS (Adam, 2026-09-03). It was p4 until then. Two consequences that
# are not visible from the change itself:
#
#   * `ndt up` means `ndt up ovs`, i.e. 128 hosts through NTG's testbed_topo.py. up_ovs has
#     exactly TWO sizes, 128 and 4, because each is a different ndtwin-lab verb
#     (ovs-topo-start / ovs-topo-4host) -- there is no host_count() override on the OVS side
#     the way there is on the P4 side, so "the current host count" has no meaning here and a
#     default had to be picked rather than inherited.
#   * a bare number now follows the default plane: `ndt up 4` is OVS at 4 hosts, where it used
#     to be P4 at 4. Any other number is refused, because up_ovs cannot build one -- it used to
#     be accepted and built a P4 fabric of that size. To get the old meaning, say `ndt up p4 N`.
# up_take_app_flag <args...> -- lift `--app <dir>` / `--app=<dir>` out of `ndt up`'s argv.
#
# [Co-developed with claude code -- Adam]
# Sets NDT_APP_DIR (absolute) and NDT_UP_ARGV (what is left, for resolve_up_target). rc 2 when
# the flag is malformed or the directory is not one.
#
# 🔴 A FUNCTION AND TWO GLOBALS, not a third field on resolve_up_target's output line. The
# dispatch runs resolve_up_target's answer through `$plan` UNQUOTED -- deliberately, it is two
# words this file produced -- and a package directory is an operator-supplied path that may
# carry a space. Putting it on that line would word-split it into a plane nobody named.
#
# 🔴 ABSOLUTE, here, once. The knob only accepts absolute paths (app_package.read_knob refuses
# a relative one, because the proxy is started from p4_proxy/ and the topology script from
# anywhere, so the same line would name two directories). Resolving it at the point where the
# operator's cwd is still the operator's cwd is the only place the answer is knowable.
NDT_APP_DIR=""
NDT_UP_ARGV=()
up_take_app_flag() {
    NDT_APP_DIR=""
    NDT_UP_ARGV=()
    # `seen` is tracked apart from the VALUE, and that is the whole point of it. `--app=` and
    # `--app ""` both set NDT_APP_DIR to the empty string, and an emptiness test alone reads
    # that as "no package was asked for" -- so the command would build the BASELINE fabric and
    # clear p4_proxy/mininet/app_package_override on the way, under an argv that says --app.
    # A flag given with no value is a typo, not a request for the default.
    local a want=0 seen=0
    for a in "$@"; do
        if (( want )); then NDT_APP_DIR="$a"; want=0; seen=1; continue; fi
        case "$a" in
            --app)   want=1 ;;
            --app=*) NDT_APP_DIR="${a#--app=}"; seen=1 ;;
            *)       NDT_UP_ARGV+=("$a") ;;
        esac
    done
    if (( want )); then
        err "ndt up --app needs a package directory:  ndt up p4 --app <dir>"
        return 2
    fi
    if (( seen )) && [[ -z "$NDT_APP_DIR" ]]; then
        err "--app was given an EMPTY package directory."
        err "  an empty value is not 'no package': taken as one, this command would build the"
        err "  baseline fabric and clear p4_proxy/mininet/app_package_override on the way, under"
        err "  an argv that says --app. usage:  ndt up p4 --app <dir>"
        return 2
    fi
    [[ -z "$NDT_APP_DIR" ]] && return 0
    if [[ ! -d "$NDT_APP_DIR" ]]; then
        err "--app $NDT_APP_DIR is not a directory"
        err "  it must be an app package: a directory with package.json and ndtwin/topology.json,"
        err "  as tools/p4_exercise/convert.py writes one."
        return 2
    fi
    NDT_APP_DIR="$(cd "$NDT_APP_DIR" 2>/dev/null && pwd)" || {
        err "--app: could not resolve that directory to an absolute path"; return 2; }
    return 0
}

resolve_up_target() {
    case "${1:-ovs}" in
        p4)     printf 'up_p4 %s\n'  "${2:-}"    ;;
        ovs)    printf 'up_ovs %s\n' "${2:-128}" ;;
        ovs4)   printf 'up_ovs 4\n'              ;;
        # A bare number follows the default plane, so it is a size, not a plane. up_ovs builds
        # only 128 and 4; anything else is refused here rather than silently building the other
        # plane's fabric at that size.
        128)    printf 'up_ovs 128\n'            ;;
        4)      printf 'up_ovs 4\n'              ;;
        [0-9]*) return 2                          ;;
        *)      return 2                          ;;
    esac
}

# --- dispatch ---------------------------------------------------------------------

# [Co-developed with claude code -- Adam]
# Sourced rather than executed: define the functions and stop, exactly as stack.sh:877 does.
# Without this, `source ndt` fell through to the usage block and `exit 2`-ed the sourcing shell,
# so the only way to test any of these predicates was to copy the expression into the test and
# assert the copy still appeared in this file (test_ndt_lab_session.sh:29-32). That is a test of
# a string, not of the behaviour, and it cannot exercise app_stop at all. tests/shell/
# test_ndt_app_orphans.sh drives the real functions through this seam.
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    return 0
fi

# A test that wants the predicates above without running a command sources this file with
# NDT_LIB_ONLY=1. `return` outside a function is only legal in a sourced file, which is exactly
# when the variable is set; executed normally the line is never reached with it set. Without
# this seam a test can only reach guard_no_live_ovs and dataplane_ok through `ndt up`, which
# needs a lab. [Co-developed with claude code -- Adam]
[[ -n "${NDT_LIB_ONLY:-}" ]] && return 0

case "${1:-}" in
    up)
        shift
        up_take_app_flag "$@" || exit 2
        set -- ${NDT_UP_ARGV[@]+"${NDT_UP_ARGV[@]}"}
        if ! plan="$(resolve_up_target "${1:-}" "${2:-}")"; then
            err "usage: ndt up [p4 [hosts] | p4 --app <dir> | ovs [128|4] | ovs4 | 128 | 4]"
            err "   the default plane is OVS: bare 'ndt up' is 'ndt up ovs' (128 hosts)."
            err "   OVS builds only 128 or 4. For any other size, name the plane: ndt up p4 ${1:-N}"
            exit 2
        fi
        # 🔴 --app IS A P4 FLAG, refused on every other plane rather than ignored there. An app
        # package supplies a bmv2 pipeline, a P4Runtime election id and a control-plane mode;
        # nothing on the OVS plane reads any of them, so an accepted-and-ignored --app would
        # build a 128-host OVS fabric while the operator believed they were running an
        # exercise. 2, because it is argv naming something this script cannot build -- the same
        # answer resolve_up_target gives one line up.
        if [[ -n "$NDT_APP_DIR" && "${plan%% *}" != up_p4 ]]; then
            err "--app is a P4 flag: ${plan%% *} builds an OVS fabric, and nothing on that plane"
            err "  reads a package's pipeline, election id or control-plane mode."
            err "  did you mean:  ndt up p4 --app $NDT_APP_DIR"
            exit 2
        fi
        # shellcheck disable=SC2086 -- plan is "<fn> <arg>", both produced by resolve_up_target
        $plan
        ;;
    down)    shift; cmd_down "$@" ;;
    clean)   cmd_clean ;;
    status)  cmd_status "${2:-}" ;;
    check)   cmd_check "${2:-}" ;;
    claim)   shift; cmd_claim "$@" ;;
    release) cmd_release "${2:-}" ;;
    apps)    shift; cmd_apps "$@" ;;
    ntg)     cmd_ntg "${2:-}" ;;
    *)
        # 🔴 Computed HERE, above the heredoc, and never inside it. `cat <<EOF` is UNQUOTED, and
        # tests/shell/test_ndt_up_target.sh's "the usage text must not EXECUTE anything" section
        # exists because three backticks written into this very text on 2026-09-03 brought a
        # fabric up and left it orphaned under systemd --user. That cell bans `$( )` in the
        # usage body as the same class of thing, and it is right: the substitution below runs in
        # ordinary code, where it is read, reviewed and gated like any other line, and what the
        # heredoc does is expand a variable. (ROLE-11 F7, 2026-09-12 -- caught by that gate.)
        NDT_DEEP_SIZE="$(ndt_port_table_size all)"
        NDT_DEEP_PORTS="$(ndt_port_label all)"
        cat <<EOF
usage: ndt <command>

  up [what]     bring the whole lab up and verify it
                  ndt up            Ryu + OVS, 128 hosts  (the default plane is OVS)
                  ndt up 4          Ryu + OVS on the P4 test bed's 4-host layout
                  ndt up ovs        the same as a bare 'ndt up'
                  ndt up ovs4       the same as 'ndt up 4'
                  ndt up p4         p4 at the current host count
                  ndt up p4 4       p4 at 4 hosts   (rewrites host_count_override)
                  ndt up p4 128     p4 at 128 hosts
                  ndt up p4 --app <dir>   p4 on an APP PACKAGE
                OVS builds only 128 or 4 -- each is a different ndtwin-lab verb, not a
                parameter. For any other size, name the plane: 'ndt up p4 N'.
                NDT_TOPO=<file> forces a specific kernel model.

                --app <dir> brings the P4 plane up on an app package -- a directory
                  with package.json and ndtwin/topology.json, as written by
                  tools/p4_exercise/convert.py from a p4lang-tutorials exercise. The
                  package names every host, its address and the switch port it hangs
                  off, so it SIZES the fabric: no host count may be given with it, and
                  host_count_override is rewritten to the model's count.
                  what it does, in order: runs tools/p4_exercise/preflight.py and
                  prints its table verbatim (a red row means nothing is built and
                  nothing is written); writes p4_proxy/mininet/app_package_override;
                  rewrites host_count_override; points NDT_TOPO, the kernel's
                  --topology and the proxy's NDTWIN_TOPO_FILE at the package's model.
                  --app is a P4 flag: on any other plane it is a usage error (2), not
                  an ignored argument.
                  🔴 THE KNOB IS PERSISTENT AND IS CLEARED AGAIN BY: an 'ndt up' of
                  any plane WITHOUT --app, 'ndt down', 'ndt clean', and a rolled-back
                  bring-up. Each of those prints 'app package cleared: <dir>'. Nothing
                  ever leaves it present-but-empty: that state makes the proxy refuse
                  to start, and 'ndt status' reports it as a problem.
                  an external-control-plane package (mode external) brings the fabric
                  up EMPTY on purpose -- the proxy installs no routes -- so [3/3]
                  names the destination-path count and the forwarding test as NOT
                  CHECKED rather than failing or passing them, and still checks the
                  switches, the graph, the model and the host namespaces.
                  exit 0 the fabric came up and verified; 1 something was MEASURED and
                  it was dirty -- a port held by a stray, a Mininet already running, a
                  fabric older than the compiled pipeline, a bring-up that could not
                  finish or could not verify; 5 a GUARD REFUSED and nothing was built:
                  the lab is claimed by somebody else, a measurement is in flight, an
                  'ndt down' from this checkout is still running, or NDT_TOPO names a
                  model of a different network (H4). An --app package that did not
                  pass tools/p4_exercise/preflight.py is 5 for the same reason: the
                  table is printed and nothing is built. 2 is a usage error.
                  🔴 1 AND 5 ARE DIFFERENT QUESTIONS. 1 says this command looked at the
                  machine and did not like what it found; 5 says it never looked. When
