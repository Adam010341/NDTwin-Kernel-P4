}

# lab_subject -- is there anything here for a teardown to take down or an assertion to be about?
# Prints what it found, one clause per line; rc 0 when there is something, 1 when there is not.
#
# 🔴 Six populations, and the last one matters most: a port held by something nobody registered
# is exactly the case an empty registry must NOT swallow. "Nothing is running" and "nothing was
# ever here" are the two statements this function exists to keep apart.
lab_subject() {
    local found=0 n f
    n="$(bmv2_count)";  [[ "$n" -gt 0 ]] && { echo "$n bmv2 switch(es)"; found=1; }
    n="$(mn_count)";    [[ "$n" -gt 0 ]] && { echo "$n host/switch process(es)"; found=1; }
    topo_session && { echo "a topo tmux session"; found=1; }
    [[ -e "$MANIFEST" ]] && { echo "the switch manifest ${MANIFEST#$REPO/}"; found=1; }
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        echo "the registry entry $f"; found=1
    done < <(pid_registry_entries)
    [[ -n "$(ndt_port_residue all)" ]] && { echo "a held port in ports.sh's table"; found=1; }
    (( found == 1 ))
}

cmd_down() {
    local force="" deep="" arg busy held down_rc=0 down_verdict=0 declared holder detail DOWN_SUBJECT=""
    # 🔴 ROLE-9 / ROLE-11 F6: what `verify clean` could NOT verify, named half by half. Empty
    # means it verified everything, which is a different statement from `down_rc == 0` -- see
    # claim_note_down. The stack.sh half is deliberately not in here: "a component ended on a
    # fatal signal in an earlier round" is a true non-zero about a machine that is clean.
    CLEAN_UNVERIFIED=""
    for arg in "$@"; do
        case "$arg" in
            --force) force=--force ;;
            --deep)  deep=--deep ;;
            "")      ;;
            *) err "unknown option: $arg (want --force and/or --deep)"; return 2 ;;
        esac
    done
    held="$(foreign_claim)"
    if [[ -n "$held" && "$force" != "--force" ]]; then
        holder="$(claim_field owner)"
        # What is left of the description once the owner's name is taken out of it, which is the
        # part that must never reach the command line below.
        detail="${held#"$holder"}"; detail="${detail# }"
        err "refusing to tear down: the lab is claimed by $held"
        err "their kernel's pid is in the shared .test_run/pids/, so this would kill it."
        # ROLE-4 T2, 01:56:53: the claim said `measuring=ROLE-4 reader nsr, do not tear down` and
        # this refusal never mentioned it. `ndt status` had a row for it; the message that stops
        # somebody from tearing the lab down did not, so the one sentence the holder wrote FOR
        # this moment was the one sentence not shown at it.
        declared="$(measuring_declared)"
        if [[ -n "$declared" ]]; then
            err "and they DECLARED what is running, which is what this would destroy:"
            err "    measuring=$declared"
        fi
        # NDT_OWNER first, deliberately. If the claim is your own -- and it usually is, because
        # NDT_OWNER has to be set on every command, not just `claim` -- then --force is the
        # wrong answer twice over: it does not record that you own the lab, and following it
        # when the claim really is someone else's tears down their work.
        # [Co-developed with claude code -- Adam]
        #
        # 🔴 ROLE-4 T2, 01:56:53 verbatim. This line used to be `NDT_OWNER=$held ndt down`, and
        # $held is a DESCRIPTION -- "overnight-0905 (until 02:36:24, ROLE-4 T2/T3: reader
        # running)". Pasted, bash reads `(until ...)` as a subshell and the command dies on a
        # syntax error. A line printed under "set the same owner and retry" has exactly one job.
        # So: the bare owner, %q-quoted (owner is free text and a name with a space in it breaks
        # this the same way one with a paren does), and the description on its own line where it
        # cannot get into the command.
        err "if that claim is YOURS, set the same owner and retry:"
        err "$(printf '    NDT_OWNER=%q ndt down' "$holder")"
        err "      that claim: $detail"
        err "if it is someone else's, wait for it to lapse. Only override it if you know they"
        err "have finished:  ndt down --force"
        # 🔴 rc 5: refused. Nothing on this machine was read, let alone changed -- the same
        # answer `ndt up` and `ndt clean` give for a guard. (Adam, 2026-09-12)
        return 5
    fi
    # [Co-developed with claude code -- Adam]
    # T2d, measured 2026-09-11 01:57:27-01:57:54 (logs/ROLE-4/10-t3-down-by-owner.log). The claim
    # said `measuring=ROLE-4 reader nsr, do not tear down`. The OWNER's own `ndt down` tore the
    # fabric out, printed `clean`, exited 0, killed the declared reader, and never mentioned the
    # field. `measuring=` protected nothing: cmd_down read foreign_claim and in_flight, and
    # in_flight knows four drivers (iperf3 client, matrix.sh, measure.sh, cpu_probe.py) -- so the
    # one channel a session has for "you cannot see what I am measuring" was read by `ndt check`
    # and by nothing else. The field was added FOR the case ps cannot answer (R4-2); a teardown
    # is the command whose mistake costs the most, and it was the command not reading it.
    #
    # 🔴 --force is the override and --deep is NOT one. --deep is what an operator reaches for
    # when a teardown did not reach clean, i.e. exactly when a declared measurement is most
    # likely to still be running; a guard that any second flag turns off is not a guard. Same
    # single override as the foreign claim above and as in_flight below, and the same meaning:
    # you are signing for it.
    declared="$(measuring_declared)"
    if [[ -n "$declared" && "$force" != "--force" ]]; then
        err "refusing to tear down: this claim DECLARES a measurement in progress."
        err "    measuring=$declared"
        err "it was declared in ${CLAIM#$REPO/}, not guessed from the process table, so nothing"
        err "here can see whether it is still running -- only you can. Tearing the fabric out"
        err "from under it loses the run (measured 09-11 01:57: it did, silently, rc 0)."
        err "when that run is over:  ndt claim <mins> to redeclare, or  ndt down --force"
        # 🔴 rc 5: refused.
        return 5
    fi
    [[ -n "$declared" ]] && warn "--force: tearing down over a declared measurement -- $declared"
    busy="$(in_flight)"
    if [[ -n "$busy" && "$force" != "--force" ]]; then
        err "refusing to tear down: a measurement is running."
        printf '%s\n' "$busy" | sed 's/^/        /' >&2
        err "tearing the fabric out from under it loses the whole run, and nothing else"
        err "on this machine would say so. wait for it, or:  ndt down --force"
        # 🔴 rc 5: refused.
        return 5
    fi
    [[ -n "$busy" ]] && warn "--force: tearing down with a measurement in flight"

    # H3. From here on this process is destroying the lab, and a concurrent `ndt up` has no
    # other way to know: every reading it could take -- held ports, a live fabric, a topo
    # session -- looks exactly like a stack that is up. Written AFTER the refusals above, so a
    # `down` that refused to run never claims to be running one, and removed at the single
    # exit below.
    #
    # 🔴 ROLE-12: it can now REFUSE, and that refusal is a refusal of this whole command. A
    # second teardown that carried on would overwrite the first one's marker and then delete
    # it, which is the H3 guard being taken away by the overlap it is for. See the block
    # comment on mark_teardown_start for the 02:07:18-02:07:32 timeline.
    # 🔴 rc 5: its only non-zero return is the refusal against somebody else's live teardown.
    mark_teardown_start || return 5

    say "ndt down"

    # [Co-developed with claude code -- Adam]
    # 🔴 THE APP KNOB IS CLEARED BY THIS COMMAND'S LAST STEP, NOT HERE, and the first draft had
    # it both places. tests/shell/mutate_ndt_app_package.sh's M4 deleted this call and the
    # whole suite stayed green -- `verify clean` is cmd_clean, cmd_clean clears the knob, and
    # there is no path between the teardown starting and that call that returns early. Two
    # guards over one fact, where removing either is invisible: the shape P1-A's M19 found in
    # startup() the same week. One of them had to go, and it is this one, because `ndt clean`
    # is also a verb an operator runs on its own -- putting the checkout back is exactly what
    # they are asking for there -- while `ndt down` reaches it either way.
    #
    # What that costs, said rather than left to be discovered: an `ndt down` killed between
    # here and `verify clean` (this laptop's systemd-oomd does that) leaves the knob in place.
    # So does everything else that teardown was doing, and the answer to both is the same --
    # run it again.

    # [Co-developed with claude code -- Adam]
    # 🔴 WHAT THIS TEARDOWN IS ABOUT, read before it changes anything. Every reading below is
    # taken after the sweep has run, so by then the answer is always "nothing" -- which is why
    # the question has to be asked here. It decides two things: what `verify clean` is an
    # assertion ABOUT (see cmd_clean's $1), and, further down, whether this command measured
    # anything at all. (Adam, 2026-09-12)
    DOWN_SUBJECT="$(lab_subject)"
    if [[ -n "$DOWN_SUBJECT" ]]; then
        info "this teardown is about:"
        printf '%s\n' "$DOWN_SUBJECT" | sed 's/^/        /'
    fi

    # Apps first: they poll the kernel API, and left running they spend the teardown logging
    # connection errors against a stack that is going away.
    #
    # [Co-developed with claude code -- Adam]
    # The gate is app_probe, not app_running. `down` used to skip any app whose pidfile had gone
    # missing -- which is precisely the app that most needs stopping, because nothing else on the
    # machine will ever stop it either. And the failure is silent twice over: app_stop's output is
    # discarded here, so a stop that could not finish said nothing at all.
    #
    # 🔴 C10-8, 2026-09-12. What this loop must NOT reach: another checkout's processes. The
    # 15:4x restore log has this teardown printing `!! sim is running untracked (pid 1166836)
    # -- stopping it by pid` about a fixture belonging to a test another worktree was running.
    # app_probe no longer hands those over (app_claims_pid), and they are named below instead.
    local a started=0
    app_elsewhere_reset; APP_ATTRIB_BLIND=""
    for a in $APP_NAMES; do
        app_probe "$a"
        [[ "$APP_STATE" == not-running ]] && continue
        (( started == 0 )) && say "[0/3] apps"
        started=1
        [[ "$APP_STATE" == pidfile-lost-but-alive ]] &&
            warn "$a is running untracked (pid ${APP_LIVE_PIDS[*]}) -- stopping it by pid"
        # rc 2 is "there was nothing to stop": reachable here despite the probe above, because
        # the app can exit between the two calls. It is not a failure and must not be reported
        # as one -- only rc 1 is. (G-6)
        app_stop "$a" >/dev/null 2>&1; local src=$?
        case "$src" in
            0) info "stopped $a" ;;
            2) info "$a had already exited" ;;
            *) err "could NOT stop $a -- rerun 'ndt apps stop $a' to see why" ;;
        esac
    done
    # C10-8: said even when nothing of ours was running, because "this teardown saw them and
    # left them alone" is the sentence the 15:4x round needed and did not have.
    if (( ${#APP_ELSEWHERE[@]} > 0 )) || [[ -n "$APP_ATTRIB_BLIND" ]]; then
        (( started == 0 )) && say "[0/3] apps"
        started=1
        apps_elsewhere_report
    fi

    # Order matters and is not the obvious one: `cleanup` does not stop the topo session, so
    # cleaning up first leaves a tmux session whose bridge then tries to tear down a fabric
    # that is already gone.
    say "[1/3] kernel + proxy/Ryu"
    # [Co-developed with claude code -- Adam]
    # 🔴 A1-b, Adam's ruling 2026-09-12 (FIX-NDT-4 section 7-1, "both"). This call dropped the
    # exit status while rollback_up's identical call a thousand lines up kept it -- so B-5's two
    # channels, the message and the rc, were both shut at the one command an operator runs to
    # finish a round. stack.sh cmd_down is non-zero for three things a teardown must not hide:
    # a port still held, a component this stack started that stop_one could not stop, and a
    # component that ended on a FATAL signal.
    #
    # 🔴 THE EXPECTED NEW RED. That third one is reported from a `.exit` record on disk, and
    # report_exit delivers it ONCE, so a round in which somebody SIGKILLed the kernel (or
    # systemd-oomd did) makes the NEXT `ndt down` exit 1 -- for an ending that really happened
    # and that nothing else on this machine would say. It clears itself on that one report. See
    # the rc table under `down` in `ndt help`, and run_cells.sh's restore, which records a
    # non-zero down and goes on to judge the machine by the sweep and the orphan verdict.
    #
    # Recorded, not returned: the remaining steps are exactly the ones a failed first step makes
    # more important, and down_rc is the single verdict this function ends on.
    local out src ports_deferred=""
    out="$(NO_COLOR=1 bash "$STACK" down 2>&1)"; src=$?
    stack_down_lines "$out"
    if (( src != 0 )); then
        # 🔴 ROLE-12, 2026-09-12. See stack_down_deferrable_ports: when the ONLY thing behind
        # that status is ports held by processes stack.sh did not start, the verdict on them is
        # taken after [3/3] has had its turn, because [1/3] runs before the sweep and on a live
        # P4 fabric it can only be naming the fabric this teardown is about to remove.
        ports_deferred="$(stack_down_deferrable_ports "$out")"
        if [[ -n "$ports_deferred" ]]; then
            warn "stack.sh down exited $src, and the only thing behind that status is port(s)"
            warn "  still listening at [1/3], held by processes it did not start:"
            warn "    $ports_deferred"
            warn "  [1/3] runs BEFORE the data-plane sweep in [3/3], so on a live P4 fabric this"
            warn "  is the fabric this teardown is about to remove, accusing itself. The verdict"
            warn "  on these ports is taken AFTER 'verify clean' below, not here. (ROLE-12)"
        else
            err "stack.sh down exited $src -- the kernel/proxy/Ryu half did not end cleanly;"
            err "  what it found is printed above. A component that died of a fatal signal is"
            err "  reported from its .exit record, so this can be an ENDING FROM AN EARLIER ROUND,"
            err "  reported once. The teardown continues; this is carried to the exit code."
            down_rc=1
        fi
    fi

    say "[2/3] topology session"
    sudo -n "$LAB" topo-stop 2>&1 | sed 's/^/      /'

    say "[3/3] sweep"
    # Safe to call from inside this script: see trap note 1 in the header. `mn -c` kills by
    # command line, and this script's argv mentions neither pattern.
    #
    # [Co-developed with claude code -- Adam]
    # FINDING #21, the cmd_down half. This was `sudo -n "$LAB" cleanup 2>&1 | sed ...`: pipefail
    # does carry the rc out of the pipeline, and nothing read it. G-9 made cleanup able to fail
    # and made it name what survived TERM and KILL, so a dropped rc here means the one line a
    # human has to see -- "STILL RUNNING <label> pid N" -- scrolls past inside a teardown that
    # then reports whatever cmd_clean happens to think.
    local sweep_out sweep_rc
    sweep_out="$(sudo -n "$LAB" cleanup 2>&1)"; sweep_rc=$?
    printf '%s\n' "$sweep_out" | sed 's/^/      /'
    # [Co-developed with claude code -- Adam]
    # 🔴 Adam, 2026-09-12 (form 1 Q3). A1-a stopped this command repeating stack.sh's advice to
    # run the Mininet sweep by hand, because inside a teardown that advice is wrong: THIS step
    # has already done it. What was left was a teardown that does the sweep and never says so,
    # while the manual still carries the hand-typed command -- so the operator cannot tell that
    # it is redundant here. Said unconditionally: "I ran it" and "it finished" are two
    # statements, and the second one has its own line and its own rc immediately below.
    ok "this step ran the Mininet sweep (mn -c) for you"
    info "  [3/3] is 'ndtwin-lab cleanup' and its sweep runs 'mn -c' before it sweeps"
    info "  simple_switch_grpc, so the advice stack.sh prints at [1/3] about running that"
    info "  command by hand is advice this teardown has already acted on -- which is why"
    info "  [1/3] filters it out."
    if (( sweep_rc != 0 )); then
        err "cleanup exited $sweep_rc -- the sweep did not finish; what survived is named above"
        down_rc=1
        not_verified "the [3/3] sweep"
    fi

    # Last, and only when asked: anything still holding the ports was not started by this
    # stack, so removing it is a decision rather than a cleanup step.
    if [[ -n "$deep" ]]; then
        say "[4/4] deep sweep (--deep)"
        deep_sweep
    fi

    # The lab is no longer being asked for anything, so the baseline `status --check` compares
    # against goes with it. Left in place it would make every later --check red about a fabric
    # nobody wants; removed, the honest answer after a `down` is "could not check". (#8)
    clear_up_target

    echo
    say "verify clean"
    # FINDING #49: wait for the sweep before judging it, with a bound, and then judge it. See
    # wait_reaped -- the wait is not allowed to decide anything, only to stop the assertion from
    # being taken while the process table is still catching up.
    wait_reaped "${NDT_REAP_WAIT:-20}" || true
    cmd_clean "$DOWN_SUBJECT"; local clean_rc=$?
    # Both halves count. A sweep that could not finish is a failed teardown even in the case
    # where cmd_clean cannot see what survived -- cleanup also sweeps patterns cmd_clean does
    # not check (the NTG topology, for one), so "clean" and "the sweep worked" are two answers.
    # 🔴 3 is not a failure: it is `cmd_clean` saying it measured nothing. Reachable here only
    # when this teardown had no subject either -- DOWN_SUBJECT is what it was given -- and that
    # case is answered at the single exit below, not by calling a clean machine dirty.
    (( clean_rc != 0 && clean_rc != 3 )) && { down_rc=1; not_verified "the residue check"; }
    # 🔴 ROLE-12: the SECOND reading of the ports [1/3] complained about, and the one the rc
    # follows. Taken by port number with the same probe cmd_clean's residue uses, rather than
    # inherited from clean_rc -- `cmd_clean` is red about a held port for its own reasons, so a
    # reader that leaned on its rc would look identical here while deciding nothing.
    if [[ -n "$ports_deferred" ]]; then
        local dp dproto dstill="" dblind="" dn=0
        for dp in $ports_deferred; do
            dn=$(( dn + 1 ))
            if ! dproto="$(ndt_port_proto "$dp")"; then
                dblind="${dblind:+$dblind }$dp"
                continue
            fi
            ndt_port_open "$dp" "$dproto" && dstill="${dstill:+$dstill }$dp"
        done
        if [[ -n "$dblind" ]]; then
            err "cannot re-read :$dblind after the sweep -- no row in ports.sh declares it, so"
            err "  whether [3/3] closed it is unknown, and unknown is not a pass."
            down_rc=1
            not_verified "port(s) no row in ports.sh could re-read: $dblind"
        fi
        if [[ -n "$dstill" ]]; then
            err "the port(s) [1/3] named are STILL held after [3/3]: $dstill"
            err "  that is this teardown failing, and not the order of its own steps."
            down_rc=1
            not_verified "port(s) still held after the sweep: $dstill"
        elif [[ -z "$dblind" ]]; then
            ok "the $dn port(s) [1/3] called 'still listening' were closed by [3/3]: $ports_deferred"
            info "  so stack.sh's exit $src was a reading from the MIDDLE of this teardown, not"
            info "  its ending, and it is not carried to the exit code. (ROLE-12, 2026-09-12)"
        fi
    fi
    # I-4's other half. `up` writes "in use" into the note; without this the sentence would
    # outlive the fabric it describes, which is the same defect with the sign flipped -- a
    # reader would wait for a machine that is already free. Written AFTER the assertion above,
    # so the note reports what was verified rather than what was attempted.
    # [Co-developed with claude code -- Adam]
    # 🔴 Adam, 2026-09-12 (form 1 Q1): rc 3 is "this command measured nothing". ROLE-12's own
    # table has the pair it separates -- "two live OVS teardowns and one already-down lab: rc
    # 0" -- three rounds, one byte, and only the log could tell the third from the other two.
    # Read from the subject taken at the TOP of this function, before anything was stopped.
    down_verdict="$down_rc"
    if (( down_rc == 0 )) && [[ -z "$DOWN_SUBJECT" ]]; then
        say "${Y}nothing was up to tear down${N}"
        info "  no fabric, no registry entry in .test_run/pids/, and no port in ports.sh's table"
        info "  was held when this command started, so it measured NOTHING -- rc 3, not 0."
        info "  Every step above still ran: they are idempotent, and a teardown that skipped"
        info "  them on a reading would be the reading deciding whether to act."
        info "  'the lab was already down' and 'this round ended clean' are two statements, and"
        info "  until 09-12 this command answered both with the same byte."
        down_verdict=3
    fi
    claim_note_down "$down_rc" "$CLEAN_UNVERIFIED" "$DOWN_SUBJECT"
    # H3. One exit path, so one removal. A `down` killed before it gets here leaves the marker
    # behind, which is why teardown_in_flight checks the pid rather than trusting the file.
    mark_teardown_end
    return "$down_verdict"
}

# The teardown assertion, separately callable. Exits non-zero if anything survived, because
# a leftover is not cosmetic: it makes the next run measure the wrong process.
#
# 🔴 IT DELETES NO LOGS, and that is a decision, not an omission (09-05 night round, O-4). This
# function counts processes, sessions, the manifest and the ports; `--deep` adds a port sweep.
# Nothing here or there has ever touched .test_run/logs/, and nothing here or there is going to:
# the generations under it are the only record of what the last run did, and a teardown command
# that quietly reaped them would be O-4 with a different trigger -- the evidence destroyed by the
# very command you run when you are finished with a run and about to write it up. Bounding those
# generations is stack.sh rotate_log's job, at the moment a new one replaces an old one.
cmd_clean() {
    local rc=0 n p
    # [Co-developed with claude code -- Adam]
    # 🔴 $1 is THE SUBJECT, supplied by a caller that has already established one -- `cmd_down`
    # measured a non-empty lab_subject before it acted, so an empty machine here is that
    # teardown's RESULT and the verdict is `clean`. Called on its own, with no subject and
    # nothing to find, this command reports rc 3: it measured nothing. Without the seam every
    # successful `ndt down` would end on "nothing to judge", which is the same conflation with
    # the sign flipped -- "I removed it and proved it gone" downgraded to "there was never
    # anything here". (Adam, 2026-09-12; section 21 drives both halves over ONE machine state.)
    local subject_known="${1:-}"

    # [Co-developed with claude code -- Adam]
    # 🔴 ROLE-12 cell 3, measured 2026-09-12 02:08:24.569: with the marker present and a `down`
    # tearing ten P4 switches out, `ndt clean` was not refused. It exited 1, said `not clean`,
    # and listed the operator's OWN fabric -- the one being destroyed -- as residue: 10 bmv2, 14
    # host/switch processes, the topo session, the manifest, `ndtwin_kernel pid 2460143 holding
    # :8000`, `python pid 2459746 holding :8081`, :6343 and the twenty bmv2 ports; last line,
    # `this stack did not start it; to kill it too:  ndt down --deep`.
    #
    # That is the advice H3's own refusal quotes as the thing that would have killed the
    # operator's processes, reached through a different door: H3's guard lives in `preflight`,
    # and `preflight` is walked by `ndt up` and by nothing else. This command is an ASSERTION
    # about a machine that is holding still; during a teardown it is holding still for nobody.
    #
    # 🔴 Only somebody ELSE's teardown. `cmd_down` calls this function as its own `verify clean`,
    # under the marker it wrote itself -- a guard that read the file rather than its owner would
    # turn the last step of every round into a refusal. Same ownership test as
    # mark_teardown_end, and the same opening two lines as the bring-up refusal.
    local tif
    if tif="$(teardown_in_flight)" && [[ "${tif%% *}" != "$$" ]]; then
        teardown_in_flight_refusal "judge this lab" "$tif"
        err "  every process that teardown is in the middle of killing would be listed here as"
        err "  residue, under advice to run 'ndt down --deep' -- which would kill the operator's"
        err "  own teardown. Measured 09-12 02:08:24: it listed 10 bmv2, 14 host/switch"
        err "  processes, the topo session, the manifest and 23 ports, all of them that"
        err "  teardown's. Nothing here is wrong about what it measured; it is measuring a"
        err "  machine that is being changed under it. (ROLE-12 cell 3)"
        err "  wait for it to finish, then run 'ndt clean'."
        # 🔴 rc 5: refused. It outranks rc 3 -- a command that refused did not measure this
        # machine at all, so it has nothing to report about what is on it. (Adam, 2026-09-12)
        return 5
    fi

    # [Co-developed with claude code -- Adam]
    # `ndt clean` is `ndt down`'s last step and also a verb of its own, and both readings want
    # this: as `down`'s step it is a no-op (the knob went at the top of that command), and on
    # its own it is the command an operator runs to put the checkout back. Below the refusal
    # above, for the same reason it sits below `down`'s: a refused clean measured nothing and
    # must change nothing.
    app_knob_clear "this checkout is being put back" || rc=1

    n="$(bmv2_count)"
    if [[ "$n" -eq 0 ]]; then ok "bmv2 switches: 0"; else err "bmv2 switches: $n still running"; rc=1; fi

    n="$(mn_count)"
    if [[ "$n" -eq 0 ]]; then ok "host/switch processes: 0"; else err "host/switch processes: $n still running"; rc=1; fi

    if topo_session; then err "topo tmux session still present"; rc=1; else ok "no topo session"; fi

    if [[ -e "$MANIFEST" ]]; then err "switch manifest still present: $MANIFEST"; rc=1; else ok "no switch manifest"; fi

    # [Co-developed with claude code -- Adam]
    # Every row of the port table, not the three ports that were easy to name. This loop used
    # to be `for p in 8000 8080 8081`, which is why a kernel nobody had started could hold UDP
    # :6343, block a legitimate bring-up with `bind() to sFlow port 6343 failed`, and have all
    # five of these assertions come back green. Adding a port here is now a one-line edit to
    # ports.sh, and the row carries the consequence with it -- so the report names the holder
    # and what it costs, the way this check already did for :8081 and did not for :30051.
    local residue
    residue="$(ndt_port_residue all)"; local prc=$?
    if [[ -n "$residue" ]]; then
        printf '%s\n' "$residue" | while IFS= read -r line; do err "$line"; done
        # [Co-developed with claude code -- Adam]
        # 🔴 ROLE-11 F5, measured 2026-09-12 02:25:14 (logs/ROLE-11/18-clean-live.log). The line
        # below used to be printed unconditionally, as one summary under the whole list. Thirty
        # seconds after the reader had brought that fabric up himself with `ndt up p4 4` -- and
        # following the manual, which sends him here to verify it -- `ndt clean` told him
        # `this stack did not start it; to kill it too:  ndt down --deep` about a list whose
        # first two entries were `ndtwin_kernel pid 2511227 holding :8000` and `python pid
        # 2510886 holding :8081`, both of which the same round's `ndt status` reported as ALIVE
        # out of .test_run/pids/. The manual's own fold-out says to use --deep only when the
        # machine is certainly yours; this said it was not. It was the only instruction in that
        # round that would have broken something if followed.
        #
        # Two records answer "did this stack start it", and the second is not optional: bmv2 is
        # root-owned, so this user cannot see its pids at all (ports.sh says so, and it is why
        # the P4 plane could not see H3 either). The pidfile registry answers for the kernel,
        # the proxy and Ryu; the switch manifest -- which this function has already reported as
        # present, two assertions up -- answers for the fabric's ports.
        #
        # 🔴 The stranger half is UNCHANGED and must stay: a :8000 nobody here started is how a
        # P4 session came to measure an OVS kernel and report 288 edges. "Never say it" would be
        # this defect with the sign flipped.
        local cspec cproto cplane crest cport cline
        local -a mine=() strangers=()
        while IFS='|' read -r cspec cproto cplane crest; do
            [[ -z "$cspec" ]] && continue
            for cport in $(ndt_port_expand "$cspec"); do
                ndt_port_open "$cport" "$cproto" || continue
                if [[ "$(port_owner_local "$cport" "$cproto")" == ours ]]; then
                    mine+=(":$cport ($(ndt_port_holder "$cport" "$cproto")) -- its pid is in .test_run/pids/")
                elif [[ "$cplane" == p4 && -e "$MANIFEST" ]]; then
                    mine+=(":$cport -- root-owned, so its pid is invisible here, and the switch manifest this stack wrote is still present")
                else
                    strangers+=("$cport")
                fi
            done
        done < <(ndt_port_rows all)
        if (( ${#mine[@]} > 0 )); then
            err "   the fabric this stack started is still up. Take it down with:  ndt down"
            for cline in "${mine[@]}"; do err "     $cline"; done
        fi
        if (( ${#strangers[@]} > 0 )); then
            err "   held by nothing this stack registered: $(printf ':%s ' "${strangers[@]}")"
            err "   this stack did not start it; to kill it too:  ndt down --deep"
        fi
        rc=1
    fi
    # 2 is "could not look", not "nothing there". Treated as not-clean for the same reason
    # grpc_ports.py refuses on an unreadable ip_local_port_range: unknown is not safe.
    (( prc == 2 )) && rc=1
    (( prc == 0 )) && ok "ports closed: $(ndt_port_label all)"

    echo
    if (( rc != 0 )); then say "${R}not clean${N}"; return $rc; fi
    # 🔴 rc 0 needs a SUBJECT. Nothing dirty was found; whether that is "clean" or "there was
    # nothing here" is decided by whether anything was here to be judged -- the five assertions
    # above answer for the fabric, and the registry answers for this checkout.
    if [[ -z "$subject_known" && -z "$(pid_registry_entries)" ]]; then
        say "${Y}nothing to judge${N}"
        info "  no fabric, nothing in .test_run/pids/, and no port in ports.sh's table is held,"
        info "  so this command measured NOTHING -- rc 3. That is not the same statement as"
        info "  'clean', which is what it printed here until 09-12 on a machine with no lab on"
        info "  it at all. A teardown that removed a fabric and proved it gone still says clean."
        return 3
    fi
    say "${G}clean${N}"
    return 0
}

